// dxx-matchmaking server configuration
// Copy to server_config.jsonc and edit as needed.
// All fields are optional -- defaults are shown below.
// Environment variables override values in this file.
{
    // Loopback dev installation proof audience; ignored for production authentication
    // Example shape only: "https://your-owned-hostname:443"
    // installation_auth_audience: "",
    // Exact trusted proxy peers; empty for direct/native TLS deployments
    // trusted_proxy_ips: [],
    // Network listeners
    // ws_listen_addr: "0.0.0.0:9000",
    // http_listen_addr: "0.0.0.0:8080",
    // relay_listen_addr: "0.0.0.0:9001",
    // Maximum concurrent WebSocket connections (0 = unlimited)
    // max_connections: 500,
    // Database
    // db_path: "dxx_matchmaking.db",
    // Google ID-token audience for ordinary Sign in with Google (no client secret needed)
    // google_client_id: "",
    // Public HTTPS origin for the Google ID-token login endpoints on the WS listener
    // Empty disables the new endpoints during the coordinated client/server transition
    // Set GOOGLE_AUTH_ORIGIN or this field to https://your-owned-hostname:443
    // google_auth_origin: "",
    // Admin bearer token for /api/v1/admin/* endpoints
    // admin_token: "",
    // Optional separate listen address for admin-only HTTP endpoints.
    // When set, admin routes (ban, unban, motd) move to this port and
    // the main http_listen_addr serves only public routes.
    // Empty = admin routes stay on the main port; e.g. "127.0.0.1:8081" to separate them
    // admin_http_listen_addr: "",
    // Message of the day (shown to clients on connect)
    // motd: "",
    // URL shown when rejecting old clients
    // update_url: "",
    // TLS (leave empty for plain WebSocket; use reverse proxy for production)
    // tls_cert_path: "",
    // tls_key_path: "",
    // UDP relay public address sent to clients (domain name or IP, e.g. "match.example.com:9001")
    // relay_public_addr: "",
    // Maximum concurrent relay sessions (0 = unlimited, default 100)
    // max_relay_sessions: 100,
    // Egress policy defaults are documented in RELAY_SECURITY.md
    // Identity quotas observe initially; the durable monthly cap always enforces
    // RELAY_POLICY_JSON overrides this entire object, with defaults for omitted fields
    // relay_policy: {},
    // STUN server listeners (for self-hosted NAT discovery)
    // Protocol 8 requires lobby admission credentials; this is not a public STUN/TURN service
    // stun_listen_addr: "0.0.0.0:3478",
    // stun_listen_addr_alt: "0.0.0.0:3479",
    // stun_public_addrs: "",   // e.g. "match.example.com:3478,match.example.com:3479"
    // Logging
    // log_dir: "",             // empty = stdout only; set path for daily JSON log rotation
    // Dev/test mode
    // Force game connections through the UDP relay, ignoring connectivity checks
    // force_relay: false,
    // skip_gpgs_verify: false, // legacy setting name: true enables loopback dev auth only
    // Proof-of-work difficulty for loopback dev installation/keypair registration
    // pow_difficulty: 20,
}
