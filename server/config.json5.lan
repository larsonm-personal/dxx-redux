// dxx-matchmaking server -- LAN testing configuration
// For use with self-signed certs (see generate_lan_cert.sh).
// Copy to server_config.json5 and edit paths below.
{
    // Listen on all interfaces so LAN clients can reach the server
    ws_listen_addr: "0.0.0.0:9000",
    http_listen_addr: "0.0.0.0:8080",
    relay_listen_addr: "0.0.0.0:9001",

    // STUN disabled for LAN testing (not needed on local network)
    // stun_listen_addr: "0.0.0.0:3478",
    // stun_listen_addr_alt: "0.0.0.0:3479",
    // stun_public_addrs: "",

    // Database
    db_path: "dxx_matchmaking.db",

    // TLS -- point to certs from generate_lan_cert.sh
    tls_cert_path: "lan_certs/cert.pem",
    tls_key_path: "lan_certs/key.pem",

    // Logging to stdout only for LAN testing
    // log_dir: "",

    // Dev mode: accept any token as identity (no Google auth needed for LAN)
    skip_gpgs_verify: true,

    // Low proof-of-work difficulty for fast LAN testing
    pow_difficulty: 8,
}
