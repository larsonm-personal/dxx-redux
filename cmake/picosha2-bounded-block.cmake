# Preserve the pinned SHA implementation while avoiding checked-iterator locks for each byte of a
# block already bounded by hash256_one_by_one::process
function(dxx_picosha2_bounded_block source destination)
    file(SHA256 "${source}" source_hash)
    if(NOT source_hash STREQUAL "b13c180161ffac8d0adc81e033e493c409457c4d1258ab9781ac80579ba3bdd8")
        message(FATAL_ERROR "PicoSHA2 bounded block requires the pinned unmodified header")
    endif()
    file(READ "${source}" header)
    # Insert the checked input range in bulk instead of growing the private byte buffer one
    # push_back at a time
    string(REPLACE "std::copy(first, last, std::back_inserter(buffer_));"
                   "buffer_.insert(buffer_.end(), first, last);" header "${header}")
    string(REPLACE "detail::hash256_block(h_, buffer_.begin() + i,"
                   "detail::hash256_block(h_, buffer_.data() + i," header "${header}")
    string(REPLACE "buffer_.begin() + i + 64);" "buffer_.data() + i + 64);" header "${header}")
    # Retain timestamps when the generated bytes match
    if(EXISTS "${destination}")
        file(READ "${destination}" previous)
        if(previous STREQUAL header)
            return()
        endif()
    endif()
    file(WRITE "${destination}" "${header}")
endfunction()
