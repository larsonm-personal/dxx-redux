// TEST: Resolution verification (unified launcher + game)
//
// Phase 1: Fresh launch (no descent.cfg) -- verify default half-screen
//           resolution is NOT 640x480.
// Phase 2: Write descent.cfg with 640x480 -- verify game applies it.
//
// Run via: android/run_test.ps1 test_resolution_unified.json5
[
    {"_info": {
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // ── Phase 1: Default half-screen resolution ─────────────────

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 1: Default half-screen resolution ==="},

    {"action": "reset_state"},

    {"action": "enter_game", "game": "d2"},

    {"action": "wait_ms", "ms": 2000},

    // Accept default pilot name
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 2000},

    // Main menu -- game has initialized and set its render resolution
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},

    // Default resolution should NOT be 640x480 -- it should be half-screen.
    // Note: render_width CAN be 640 legitimately (1280/2 = 640 on many
    // emulators), so only check height differs from the 480 default.
    {"action": "assert", "expect": {
        "resolution.render_width": {"gt": 0},
        "resolution.render_height": {"ne": 480},
        "resolution.display_width": {"gt": 0},
        "resolution.display_height": {"gt": 0}
    }},
    {"action": "introspect"},
    {"action": "log", "message": "Phase 1 PASS: Default resolution is not 640x480"},

    // ── Phase 2: Explicit 640x480 via descent.cfg ───────────────

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 2: Explicit 640x480 resolution ==="},

    // Reset pilot but write descent.cfg with 640x480
    {"action": "reset_state"},
    {"action": "write_config", "file": "descent.cfg",
     "content": "AspectX=3\nAspectY=4\nResolutionX=640\nResolutionY=480\n"},

    {"action": "enter_game", "game": "d2"},

    {"action": "wait_ms", "ms": 2000},

    // Accept default pilot name
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 2000},

    // Main menu -- verify resolution is 640x480
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},

    {"action": "assert", "expect": {
        "resolution.render_width": "640",
        "resolution.render_height": "480"
    }},
    {"action": "introspect"},
    {"action": "log", "message": "Phase 2 PASS: Resolution correctly set to 640x480"},

    {"action": "log", "message": "=== Resolution test -- ALL PHASES PASS ==="}
]
