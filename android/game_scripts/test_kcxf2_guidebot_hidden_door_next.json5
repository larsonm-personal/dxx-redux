        "console.lines": {"contains": "GUIDE-BOT: Finding NEXT: open this hidden door"}
    }},

    {"action": "wait_ms", "ms": 7000},
    {"action": "assert", "expect": {
        "guidebot.route_goal_objective_wall": "61",
        "guidebot.route_goal_path_pending": "true"
