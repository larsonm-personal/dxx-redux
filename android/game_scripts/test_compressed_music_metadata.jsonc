// TEST: Tagged compressed mission music is exposed by launcher metadata analysis
[
    {"_info": {
        "description": "Import Castaway and verify stable OGG embedded metadata without screenshot analysis",
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
