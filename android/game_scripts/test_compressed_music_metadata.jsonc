// TEST: Tagged compressed mission music is exposed by launcher analysis and in-game labels
[
    {"_info": {
        "description": "Import Castaway and verify stable OGG embedded metadata without screenshot analysis",
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "castaway_redux.zip", "sha256": "8b00822dc291b76fdfd32f5543ea5657bd6bc4499e84c4fb37744518ce40e355", "target": "files/mission_zip_batch_cache"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "switch_set", "args": {"name": "default"}},
    {"action": "clear_mods"},
    {"action": "setup_command", "command": "pause_route_metadata_precompute"},
    {"action": "import_mission_zip", "file": "castaway_redux.zip", "label": "compressed_music_import", "display_name": "castaway_redux.zip"},
    {"action": "analyze_level_metadata_all", "label": "compressed_music_metadata", "mod_file": "castaway_redux.zip", "game": "d2", "status": "ok", "min_total_levels": 10, "min_music_tracks": 14, "expect_music_format": "ogg", "expect_music_title": "Choppy Seas", "expect_music_display_name": "Choppy Seas"},
    {"action": "setup_command", "command": "pause_route_metadata_precompute"},
    {"action": "setup_command", "command": "write_music_prefs", "args": {"source": "midi", "prefer_mission_soundtrack": true, "play_order": 0, "volume": 8}},
    {"action": "enter_game", "game": "d2"},
    {"action": "skip_intro", "timeout_ms": 20000},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "timeout_ms": 5000},
    {"action": "select_mission", "text": "PTMC: Castaway", "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "timeout_ms": 5000},
    {"action": "select", "text": "Rookie", "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 20000},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {
        "music.name": {"contains": "Crescent"},
        "music.tracks[0].name": {"contains": "Crescent"},
        "music.tracks[1].name": {"contains": "Emperor Unknown"},
        "music.tracks[8].name": {"contains": "Eon Forged"}
    }},
    {"action": "music_control", "operation": "play", "track": 6},
    {"action": "wait_ms", "ms": 250},
    {"action": "assert", "expect": {"music.name": {"contains": "Emperor Unknown"}}},
    {"action": "enter_launcher"},
    {"action": "delete_mod", "mod_file": "castaway_redux.zip"},
    {"action": "log", "message": "Tagged compressed mission music metadata passed"}
]
