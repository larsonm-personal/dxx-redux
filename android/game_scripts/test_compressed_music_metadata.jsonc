    {"action": "analyze_level_metadata_all", "label": "compressed_music_metadata", "mod_file": "castaway_redux.zip", "game": "d2", "status": "ok", "min_total_levels": 10, "min_music_tracks": 14, "expect_music_format": "ogg", "expect_music_title": "Choppy Seas", "expect_music_display_name": "Choppy Seas"},
    {"action": "delete_mod", "mod_file": "castaway_redux.zip"},
    {"action": "log", "message": "Tagged compressed mission music metadata passed"}
