[
    {"_info": {"games": ["d2"], "_standalone": false, "_owner": "test_d1_in_d2_standalone",
        "description": "Cold optional Guide-Bot deployment, save/restore, natural memory rewind and D1/D2/D1 resource retirement"}},
    {"action": "assert", "expect": {"asset_trace.mode": "d1-in-d2", "guidebot.companion_count": 0}},
    {"action": "set_debug", "field": "clear_robots", "value": "true"},
    {"action": "meta_action", "id": 1037},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {"guidebot.companion_count": 1, "guidebot.released": true, "guidebot.object_type": 2}},
    {"action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 500},
    {"action": "meta_action", "id": 1042},
    {"action": "meta_action", "id": 1045},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"guidebot.docked": true, "guidebot.released": false, "guidebot.companion_count": 1}},
    {"action": "set_debug", "field": "android_game_request", "value": "quick_load"},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"guidebot.docked": false, "guidebot.released": true, "guidebot.companion_count": 1, "game_window_is_front": true, "time_paused": false}},
    {"action": "introspect"},
    {"action": "meta_action", "id": 1042},
    {"action": "meta_action", "id": 1045},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"guidebot.docked": true, "guidebot.released": false, "guidebot.companion_count": 1}},
    // Natural snapshots every five seconds cover the runner's ten-second target
    {"action": "wait_ms", "ms": 15000},
    {"action": "meta_action", "id": 1037},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {"guidebot.docked": false, "guidebot.released": true, "guidebot.companion_count": 1}},
    {"action": "meta_action", "id": 1035},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"guidebot.docked": true, "guidebot.released": false, "guidebot.companion_count": 1, "game_window_is_front": true, "time_paused": false}},
    {"action": "introspect"},
    {"action": "key", "key": "escape"},
    {"action": "select", "text": "Abort Game", "timeout_ms": 5000},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {"in_game": false, "current_level_num": 0}},
    {"action": "select", "text": "New game", "timeout_ms": 10000},
    {"action": "select_mission", "text": "Counterstrike", "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "timeout_ms": 5000},
    {"action": "select", "text": "Trainee", "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 60000},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"game_window_is_front": true, "asset_trace.mode": "d2", "guidebot.released": false}},
    {"action": "introspect"},
    {"action": "key", "key": "escape"},
    {"action": "select", "text": "Abort Game", "timeout_ms": 5000},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {"in_game": false, "current_level_num": 0}},
    {"action": "select", "text": "New game", "timeout_ms": 10000},
    {"action": "select_mission", "text": "first strike", "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "timeout_ms": 5000},
    {"action": "select", "text": "Trainee", "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 60000},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {"game_window_is_front": true, "asset_trace.mode": "d1-in-d2", "guidebot.companion_count": 0, "asset_trace.d1_compat.robot_models": 82}},
    {"action": "meta_action", "id": 1037},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {"guidebot.companion_count": 1, "guidebot.released": true, "guidebot.object_type": 2}},
