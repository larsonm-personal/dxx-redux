// Extraction regression: verify game loads to expected level.
// Used by run_extract_test.ps1 when running with the automation engine
// instead of raw keyevent presses.
//
// Template parameters (substituted by the test runner):
//   MISSION_NAME  - expected mission name for "select" action
//   LEVEL_NAME    - expected level name for assertion
//   MISSION_OPTIONAL - false when the fixture must expose mission selection
//
// This script assumes the game has been launched from SetupActivity
// and will reach the pilot select screen first.
[
    {"_info": {"_standalone": false, "_owner": "test_all_extracts"}},
    {"action": "log", "message": "=== Extraction regression test ==="},

    // Demo and title-screen variants can still be in the launch intro here.
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},

    // Handle either the direct pilot-name prompt or the create/select pilot list.
    {"action": "wait_ms", "ms": 1000},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "key", "key": "enter", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "when": "d2", "optional": true, "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Create New", "when": "d2", "optional": true, "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "optional": true, "post_delay_ms": 100, "timeout_ms": 5000},

    // Main menu - start new game
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    // Mission select
    {"action": "select", "text": "MISSION_NAME", "optional": MISSION_OPTIONAL, "post_delay_ms": 100, "timeout_ms": 5000},
    // Accept default level 1
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    // Difficulty
    {"action": "select", "text": "Trainee", "optional": true, "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "Rookie", "optional": true, "post_delay_ms": 100, "timeout_ms": 10000},

    // Skip briefing/movie
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},

    // Wait for game to load
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000},

    // Verify level loaded correctly
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "current_level_num": "1",
        "current_level_name": "LEVEL_NAME"
    }},

    {"action": "log", "message": "=== Extraction regression test -- PASS ==="},
    {"action": "introspect"}
]
