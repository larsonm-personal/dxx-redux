// Owned DSND banks and actual CFile HOG fallback: PCM, signed scopes and persistence
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_audio_scopes",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "setup_command",
        "command": "switch_set",
        "args": {
            "name": "default",
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "write_config",
        "file": "imported/sets/default/.content/mods/mod_manifest.json",
        "content": "{\"mods\":[{\"filename\":\"xl-audio-scopes.zip\",\"displayName\":\"Derived XL sound scopes\",\"enabled\":true,\"game\":\"d2\",\"kind\":\"mission_zip\",\"category\":\"levels\",\"order\":0}]}",
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL mission banks",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
            "xl_named_audio.backend_ready": true,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "xl_named_audio_probe",
        "value": "bank_prepare",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "drain",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "checkpoints.pending": 0,
            "checkpoints.failed": 0,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "xl_named_audio_probe",
        "value": "bank_disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip_paused",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_named_audio_probe",
        "value": "bank_verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_named_audio_probe",
        "value": "bank_output",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "resume",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": false,
        },
        "timeout_ms": 20000,
