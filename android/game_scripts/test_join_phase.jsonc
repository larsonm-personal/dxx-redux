// Shared in-session join fixture; test_lan selects one phase at a time.
[
    {
        "_info": {
            "games": [
                "d1",
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan",
            "params": {
                "cancel": {
                    "label": "cancel"
                },
                "skip": {
                    "label": "skip"
                },
                "transfer_hold": {
                    "label": "transfer_hold"
                },
                "escape": {
                    "label": "escape"
                },
                "flyout": {
                    "label": "flyout"
                },
                "scores": {
                    "label": "scores"
                },
                "enter_scores": {
                    "label": "enter_scores"
                },
                "next_level": {
                    "label": "next_level"
                },
                "launch_next": {
                    "label": "launch_next"
                }
            }
        }
    },
    {
        "when": "${cancel}",
        "action": "set_debug",
        "field": "join_wait_test",
        "value": "cancel"
    },
    {
        "when": "${skip}",
        "action": "set_debug",
        "field": "coop_briefing_action",
        "value": "skip"
    },
    {
        "when": "${transfer_hold}",
        "action": "set_debug",
        "field": "join_wait_test",
        "value": "hold_transfer"
    },
    {
        "when": "${escape}",
        "action": "set_debug",
        "field": "coop_countdown_save_test",
        "value": "seed"
    },
    {
        "when": "${flyout}",
        "action": "trigger_endlevel"
    },
    {
        "when": "${flyout}",
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "endlevel_sequence": {
                "gt": 0
            },
            "screen_advance_can_activate": true
        }
    },
    {
        "when": "${scores}",
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "screen_advance_can_activate": true
        }
    },
    {
        "when": "${scores}",
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "when": "${scores}",
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "postlevel_active": true
        }
    },
    {
        "when": "${enter_scores}",
        "action": "trigger_endlevel"
    },
    {
        "when": "${enter_scores}",
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "endlevel_sequence": {
                "gt": 0
            },
            "screen_advance_can_activate": true
        }
    },
    {
        "when": "${enter_scores}",
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "screen_advance_can_activate": true
        }
    },
    {
        "when": "${enter_scores}",
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "when": "${enter_scores}",
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "postlevel_active": true
        }
    },
    {
        "when": "${next_level}",
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "screen_advance_can_activate": true
        }
    },
    {
        "when": "${next_level}",
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "when": "${next_level}",
        "action": "wait_for",
        "timeout_ms": 45000,
        "expect": {
            "current_level_num": 2
        }
    },
    {
        "when": "${launch_next}",
        "action": "set_debug",
        "field": "coop_briefing_action",
        "value": "skip"
    },
    {
        "when": "${launch_next}",
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "in_game": true,
            "coop_briefing.active": false
        }
    }
]
