[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_spawn_points_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
        "post_delay_ms": 500,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
