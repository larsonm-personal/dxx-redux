[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_addon_import",
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "setup_command",
        "command": "set_mod_enabled",
        "args": {
            "filename": "pmines_v11.7z",
            "enabled": true,
        },
    },
    {
        "action": "wait_ms",
        "ms": 2000,
    },
    {
        "action": "wait_for",
        "field": "resume_offer_enabled",
        "value": "true",
        "timeout_ms": 15000,
    },
    {
        "action": "assert",
        "expect": {
            "resume_candidate.game": "d2",
            "resume_candidate.level_num": 1,
            "resume_candidate.level_name": "Temporal Hub",
            "resume_candidate.save_kind": "auto_exit",
        },
    },
    {
        "action": "tap_button",
        "text": "Load Last Save",
        "launches_game": true,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "current_level_name": "Temporal Hub",
            "mission_asset_owner": "mod/pmines_v11.7z",
            "player.energy": {
                "range": [80, 99.99],
            },
        },
        "timeout_ms": 120000,
    },
    {
        "action": "assert",
        "expect": {
            "cheats_enabled": false,
            "player_dead": false,
        },
    },
    {
        "action": "introspect",
    },
]
