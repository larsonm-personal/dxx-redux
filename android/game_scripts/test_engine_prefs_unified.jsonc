// TEST: Engine prefs launcher persistence (unified launcher + game)
//
// Phase 1: create a pilot from a clean state
// Phase 2: verify the app-level intro auto-skip launcher pref
// Phase 3: write cockpit mode, auto-level, and original homing through the launcher path
// Phase 4: relaunch and verify the running game reports those values
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"GAME": "d1", "GAME_NUM": "1", "MISSION": "First Strike"},
            "d2": {"GAME": "d2", "GAME_NUM": "2", "MISSION": "Counterstrike"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // -- Phase 1: Create pilot from a clean state --
    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 1: Create pilot (${GAME}) ==="},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "log", "message": "Pilot created, returning to launcher"},
    {"action": "enter_launcher"},

    // -- Phase 2: Verify app-level intro auto-skip launcher pref --
    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 2: Verify intro auto-skip pref (${GAME}) ==="},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": true}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "assert", "expect": {
        "intro_active": "false",
        "intro_skip_applied": "true",
        "screen_mode": "menu"
    }},
    {"action": "enter_launcher"},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},

    // -- Phase 3: Write pilot-backed engine prefs through launcher path --
    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 3: Write engine prefs (${GAME}) ==="},
    {"action": "setup_command", "command": "write_engine_prefs",
     "args": {"cockpit_mode": 2, "auto_leveling": false, "headlight_active_default": false,
              "original_homing": true}, "post_delay_ms": 1000},
    {"action": "tap_button", "text": "Game Preferences", "post_delay_ms": 500},
    {"action": "tap_button", "text": "< Back", "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},

    // -- Phase 4: Verify running game sees saved prefs --
    {"action": "log", "message": "=== Phase 4: Verify engine prefs in game (${GAME}) ==="},
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "key", "key": "enter", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "assert", "expect": {
        "cockpit_mode": "2",
        "auto_leveling": "false",
        "headlight_active_default": "false",
        "original_homing": "true"
    }},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "cockpit_mode": "2",
        "current_cockpit_mode": "2",
        "auto_leveling": "false",
        "headlight_active_default": "false",
        "original_homing": "true"
    }},
    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: Engine prefs launcher persistence -- COMPLETE ==="}
]
