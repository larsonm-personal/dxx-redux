// Canonical 25/27 normal transitions, owned geometry/resources, rejection, disk and memory restore
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_runtime_layouts",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL layouts",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
            "xl_pilot.source_level_version": 23,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "next",
        "post_delay_ms": 0,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.source_level_version": 25,
            "xl_pilot.source_game_version": 40,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 0,
    },
    {
        "action": "face_view",
        "segment": 10,
        "side": 2,
        "distance": 8,
        "post_delay_ms": 500,
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.shaded_vertices": {
                "gte": 1,
            },
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "prepare",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "drain",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "checkpoints.pending": 0,
            "checkpoints.failed": 0,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip_paused",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "disk_save",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "disk_load",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_runtime_layout_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "resume",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
