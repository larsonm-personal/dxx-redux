// TEST: Shot-based boss health row lifecycle and four-row message budget
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike", "LEVEL": "27", "LEVEL_KEY_1": "2", "LEVEL_KEY_2": "7", "GAME": "d1", "BOSS_MAX": "327680000"},
            "d2": {"MISSION": "Counterstrike", "LEVEL": "24", "LEVEL_KEY_1": "2", "LEVEL_KEY_2": "4", "GAME": "d2", "BOSS_MAX": "225280000"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "wait_ms", "ms": 300},
    {"action": "key", "key": "backspace", "post_delay_ms": 100},
    {"action": "key", "key": "${LEVEL_KEY_1}", "post_delay_ms": 100},
    {"action": "key", "key": "${LEVEL_KEY_2}", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.enabled": "true",
        "hud_layout.boss_health.active": "false",
        "hud_layout.boss_health.drawn": "false",
        "hud_layout.queued_message_capacity": "4"
    }},
    {"action": "set_debug", "field": "damage_boss", "value": "half", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.active": "false",
        "hud_layout.boss_health.drawn": "false"
    }},
    {"action": "set_debug", "field": "boss_shot", "value": "player_by_boss", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.active": "true",
        "hud_layout.boss_health.drawn": "true"
    }},
    {"action": "set_debug", "field": "boss_shot", "value": "reset", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.active": "false",
        "hud_layout.boss_health.drawn": "false"
    }},
    {"action": "set_debug", "field": "boss_shot", "value": "by_player", "post_delay_ms": 100},
    {"action": "set_debug", "field": "hud_test_message_burst", "value": "4", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.active": "true",
        "hud_layout.boss_health.drawn": "true",
        "hud_layout.boss_health.visible_slot": "0",
        "hud_layout.boss_health.maximum_shields_raw": "${BOSS_MAX}",
        "hud_layout.boss_health.green_width": {"gt": 0},
        "hud_layout.boss_health.red_width": {"gt": 0},
        "hud_layout.queued_message_capacity": "3",
        "hud_layout.queued_message_draw_count": "3",
        "hud_layout.message_rect_count": "4"
    }},
    {"action": "set_debug", "field": "show_boss_health_bar", "value": "false", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.enabled": "false",
        "hud_layout.boss_health.active": "true",
        "hud_layout.boss_health.drawn": "false",
        "hud_layout.queued_message_capacity": "4",
        "hud_layout.boss_health.visible_slot": "-1"
    }},
    {"action": "set_debug", "field": "show_boss_health_bar", "value": "true", "post_delay_ms": 100},
    {"action": "set_debug", "field": "damage_boss", "value": "lethal", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "hud_layout.boss_health.active": "true",
        "hud_layout.boss_health.drawn": "true",
        "hud_layout.boss_health.green_width": "0"
    }},
    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: Boss health bar -- COMPLETE ==="}
]
