// Derived Neptune geometry; real secret automatic saves, no earned campaign exit
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_start" },
    { "action": "wait_for", "expect": { "in_game": true }, "timeout_ms": 30000 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_skybox" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_base" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_gpu" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    {
        "action": "wait_for",
        "expect": { "time_paused": false, "xl_pog.live_particles": { "gte": 1 } },
        "timeout_ms": 20000,
    },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_live" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_enter" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_gpu" },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_live" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_return" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_gpu" },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_live" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_enter" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_gpu" },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_live" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_return" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_gpu" },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "secret_live" },
    {
        "action": "assert",
        "expect": {
            "xl_pog.secret_entries": 2,
            "xl_pog.secret_returns": 2,
            "xl_pog.particle_owners": 2,
            "xl_pog.passed": true,
        },
    },
    { "action": "introspect" },
]
