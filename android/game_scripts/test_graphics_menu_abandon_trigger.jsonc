// TEST: Keep an unvalidated native-menu edit ineligible for a host process kill
[
    {
        "action": "key",
        "key": "f2",
        "post_delay_ms": 100
    },
    {
        "action": "assert",
        "expect": {
            "menu.subtitle": "Options:",
            "game_window_is_front": "false",
            "graphics_safety.phase": "idle"
        }
    },
    {
        "action": "set_debug",
        "field": "graphics_option",
        "value": "tex_filt:2"
    },
    {
        "action": "wait_ms",
        "ms": 15000
    }
]
