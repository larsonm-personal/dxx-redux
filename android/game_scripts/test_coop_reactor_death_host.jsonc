[
    {
        "_info": {
            "games": [
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "multiplayer.players": {
                "contains_object": {
                    "is_me": false,
                    "score": {
                        "lt": 300
                    },
                    "deaths": {
                        "gte": 1
                    }
                }
            }
        }
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "reactor_clock_start"
    },
    {
        "action": "wait_ms",
        "ms": 10000
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "reactor_clock_verify"
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "physical_exit"
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.phase": 4,
            "coop_travel.prepared": true,
            "time_paused": true
        }
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_hold"
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.arrivals_placed": true,
            "coop_travel.phase": 8,
            "time_paused": true
        }
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_verify"
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_release"
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.active": false,
            "coop_restore.transfer_busy": false,
            "time_paused": false,
            "in_game": true,
            "player_dead": false
        }
    },
    {
        "action": "set_debug",
        "field": "coop_world_test",
        "value": "travel_verify"
    },
    {
        "action": "set_debug",
        "field": "coop_world_test",
        "value": "destroyed_secret_verify"
    },
    {
        "action": "set_debug",
        "field": "clear_robots",
        "value": "true"
    }
]
