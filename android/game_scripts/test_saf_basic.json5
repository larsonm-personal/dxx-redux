// TEST: SAF Archiver Basic
// Verifies the game loads when descent2.ham is served via SAF archiver
//
// Timing data (3 runs on Pixel_6_API_34 emulator):
//   screen_mode=menu (pilot): 28ms, 57ms, 49ms  (min 28ms)
//   screen_mode=menu (main):  24ms, 52ms, 54ms  (min 24ms)
//   in_game:                  37ms, 148ms, 63ms (min 37ms)
// Timeouts set to min + 5s.
[
    {"_info": {"games": ["d2"]}},
    {"action": "log", "message": "=== TEST: SAF Archiver Basic ==="},

    {"action": "wait_ms", "ms": 2000},

    // Accept default pilot name (fresh .plr deleted by runner)
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5028},
    {"action": "select", "text": "Ok", "post_delay_ms": 2000},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5024},
    {"action": "select", "text": "New game", "post_delay_ms": 1000},

    // Mission select
    {"action": "wait_ms", "ms": 1000},
    {"action": "select", "text": "Counterstrike", "post_delay_ms": 1500},
    // accept default level 1
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Ok", "post_delay_ms": 1500},
    // difficulty
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Rookie", "post_delay_ms": 1500},

    // Skip briefing (waits for level load, then escapes if briefing is showing)
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 1000},

    // Wait for game and verify HAM loaded
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "introspect"},

    {"action": "log", "message": "=== TEST: SAF Archiver Basic — COMPLETE ==="}
]
