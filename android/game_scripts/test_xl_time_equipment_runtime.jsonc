// Original Warp Shock6; native-written pilot unlock and five position assists
// Pickups use normal collision; activation uses the Android touch-action dispatcher
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_addon_import",
            "games": ["d2"],
            "vars": { "d2": { "PILOT": "RouteBot" } },
        },
    },
    { "action": "enter_launcher" },
    {
        "action": "setup_command",
        "command": "write_graphics_settings",
        "args": { "settings": "{\"ResolutionX\":960,\"ResolutionY\":540}" },
        "post_delay_ms": 1000,
    },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "${PILOT}", "timeout_ms": 15000 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "Warp Shockwave", "timeout_ms": 15000 },
    { "action": "key", "key": "backspace" },
    { "action": "key", "key": "6" },
    { "action": "select", "text": "Ok", "timeout_ms": 15000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "current_level_num": 6,
            "resolution.render_width": 960,
            "resolution.render_height": 540,
            "xl_pilot.runtime_active": true,
            "xl_pilot.slow_motion.has_slow_motion": false,
            "xl_pilot.slow_motion.has_bullet_time": false,
        },
    },
    { "action": "pose_view", "segment": 553, "position_fixed": [-19269200, -7594325, -14411530] },
    { "action": "wait_for", "timeout_ms": 10000, "expect": { "xl_pilot.slow_motion.has_slow_motion": true } },
    { "action": "pose_view", "segment": 453, "position_fixed": [-19930188, -7615949, 12029218] },
    { "action": "wait_for", "timeout_ms": 10000, "expect": { "xl_pilot.slow_motion.has_bullet_time": true } },
    { "action": "pose_view", "segment": 946, "position_fixed": [-19583457, -8650847, -45334], "heading": 16384 },
    { "action": "meta_action", "id": 1046, "post_delay_ms": 50 },
    {
        "action": "wait_for",
        "timeout_ms": 60000,
        "expect": {
            "xl_pilot.slow_motion.world_speed": { "gte": 3 },
            "xl_pilot.slow_motion.player_speed": { "gte": 3 },
            "xl_pilot.slow_motion.world_direction": 0,
            "xl_pilot.slow_motion.player_direction": 0,
            "player.energy": { "lt": 100 },
        },
    },
    { "action": "pose_view", "segment": 453, "position_fixed": [-19930188, -7615949, 12029218] },
    { "action": "wait_for", "timeout_ms": 15000, "expect": { "player.energy": { "gte": 99 } } },
    { "action": "pose_view", "segment": 946, "position_fixed": [-19583457, -8650847, -45334], "heading": 16384 },
    { "action": "meta_action", "id": 1047, "post_delay_ms": 50 },
    {
        "action": "wait_for",
        "timeout_ms": 60000,
        "expect": {
            "xl_pilot.slow_motion.world_speed": { "gte": 3 },
            "xl_pilot.slow_motion.player_speed": { "lte": 1 },
            "xl_pilot.slow_motion.world_direction": 0,
            "xl_pilot.slow_motion.player_direction": 0,
        },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "save" },
    { "action": "wait_for", "timeout_ms": 10000, "expect": { "menu_subtitle": "Save Game" } },
    { "action": "key", "key": "enter", "post_delay_ms": 500 },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "time_paused": false,
            "current_level_num": 6,
            "xl_pilot.runtime_active": true,
            "xl_pilot.slow_motion.has_slow_motion": true,
            "xl_pilot.slow_motion.has_bullet_time": true,
            "xl_pilot.slow_motion.world_speed": { "gte": 3 },
            "xl_pilot.slow_motion.player_speed": { "lte": 1 },
        },
    },
]
