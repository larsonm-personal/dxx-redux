                    "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1",
                },
                {
                    "file": "water.pig",
                    "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1",
                },
                {
                    "file": "descent.hog",
                    "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052",
                },
                {
                    "file": "descent.pig",
                    "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe",
                },
            ],
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "write_config",
        "file": "graphics_safety.json",
        "content": "{\n  \"accepted\": {\n    \"TexFilt\": 0,\n    \"AnisoLevel\": 0,\n    \"MsaaLevel\": 0,\n    \"MenuTexFilt\": 0,\n    \"HudTexFilt\": 0,\n    \"ResolutionX\": 640,\n    \"ResolutionY\": 480,\n    \"AspectX\": 3,\n    \"AspectY\": 4,\n    \"ColorDepth\": 0\n  },\n  \"attempt\": null,\n  \"pending\": {}\n}\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "action": "write_config",
        "file": "descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\nMenuTexFilt=0\nHudTexFilt=0\nAspectX=3\nAspectY=4\nColorDepth=0\n",
    },
    {
        "action": "write_config",
        "file": "d1x-redux/descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\nMenuTexFilt=0\nHudTexFilt=0\nAspectX=3\nAspectY=4\nColorDepth=0\n",
    },
    {
        "action": "write_config",
        "file": "d2x-redux/descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\nMenuTexFilt=0\nHudTexFilt=0\nAspectX=3\nAspectY=4\nColorDepth=0\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "dlog_graphics_enabled",
            "value": true,
        },
    },
    {
        "action": "enter_game",
        "game": "d1",
        "when": "d1",
    },
    {
        "action": "enter_game",
        "game": "d2",
        "when": "d2",
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 100,
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "skip_briefing",
        "when": "d2",
        "timeout_ms": 10000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
        },
    },
    {
        "action": "set_debug",
        "field": "graphics_queue_option",
        "value": "tex_filt:1",
    },
    {
        "action": "wait_for",
        "expect": {
            "graphics_safety.phase": "challenge",
        },
        "timeout_ms": 10000,
    },
    {
        "action": "controller_input",
        "controller_keys": ["DLEFT", "A"],
        "post_delay_ms": 50,
    },
    {
        "action": "wait_for",
        "expect": {
            "graphics_safety.phase": "idle",
        },
        "timeout_ms": 10000,
    },
    {
        "action": "assert",
        "expect": {
            "graphics_safety.current.TexFilt": "1",
            "graphics_safety.accepted.TexFilt": "1",
            "graphics_safety.requested.TexFilt": "1",
            "time_paused": "false",
        },
    },
    {
        "action": "set_debug",
        "field": "gpu_capabilities_disable",
        "value": "1",
    },
    {
        "action": "set_debug",
        "field": "graphics_queue_option",
        "value": "msaa_level:2",
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
            // The diagnostic override clears the supported format, rejected before sample counts
            "graphics_safety.renderer_failure.failure_reason": "msaa_window_format_changed",
            "graphics_safety.renderer_failure.attempt_phase": "5",
            "graphics_safety.renderer_failure.candidate.MsaaLevel": "2",
            "graphics_safety.renderer_failure.accepted.MsaaLevel": "0",
            "graphics_safety.renderer_failure.accepted.TexFilt": "1",
        },
    },
    {
        "action": "assert",
        "expect": {
            "graphics_safety.current.TexFilt": "1",
            "graphics_safety.current.AnisoLevel": "0",
            "graphics_safety.current.MsaaLevel": "0",
            "graphics_safety.current.MenuTexFilt": "0",
            "graphics_safety.current.HudTexFilt": "0",
            "graphics_safety.current.ResolutionX": "640",
            "graphics_safety.current.ResolutionY": "480",
            "graphics_safety.current.AspectX": "3",
            "graphics_safety.current.AspectY": "4",
            "graphics_safety.current.ColorDepth": "0",
            "graphics_safety.requested.TexFilt": "1",
            "graphics_safety.requested.AnisoLevel": "0",
            "graphics_safety.requested.MsaaLevel": "0",
            "graphics_safety.requested.MenuTexFilt": "0",
            "graphics_safety.requested.HudTexFilt": "0",
            "graphics_safety.requested.ResolutionX": "640",
            "graphics_safety.requested.ResolutionY": "480",
            "graphics_safety.requested.AspectX": "3",
            "graphics_safety.requested.AspectY": "4",
            "graphics_safety.requested.ColorDepth": "0",
            "graphics_safety.accepted.TexFilt": "1",
            "graphics_safety.accepted.AnisoLevel": "0",
            "graphics_safety.accepted.MsaaLevel": "0",
            "graphics_safety.accepted.MenuTexFilt": "0",
            "graphics_safety.accepted.HudTexFilt": "0",
            "graphics_safety.accepted.ResolutionX": "640",
            "graphics_safety.accepted.ResolutionY": "480",
            "graphics_safety.accepted.AspectX": "3",
            "graphics_safety.accepted.AspectY": "4",
            "graphics_safety.accepted.ColorDepth": "0",
            "msaa.last_gl_error": "0",
            "msaa.create_complete": "false",
            "msaa.failure_latched": "false",
            "game_window_is_front": "true",
            "time_paused": "false",
        },
    },
    {
        "action": "assert",
        "expect": {
            "gpu_capabilities.aniso_max": "1.0",
            "gpu_capabilities.msaa_max": "0",
            "gpu_capabilities.msaa_2": "0",
            "gpu_capabilities.msaa_4": "0",
            "gpu_capabilities.color_format": "0",
            "gpu_capabilities.msaa_reason": "MSAA is unavailable (diagnostic capability override)",
            "gpu_capabilities.query_error": "0",
        },
    },
    {
        "action": "set_debug",
        "field": "graphics_queue_option",
        "value": "aniso_level:2",
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
            "graphics_safety.renderer_failure.failure_reason": "anisotropy_unsupported",
            "graphics_safety.current.AnisoLevel": "0",
            "graphics_safety.current.TexFilt": "1",
            "graphics_safety.accepted.TexFilt": "1",
            "time_paused": "false",
        },
    },
    {
        "action": "controller_input",
        "bindings": {
            "START": "Menu",
            "A": "Menu",
        },
        "open_admin": true,
        "expect_ui": {
            "admin_tray_open": true,
            "admin_index": 0,
        },
        "post_delay_ms": 100,
    },
    {
        "action": "controller_input",
        "key": "DDOWN",
        "post_delay_ms": 50,
    },
    {
        "action": "controller_input",
        "key": "DDOWN",
        "post_delay_ms": 50,
    },
    {
        "action": "controller_input",
        "key": "DRIGHT",
        "post_delay_ms": 50,
        "when": "d2",
    },
    {
        "action": "controller_input",
        "key": "DRIGHT",
        "post_delay_ms": 50,
        "when": "d2",
    },
    {
        "action": "controller_input",
        "expect_ui": {
            "admin_label": "Video Info",
        },
    },
    {
        "action": "controller_input",
        "key": "A",
        "post_delay_ms": 50,
    },
    {
        "action": "wait_ms",
        "ms": 1000,
    },
    {
        "action": "controller_input",
        "expect_ui": {
            "admin_tray_open": true,
            "video_open": true,
            "video_selected": "TEX_FILT",
            "video_polling": true,
            "video_tex_filt": 1,
            "video_aniso": 0,
            "video_msaa": 0,
        },
    },
    {
        "action": "controller_input",
        "key": "DDOWN",
        "expect_ui": {
            "video_selected": "TEX_FILT",
            "video_msaa_available": false,
            "video_aniso_available": false,
        },
    },
    {
        "action": "controller_input",
        "key": "B",
        "post_delay_ms": 100,
    },
    {
        "action": "controller_input",
        "key": "B",
        "post_delay_ms": 300,
    },
    {
        "action": "wait_for",
        "timeout_ms": 5000,
        "expect": {
            "time_paused": "false",
        },
    },
    {
        "action": "set_debug",
        "field": "gpu_capabilities_disable",
        "value": "0",
    },
    {
        "action": "assert",
        "expect": {
            "gpu_capabilities.msaa_2": {
                "gte": 2,
            },
            "gpu_capabilities.query_error": "0",
        },
    },
    {
        "action": "set_debug",
        "field": "msaa_color_probe",
        "value": "2",
    },
    {
        "action": "assert",
        "expect": {
            "msaa_probe.passed": "true",
            "msaa_probe.state_restored": "true",
        },
    },
    {
        "action": "set_debug",
        "field": "graphics_queue_option",
        "value": "msaa_level:2",
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "challenge",
            "graphics_safety.current.MsaaLevel": "2",
            "msaa.effective_samples": {
                "gte": 2,
            },
            "msaa.create_complete": "true",
            "msaa.last_gl_error": "0",
        },
    },
    {
        "action": "controller_input",
        "controller_keys": ["DLEFT", "A"],
        "post_delay_ms": 50,
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
            "graphics_safety.current.MsaaLevel": "2",
            "graphics_safety.accepted.MsaaLevel": "2",
            "graphics_safety.current.TexFilt": "1",
            "time_paused": "false",
        },
    },
    {
        "action": "set_debug",
        "field": "msaa_color_probe",
        "value": "2",
    },
    {
        "action": "assert",
        "expect": {
            "msaa_probe.passed": "true",
            "msaa_probe.state_restored": "true",
            "msaa.create_complete": "true",
            "msaa.last_gl_error": "0",
            "fire_primary_state": "0",
            "fire_primary_count": "0",
        },
    },
    {
        "action": "log",
        "message": "Unsupported MSAA and AF restore the full accepted tuple; actual capabilities recover for a later valid trial",
    },
]
