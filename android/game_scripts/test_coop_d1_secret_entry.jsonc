[
    {
        "_info": {
            "games": ["d1", "d2"],
            "_standalone": false,
            "_owner": "test_lan",
            "description": "Enter First Strike secret level -1 through level 10 completion",
        },
    },
    { "action": "assert", "expect": { "current_level_num": 10, "in_game": true, "multiplayer.num_connected": 2 } },
    { "action": "set_debug", "field": "clear_robots", "value": "true" },
    { "action": "trigger_levelcomplete", "value": "secret" },
    {
        "action": "wait_for",
        "timeout_ms": 90000,
        "expect": { "postlevel_active": true, "screen_advance_can_activate": true },
    },
    { "action": "request_screen_advance", "generation": "current" },
    {
        "action": "wait_for",
        "timeout_ms": 60000,
        "expect": {
            "current_level_num": -1,
            "coop_briefing.active": true,
            "coop_briefing.phase": 6,
            "coop_briefing.presenting": true,
            "screen_advance_can_activate": true,
        },
    },
    { "action": "set_debug", "field": "coop_briefing_action", "value": "skip" },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "current_level_num": -1,
            "in_game": true,
            "time_paused": false,
            "game_window_is_front": true,
            "coop_briefing.active": false,
            "multiplayer.num_connected": 2,
        },
    },
    { "action": "set_debug", "field": "clear_robots", "value": "true" },
    { "action": "introspect" },
]
