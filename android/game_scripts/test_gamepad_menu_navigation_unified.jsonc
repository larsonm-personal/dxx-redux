    {
        "action": "select",
        "text": "Load Preset",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "X"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "X"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
