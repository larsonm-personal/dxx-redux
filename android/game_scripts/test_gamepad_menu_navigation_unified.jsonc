// TEST: Android Activity controller dispatch across D1/D2 menus
// Run with android/helpers/run_test.ps1; both games are required
[
    {
        "_info": {
            "games": [
                "d1",
                "d2"
            ],
            "vars": {
                "d1": {
                    "GAME": "d1",
                    "GAME_NUM": "1",
                    "MISSION": "First Strike"
                },
                "d2": {
                    "GAME": "d2",
                    "GAME_NUM": "2",
                    "MISSION": "Counterstrike"
                }
            },
            "_deps": [
                {
                    "file": "descent2.hog",
                    "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"
                },
                {
                    "file": "descent2.ham",
                    "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"
                },
                {
                    "file": "groupa.pig",
                    "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"
                },
                {
                    "file": "descent2.s22",
                    "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"
                },
                {
                    "file": "alien1.pig",
                    "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"
                },
                {
                    "file": "alien2.pig",
                    "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"
                },
                {
                    "file": "fire.pig",
                    "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"
                },
                {
                    "file": "ice.pig",
                    "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"
                },
                {
                    "file": "water.pig",
                    "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"
                },
                {
                    "file": "descent.hog",
                    "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"
                },
                {
                    "file": "descent.pig",
                    "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"
                }
            ]
        }
    },
    {
        "action": "enter_launcher"
    },
    {
        "action": "reset_state"
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false
        },
        "post_delay_ms": 100
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false
        },
        "post_delay_ms": 100
    },
    {
        "action": "write_config",
        "file": "${GAME}x-redux/demos/controller-test.dem",
        "content": "controller menu deletion fixture\n"
    },
    {
        "action": "write_config",
        "file": "${GAME}x-redux/controller-test.ngs",
        "content": "game_name=Controller menu test\n"
    },
    {
        "action": "enter_game",
        "game": "${GAME}"
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000
    },
    {
        "action": "select",
        "text": "Ok",
        "post_delay_ms": 200,
        "timeout_ms": 5000,
        "when": "d2"
    },
    {
        "action": "key",
        "key": "enter",
        "post_delay_ms": 150,
        "when": "d1"
    },
    {
        "action": "log",
        "message": "Default B backs out of a native submenu without opening Android overlays"
    },
    {
        "action": "select",
        "text": "Options",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "controller_menu_open": false
        }
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu",
            "menu.items[0].text": {
                "contains": "New game"
            }
        }
    },
    {
        "action": "log",
        "message": "Menu confirm, directions and shortcuts override remapped gameplay meta actions"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "bindings": {
            "A": "Guide Bot Menu",
            "B": "Menu",
            "X": "Quick Save",
            "Y": "Guide Bot Menu",
            "DDown": "Quick Save",
            "DUp": "Menu",
            "DLeft": "Menu",
            "DRight": "Menu"
        }
    },
    {
        "action": "select",
        "text": "Options",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": 2
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.subtitle": "Controls"
        }
    },
    {
        "action": "key",
        "key": "home",
        "post_delay_ms": 150
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.items[0].value": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.items[0].value": 1
        }
    },
    {
        "action": "select",
        "text": "CUSTOMIZE KEYBOARD",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "kconfig",
            "menu.selected_index": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": 2
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.changing": true
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "kconfig",
            "menu.changing": false
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {
            "LS_Y": 1
        }
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": 4
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {}
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "kconfig"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": {
                "gt": 0
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "select",
        "text": "CUSTOMIZE WEAPON KEYS",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "set_menu_viewport",
        "zoom_milli": 2000,
        "pan_milli": 0
    },
    {
        "action": "wait_ms",
        "ms": 200
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "R1"
    },
    {
        "action": "assert",
        "expect": {
            "menu_scale.scroll_y": {
                "gt": 0
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "L1"
    },
    {
        "action": "assert",
        "expect": {
            "menu_scale.scroll_y": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "set_menu_viewport",
        "zoom_milli": 1000,
        "pan_milli": 0
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "log",
        "message": "Analog navigation changes only the front overlay, and B returns from its child"
    },
    {
        "action": "key",
        "key": "home",
        "post_delay_ms": 150
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "Select"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "controller_menu_open": true,
            "admin_tray_open": false,
            "remaining_index": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {
            "LS_Y": 1
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "remaining_index": 1
        },
        "when": "d2"
    },
    {
        "action": "controller_input",
        "expect_ui": {
            "remaining_index": 0
        },
        "when": "d1",
        "post_delay_ms": 200
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {}
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "controller_menu_open": false
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "Select"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "Select"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "admin_tray_open": true,
            "admin_index": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {
            "RS_Y": 1
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "admin_index": 3
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {}
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "controller_input",
        "key": "DDown",
        "when": "d2",
        "post_delay_ms": 200
    },
    {
        "action": "controller_input",
        "expect_ui": {
            "admin_index": 9
        },
        "when": "d1",
        "post_delay_ms": 200
    },
    {
        "action": "controller_input",
        "expect_ui": {
            "admin_index": 12
        },
        "when": "d2",
        "post_delay_ms": 200
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "music_open": true,
            "admin_tray_open": true
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "music_open": false,
            "admin_tray_open": true
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "expect_ui": {
            "controller_menu_open": false
        }
    },
    {
        "action": "assert",
        "expect": {
            "menu.selected_index": 0
        }
    },
    {
        "action": "log",
        "message": "Custom scores and credits windows accept A/B; score reset remains confirmed"
    },
    {
        "action": "select",
        "text": "High scores",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "scores"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "select",
        "text": "High scores",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "Y"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "scores"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "select",
        "text": "Credits",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "credits"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "log",
        "message": "Demo X/Y actions use the existing confirmation dialogs"
    },
    {
        "action": "select",
        "text": "View demo",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox",
            "menu.title": {
                "contains": "X: delete"
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "Y"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu",
            "menu.subtitle": {
                "contains": "endianness"
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "X"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "X"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox",
            "menu.num_items": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "log",
        "message": "A hold/release still supports pilot deletion and weapon reordering"
    },
    {
        "action": "select",
        "text": "Change pilots",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "pressed": true,
        "key": "A"
    },
    {
        "action": "wait_ms",
        "ms": 700
    },
    {
        "action": "assert",
        "expect": {
            "menu.subtitle": {
                "contains": "Delete Pilot:"
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "pressed": false,
        "key": "A"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "listbox"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "select",
        "text": "Options",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "select",
        "text": "Primary autoselect ordering",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "pressed": true,
        "key": "A"
    },
    {
        "action": "wait_ms",
        "ms": 700
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "DDown"
    },
    {
        "action": "assert",
        "expect": {
            "menu.title": "Reorder Primary",
            "menu.selected_index": 1
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "pressed": false,
        "key": "A"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "menu.title": "Reorder Primary"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "log",
        "message": "Preset deletion/defaults and Netgame Info work from controller input"
    },
    {
        "action": "select",
        "text": "Multiplayer",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "select",
        "text": "HOST GAME",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "select_mission",
