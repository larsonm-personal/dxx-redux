        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "reload_bindings": true
    },
    {
        "action": "log",
        "message": "Gameplay, pause, automap and Guide Bot menu transitions"
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "select",
        "text": "Ok",
        "post_delay_ms": 200,
        "timeout_ms": 5000,
        "when": "d2"
    },
    {
        "action": "key",
        "key": "enter",
        "post_delay_ms": 150,
        "when": "d1"
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 200,
        "timeout_ms": 5000
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 150,
        "when": "d1"
    },
    {
        "action": "skip_briefing",
        "when": "d2",
        "timeout_ms": 15000,
        "post_delay_ms": 200
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 15000
    },
    {
        "action": "controller_input",
        "axes": {
            "LS_X": 0.8
        },
        "post_delay_ms": 200
    },
    {
        "action": "assert",
        "expect": {
            "raw_joy_axis[0]": {
                "gt": 0
            }
        }
    },
    {
        "action": "controller_input",
        "axes": {},
        "post_delay_ms": 200
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "pause",
        "post_delay_ms": 200
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": false
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": true
        }
    },
    {
        "action": "pose_view",
        "segment": 0,
        "x": 0,
        "y": 0,
        "z": 0,
        "heading": 0,
        "pitch": 0,
        "bank": 0,
        "post_delay_ms": 150
    },
    {
        "action": "key",
        "key": "tab",
        "post_delay_ms": 150
    },
    {
        "action": "assert",
        "expect": {
            "automap_active": true,
            "automap.freeflight": true,
            "automap.view_forward_x": {
                "range": [
                    0,
                    0
                ]
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {
            "RS_X": 0.8
        }
    },
    {
        "action": "assert",
        "expect": {
            "automap.view_forward_x": {
                "ne": 0
            }
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {}
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 150
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": true
        }
    },
    {
        "action": "set_debug",
        "field": "release_guidebot_cage",
        "value": "true",
        "post_delay_ms": 300,
        "when": "d2"
    },
    {
        "action": "wait_for",
        "when": "d2",
        "timeout_ms": 10000,
        "expect": {
            "guidebot.released": true
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "when": "d2",
        "key": "Y"
    },
    {
        "action": "assert",
        "when": "d2",
        "expect": {
            "menu.type": "guidebot",
            "menu.selected_index": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {
            "RS_Y": 1
        },
        "when": "d2"
    },
    {
        "action": "assert",
        "when": "d2",
        "expect": {
            "menu.selected_index": 1
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "axes": {},
        "when": "d2"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "when": "d2",
        "key": "B"
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": true
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "when": "d2",
        "key": "Y"
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "when": "d2",
        "key": "Y"
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": true
        }
    },
    {
        "action": "log",
        "message": "Controller menu integration complete"
    }
]
