            "menu.num_items": 0
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "B"
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "netgame_info",
        "post_delay_ms": 200
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "unknown_window"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
        "key": "A"
    },
    {
        "action": "assert",
        "expect": {
            "menu.type": "newmenu"
        }
    },
    {
        "action": "controller_input",
        "post_delay_ms": 200,
