[
    {"_info": {"description": "Launcher raw controller reports include hidden axes and unknown buttons without rebinding", "games": ["d2"]}},
    {"action": "enter_launcher"},
    {"action": "controller_input", "key": "L2", "pressed": true},
    {"action": "controller_input", "key": "188", "pressed": true},
    {"action": "controller_input", "axes": {"BRAKE": 0.45, "GAS": 0.7, "40": 0.625}},
    {"action": "assert", "expect": {
        "controller_raw_inputs.axes": {"contains": "AXIS_BRAKE"},
        "controller_raw_inputs.buttons": {"contains": "KEYCODE_BUTTON_1"},
        "controller_raw_inputs.axes[2].axis": 40,
        "controller_raw_inputs.axes[2].value": 0.625,
        "controller_raw_inputs.axes[2].advertised": false,
        "controller_raw_inputs.buttons[0].pressed": true
    }},
    {"action": "controller_input", "key": "L2", "pressed": false},
    {"action": "controller_input", "key": "188", "pressed": false},
    {"action": "controller_input", "axes": {"BRAKE": 0.0, "GAS": 0.0, "40": 0.0}},
    {"action": "assert", "expect": {
        "controller_raw_inputs.axes[2].value": {"eq": 0},
        "controller_raw_inputs.buttons[0].pressed": false,
        "controller_raw_inputs.buttons[1].pressed": false,
        "controller_raw_inputs.recent_events": {"contains": "released"}
    }},
    {"action": "tap_button", "text": "Controller Mapping", "exact": true},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"controller_mapping.active": true, "controller_mapping.action_index": 0}},
    {"action": "controller_input", "key": "DDOWN", "pressed": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": false},
    {"action": "controller_input", "key": "DDOWN", "pressed": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": false},
    {"action": "controller_input", "key": "DDOWN", "pressed": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": false},
    {"action": "controller_input", "key": "A", "pressed": true},
    {"action": "controller_input", "key": "A", "pressed": false},
    {"action": "assert", "expect": {"controller_mapping.action_index": 6, "controller_mapping.dialog_open": true, "buttons": {"contains": "Scroll down"}}},
    {"action": "controller_input", "key": "B", "pressed": true},
    {"action": "controller_input", "key": "B", "pressed": false},
    {"action": "assert", "expect": {"buttons": {"not_contains": "Scroll down"}}},
    // Extra binding targets remain reachable with controller-only navigation
    {"action": "controller_input", "key": "DDOWN", "pressed": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": false},
    {"action": "controller_input", "key": "A", "pressed": true},
    {"action": "controller_input", "key": "A", "pressed": false},
    {"action": "assert", "expect": {"controller_mapping.action_index": 8, "controller_mapping.selected_control": "BRAKE"}},
    {"action": "tap_button", "text": "Cancel", "exact": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": true},
    {"action": "controller_input", "key": "DDOWN", "pressed": false},
    {"action": "controller_input", "key": "A", "pressed": true},
    {"action": "controller_input", "key": "A", "pressed": false},
    {"action": "assert", "expect": {"controller_mapping.action_index": 10, "controller_mapping.selected_control": "L2"}},
    {"action": "tap_button", "text": "Cancel", "exact": true},
    {"action": "tap_button", "text": "Cancel", "exact": true}
]
