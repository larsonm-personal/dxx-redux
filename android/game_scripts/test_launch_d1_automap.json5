// TEST: Launch D1 to Automap
// Verifies normal D1 game launch through to automap screen.
// D1 differs from D2: uses "First Strike" mission, briefing is unknown_window
// (not "movie"), and mission select is a listbox.
[
    {"action": "log", "message": "=== TEST: Launch D1 to Automap ==="},

    {"action": "wait_ms", "ms": 2000},

    // Pilot select — pick existing pilot
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 10000},
    {"action": "select", "text": "player", "post_delay_ms": 2000},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 1500},

    // Mission select (D1 base mission)
    {"action": "wait_ms", "ms": 1000},
    {"action": "select", "text": "First Strike", "post_delay_ms": 1500},

    // Accept default level 1
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Ok", "post_delay_ms": 1500},

    // Difficulty
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Rookie", "post_delay_ms": 1500},

    // Skip briefing (D1 briefing shows as unknown_window — Escape skips it)
    {"action": "key", "key": "escape", "post_delay_ms": 2000},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    // TAB for automap
    {"action": "key", "key": "tab", "post_delay_ms": 2000},
    {"action": "assert", "expect": {"automap_active": "true", "in_game": "true", "screen_mode": "game"}},

    {"action": "log", "message": "=== TEST: Launch D1 to Automap — COMPLETE ==="},
    {"action": "introspect"}
]
