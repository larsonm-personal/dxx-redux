// Original PMC3 quick checkpoint, fresh process and ordinary Load Game menu
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "select", "text": "Load Game", "timeout_ms": 15000 },
    { "action": "select", "text": "[quick] level 13", "timeout_ms": 15000 },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "current_level_num": 13,
            "xl_pilot.runtime_active": true,
            "game_window_is_front": true,
        },
        "timeout_ms": 120000,
    },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_checkpoint" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_monitor" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "wait_ms", "ms": 1500 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_live" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_lightning" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_aim_camera" },
    { "action": "send_button", "button": 100, "held": 1 },
    { "action": "wait_ms", "ms": 700 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "pmc_fired_camera" },
    { "action": "send_button", "button": 100, "pressed": 0 },
    { "action": "introspect" },
]
