    {
        "action": "key",
        "key": "enter",
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "current_level_num": 4,
            "position.segment": 126,
            "player_dead": false,
