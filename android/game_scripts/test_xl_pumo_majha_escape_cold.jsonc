[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_pog_runtime",
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Load Game",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "[quick] level 3",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "current_level_num": 3,
            "position.segment": 598,
            "player.has_blue_key": true,
            "player.has_red_key": true,
            "player.has_gold_key": false,
            "player_dead": false,
            "cheats_enabled": false,
            "player.invulnerable": false,
            "xl_pilot.remaining_objectives": 0,
            "reactor_countdown.active": true,
            "reactor_countdown.total_seconds": 90,
            "xl_pilot.wall_triggers.5.operated": false,
        },
        "timeout_ms": 120000,
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": -1.0,
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.wall_triggers.5.operated": true,
            "xl_pilot.boosts.0.owner": 0,
            "xl_pilot.boost_player_locked": true,
        },
        "timeout_ms": 10000,
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": 0.0,
    },
    {
        "action": "wait_for",
        "expect": {
            "menu.subtitle": {
                "contains": "Level 3 Complete",
            },
        },
        "timeout_ms": 20000,
    },
    {
        "action": "assert",
        "expect": {
            "player_dead": false,
            "cheats_enabled": false,
            "player.invulnerable": false,
            "player.has_blue_key": true,
            "player.has_red_key": true,
            "player.has_gold_key": false,
