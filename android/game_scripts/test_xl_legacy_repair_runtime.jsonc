// Derived 17/36 repair controls; owned by the repair runner with -Legacy17
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_repair_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived legacy repair",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 100,
    },
    {
        "action": "face_view",
        "segment": 6,
        "side": 3,
        "distance": 8,
        "post_delay_ms": 100,
    },
    {
        "action": "set_debug",
        "field": "damage_player",
        "value": "40",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_ms",
        "ms": 700,
    },
    {
        "action": "assert",
        "expect": {
            "position.segment": 6,
            "player.shields": {
                "range": [60, 60],
            },
