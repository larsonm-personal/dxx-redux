// TEST TEMPLATE: Mission ZIP batch import, metadata export, and D2 level 1 launch.
// This is resolved and pushed by android/helpers/run_mission_zip_batch.ps1.
[
    {"_info": {
        "games": ["d2"],
        "_standalone": false
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "clear_mods"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "clear_crash_reports", "post_delay_ms": 250},
    {"action": "import_mission_zip", "file": "${ZIP_FILE}", "label": "${ZIP_LABEL}", "display_name": "${ZIP_DISPLAY_NAME}"},
    {"action": "analyze_level_metadata_all", "label": "${ZIP_LABEL}", "mod_file": "${ZIP_FILE}", "game": "d2", "status": "ok", "min_total_levels": 1},
    {"action": "tap_button", "text": "Launch Descent 2", "launches_game": true},

    {"action": "log", "message": "=== TEST: Mission ZIP batch ${ZIP_DISPLAY_NAME} ==="},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000, "optional": true},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "assert_mission_list_has_non_base", "timeout_ms": 10000},
    {"action": "select_non_base_mission", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 60000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: Mission ZIP batch ${ZIP_DISPLAY_NAME} -- PASS ==="}
]
