        "value": "prepare",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "drain",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "checkpoints.pending": 0,
            "checkpoints.failed": 0,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip_paused",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "disk_save",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "disk_load",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_level_message_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "resume",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "key",
