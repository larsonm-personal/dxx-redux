// Full, half, empty and overfull energy in full cockpit, status bar and fullscreen
[
    {
        "_info": {
            "games": [
                "d1",
                "d2"
            ],
            "vars": {
                "d1": {
                    "GAME": "d1",
                    "MISSION": "First Strike"
                },
                "d2": {
                    "GAME": "d2",
                    "MISSION": "Counterstrike"
                }
            },
            "params": {
                "ASSETS": {
                    "description": "Use d1_in_d2 with -Game d2 for the imported D1 cockpit",
                    "options": {
                        "native": {},
                        "d1_in_d2": {"GAME": "d1-in-d2", "MISSION": "First Strike"}
                    }
                }
            },
            "_deps": [
                {
                    "file": "descent2.hog",
                    "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"
                },
                {
                    "file": "descent2.ham",
                    "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"
                },
                {
                    "file": "groupa.pig",
                    "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"
                },
                {
                    "file": "descent2.s22",
                    "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"
                },
