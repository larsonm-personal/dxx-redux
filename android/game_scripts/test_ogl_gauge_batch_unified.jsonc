                    "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"
                },
                {
                    "file": "alien2.pig",
                    "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"
                },
                {
                    "file": "fire.pig",
                    "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"
                },
                {
                    "file": "ice.pig",
                    "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"
                },
                {
                    "file": "water.pig",
                    "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"
                },
                {
                    "file": "descent.hog",
                    "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"
                },
                {
                    "file": "descent.pig",
                    "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"
                }
            ],
            "description": "Exercise full cockpit and status-bar gauge batching, including empty batches"
        }
    },
    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "write_bool_pref", "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "probe_gles_vbo"},
    {"action": "select", "text": "Ok", "optional": true},
    {"action": "key", "key": "enter", "when": "d1"},
    {"action": "enter_launcher"},
    {"action": "setup_command", "command": "write_engine_prefs", "args": {"cockpit_mode": 0}},
    {"action": "setup_command", "command": "write_bool_pref", "args": {"key": "dlog_profiling_enabled", "value": true}},
    {"action": "enter_game", "game": "${GAME}"},
    {"action": "skip_intro", "timeout_ms": 20000},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "key", "key": "enter", "post_delay_ms": 100},
    {"action": "select", "text": "New game", "timeout_ms": 10000},
    {"action": "select_mission", "text": "${MISSION}", "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "when": "d2", "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1"},
    {"action": "select", "text": "Trainee", "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 60000},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "set_debug", "field": "clear_robots", "value": "1"},
    {"action": "assert", "expect": {"current_cockpit_mode": 0}},
    {"action": "set_debug", "field": "player_energy", "value": "100"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "100.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "50"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "50.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "0"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "0.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "200"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "200.0", "player_dead": false}},
    {"action": "key", "key": "f3"},
    {"action": "assert", "expect": {"current_cockpit_mode": 2}},
    {"action": "set_debug", "field": "player_energy", "value": "100"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "100.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "50"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "50.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "0"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "0.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "200"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "200.0", "player_dead": false}},
    {"action": "key", "key": "f3"},
    {"action": "assert", "expect": {"current_cockpit_mode": 3}},
    {"action": "set_debug", "field": "player_energy", "value": "100"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "100.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "50"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "50.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "0"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "0.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "200"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "200.0", "player_dead": false}},
    {"action": "key", "key": "f3"},
    {"action": "assert", "expect": {"current_cockpit_mode": 0}},
    {"action": "set_debug", "field": "player_energy", "value": "100"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "100.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "50"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "50.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "0"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "0.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "200"},
    {"action": "wait_ms", "ms": 500},
    {"action": "assert", "expect": {"player.energy": "200.0", "player_dead": false}},
    {"action": "set_debug", "field": "player_energy", "value": "50"},
    {"action": "wait_ms", "ms": 18000},
    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: Cockpit gauge batching -- PASS ==="}
]
