[
    {
        "_info": {
            "games": ["d1", "d2"],
            "_standalone": false,
            "_owner": "test_lan",
            "params": { "operation": { "label": "Checkpoint operation" } },
        },
    },
    { "action": "wait_for", "expect": { "checkpoints.pending": 0 }, "timeout_ms": 180000 },
    { "action": "set_debug", "field": "coop_checkpoint_test", "value": "${operation}" },
    { "action": "wait_ms", "ms": 1000 },
    {
        "action": "wait_for",
        "expect": { "checkpoints.pending": 0, "coop_restore.transfer_busy": false },
        "timeout_ms": 180000,
    },
    { "action": "assert", "expect": { "in_game": true, "time_paused": false, "multiplayer.num_connected": 2 } },
]
