// Full XL pool, high-ID contacts and disk/checkpoint restoration; no campaign qualification
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_object_capacity_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Neptune (XL)",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "prepare",
        "post_delay_ms": 0,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.projectile_count": 2,
        },
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "drain",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "checkpoints.pending": 0,
            "checkpoints.failed": 0,
            "time_paused": true,
        },
        "timeout_ms": 15000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "disk_save",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_ms",
        "ms": 300,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "disturb",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "resume",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "Counterstrike",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": false,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "stock",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "disk_load",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.projectile_count": 2,
        },
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "reuse",
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "disk_load",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_ms",
        "ms": 300,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "xl_object_capacity_probe",
        "value": "verify",
        "post_delay_ms": 0,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.projectile_count": 2,
        },
        "post_delay_ms": 0,
    },
]
