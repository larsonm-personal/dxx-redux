// Original content, ordinary input and checkpoint smoke; no human traversal claim
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "Pumo Mines", "timeout_ms": 15000 },
    { "action": "select", "text": "Ok", "timeout_ms": 15000 },
    { "action": "select", "text": "Trainee", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "xl_pilot.runtime_active": true,
            "current_level_num": 1,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "assert",
        "expect": {
            "player.energy": { "range": [100, 100] },
            "player.shields": { "range": [100, 100] },
            "player.lives": 3,
            "player.primary_weapon_flags": 1,
            "player.laser_level": 0,
            "cheats_enabled": false,
        },
    },
    { "action": "send_axis", "axis": 2, "axis_value": 0.5, "post_delay_ms": 0 },
    { "action": "assert", "expect": { "axis_probe.processed": true, "axis_probe.heading_time": { "gt": 0 } } },
    { "action": "wait_ms", "ms": 500 },
    { "action": "send_axis", "axis": 2, "axis_value": 0.0, "post_delay_ms": 0 },
    { "action": "send_axis", "axis": 1, "axis_value": -0.5, "post_delay_ms": 0 },
    { "action": "assert", "expect": { "axis_probe.processed": true, "axis_probe.throttle_time": { "gt": 0 } } },
    { "action": "wait_ms", "ms": 500 },
    { "action": "send_axis", "axis": 1, "axis_value": 0.0, "post_delay_ms": 0 },
    { "action": "send_button", "button": 100, "held": 1 },
    { "action": "wait_for", "expect": { "player.energy": { "lt": 100 } }, "timeout_ms": 5000 },
    { "action": "send_button", "button": 100, "pressed": 0 },
    { "action": "set_debug", "field": "damage_player", "value": "25" },
    { "action": "wait_for", "expect": { "player.shields": { "lt": 100 }, "player_dead": false }, "timeout_ms": 5000 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 5000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "capture" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "flow_capture" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "disk_save" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 5000 },
    { "action": "set_debug", "field": "damage_player", "value": "250" },
    {
        "action": "wait_for",
        "expect": { "player_dead": true, "player_exploded": true, "screen_advance_can_activate": true },
        "timeout_ms": 30000,
    },
    { "action": "send_button", "button": 0 },
    {
        "action": "wait_for",
        "expect": { "player_dead": false, "player.lives": 2, "current_level_num": 1 },
        "timeout_ms": 30000,
    },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "disk_load" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "verify_saved" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "flow_restored" },
    { "action": "assert", "expect": { "player.lives": 3, "player.shields": { "lt": 100 } } },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 5000 },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 1000 },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "select", "text": "Abort Game", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "in_game": false }, "timeout_ms": 10000 },
    { "action": "select", "text": "Load Game", "post_delay_ms": 200 },
    { "action": "select", "text": "[quick] level 1", "timeout_ms": 15000 },
    {
        "action": "wait_for",
        "expect": { "in_game": true, "time_paused": false, "current_level_num": 1 },
        "timeout_ms": 120000,
    },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 5000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "verify_saved" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "flow_restored" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 5000 },
    // Controlled authored exit dispatch, followed by fixed original-content probes
    { "action": "set_debug", "field": "xl_pog_probe", "value": "flow_exit2", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "current_level_num": 2, "game_window_is_front": true }, "timeout_ms": 30000 },
    { "action": "assert", "expect": { "player.shields": { "range": [100, 100] }, "cheats_enabled": false } },
    { "action": "set_debug", "field": "damage_player", "value": "25" },
    { "action": "assert", "expect": { "player.shields": { "range": [75, 75] } } },
    // Authored shield object 9 in segment 178; normal physics performs collection
    { "action": "pose_view", "segment": 178, "position_fixed": [-6376260, -7012352, -6667561] },
    { "action": "wait_for", "expect": { "player.shields": { "gt": 75 } }, "timeout_ms": 5000 },
    // Fixed segment-eight center, ordinary aim/fire at original robot 36 next door
    { "action": "pose_view", "segment": 8, "position_fixed": [-1852775, -2934056, 7653937] },
    { "action": "attack_object", "object": 36, "distance": 80, "timeout_ms": 60000 },
    {
        "action": "assert",
        "expect": { "player.robots_killed_level": { "gte": 1 }, "cheats_enabled": false, "player_dead": false },
    },
    { "action": "introspect" },
]
