[
    {
        "_info": {
            "games": ["d1"],
            "_standalone": false,
            "_owner": "test_macplay_audio",
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "setup_command",
        "command": "create_set",
        "args": {
            "name": "macplay_audio_test",
        },
    },
    {
        "action": "setup_command",
        "command": "switch_set",
        "args": {
            "name": "macplay_audio_test",
        },
    },
    {
        "action": "setup_command",
        "command": "clear_set",
        "args": {
            "name": "macplay_audio_test",
        },
    },
    {
        "action": "clear_mods",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "setup_command",
        "command": "clear_audio_sources",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_music_prefs",
        "args": {
            "source": "midi",
            "prefer_mission_soundtrack": false,
        },
    },
    {
        "action": "setup_command",
        "command": "music_renderer_select",
        "args": {
            "renderer": "sf2",
        },
    },
    {
        "action": "setup_command",
        "command": "music_soundfont_select",
    },
    {
        "action": "setup_command",
        "command": "music_eq_select",
        "args": {
            "preset": "measured-sc55-balanced",
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "args": {
            "value": true,
            "key": "dlog_game logs_enabled",
        },
        "action": "setup_command",
        "command": "write_bool_pref",
    },
    {
        "action": "setup_command",
        "command": "import_cd",
        "args": {
            "cue_path": "/data/local/tmp/dxx-macplay-audio/disc.cue",
            "bin_path": "/data/local/tmp/dxx-macplay-audio/disc.bin",
            "include_audio": false,
        },
    },
    {
        "action": "wait_for",
        "field": "import_state.status",
        "value": "complete",
        "timeout_ms": 180000,
    },
    {
        "action": "assert",
        "expect": {
            "d1.ready": true,
        },
    },
    {
        "action": "enter_game",
        "game": "d1",
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "key",
        "key": "enter",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select_mission",
        "text": "First Strike",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 100,
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 10000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "wait_ms",
        "ms": 500,
    },
    {
        "action": "assert",
        "expect": {
            "audio.effects_volume": 8,
            "audio.music_volume": 8,
            "audio.effects_channel_volume": 20,
        },
    },
    {
        "action": "set_debug",
        "field": "audio_effects_volume",
        "value": "4",
    },
    {
        "action": "assert",
        "expect": {
            "audio.effects_volume": 4,
            "audio.effects_channel_volume": 10,
        },
    },
    {
        "action": "set_debug",
        "field": "audio_effects_volume",
        "value": "0",
    },
    {
        "action": "assert",
        "expect": {
            "audio.effects_volume": 0,
            "audio.effects_channel_volume": 0,
        },
    },
    {
        "action": "set_debug",
        "field": "audio_effects_volume",
        "value": "8",
    },
    {
        "action": "assert",
        "expect": {
            "game_window_is_front": true,
            "time_paused": false,
        },
    },
    {
        "action": "set_debug",
        "field": "audio_music_volume",
        "value": "0",
    },
    {
        "action": "set_debug",
        "field": "capture_audio",
        "value": "start",
    },
    {
        "action": "set_debug",
        "field": "audio_effects_probe",
        "value": "laser",
    },
    {
        "action": "wait_ms",
        "ms": 1200,
    },
    {
        "action": "set_debug",
        "field": "audio_effects_probe",
        "value": "explosion",
    },
    {
        "action": "wait_ms",
        "ms": 2000,
    },
    {
        "action": "set_debug",
        "field": "capture_audio",
        "value": "stop",
    },
    {
        "action": "introspect",
    },
]
