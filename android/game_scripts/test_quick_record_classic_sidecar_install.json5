// TEST: Install the staged quick demo triplet into the active set from the launcher
//
// Assumes a single staged recorded demo is present from the stage test. Opens
// the Advanced page as a smoke check, then uses the launcher automation helper
// to install the staged demo into the active set for adb inspection.
[
    {"_info": {
        "games": ["d2"]
    }},

    {"action": "enter_launcher"},
    {"action": "setup_command", "command": "clear_crash_reports", "post_delay_ms": 250},
    {"action": "wait_for", "field": "staged_input_demo_count", "value": "1", "timeout_ms": 10000},
    {"action": "assert", "expect": {
        "staged_input_demos[0].game": "d2",
        "staged_input_demos[0].level": "1",
        "staged_input_demos[0].frame_count": {"gte": 1},
        "staged_input_demos[0].header_readable": "true",
        "staged_input_demos[0].has_rng_trace": "true",
        "staged_input_demos[0].has_classic_demo": "true"
    }},
    {"action": "assert_button", "text": "Advanced"},
    {"action": "tap_button", "text": "Advanced", "post_delay_ms": 600},
    {"action": "install_staged_demo", "game": "d2", "name": "quick_record_sidecar_install"},
    {"action": "wait_for", "field": "staged_input_demo_count", "value": "0", "timeout_ms": 10000},
    {"action": "assert", "expect": {
        "installed_input_demos[0].filename": "quick_record_sidecar_install.dximdemo",
        "installed_input_demos[0].game": "d2",
        "installed_input_demos[0].level": "1",
        "installed_input_demos[0].frame_count": {"gte": 1},
        "installed_input_demos[0].header_readable": "true",
        "installed_input_demos[0].has_rng_trace": "true",
        "installed_input_demos[0].has_classic_demo": "true"
    }},

    {"action": "log", "message": "=== TEST: Quick record staged install -- PASS ==="}
]
