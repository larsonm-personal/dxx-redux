// TEST HELPER: Joiner side of the two-peer Guide-Bot ownership scenario.
// Run with test_lan.ps1 -GuidebotOwnership alongside the host helper.
[
    {"_info": {"games": ["d2"], "_standalone": false, "_owner": "test_lan"}},

    {"action": "log", "message": "=== COOP GUIDEBOT OWNER: joiner ==="},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {
        "in_game": "true",
        "is_network": "true",
        "multiplayer.my_player_num": "1",
        "multiplayer.num_connected": "2",
        "level_metadata_route.background_request_generation": {"gte": 1}
    }},

    {"action": "wait_for", "timeout_ms": 45000, "expect": {
        "guidebot.released": "true",
        "guidebot.owner_player": "0",
        "guidebot.owner_is_local": "false",
        "guidebot.owner_generation": {"gte": 1},
        "guidebot.remote_owner": "0",
        "guidebot.local_control_slot_matches": "false"
    }},

    {"action": "wait_for", "timeout_ms": 15000, "expect": {
        "guidebot.owner_player": "1",
        "guidebot.owner_is_local": "true",
        "guidebot.owner_generation": {"gte": 2},
        "guidebot.remote_owner": "1",
        "guidebot.local_control_slot_matches": "true"
    }},
    {"action": "set_debug", "field": "automap_visit_all", "value": "true", "post_delay_ms": 100},
    {"action": "set_debug", "field": "automap_unvisit_segment", "value": "56", "post_delay_ms": 100},
    {"action": "meta_action", "id": 1043, "post_delay_ms": 500},
    {"action": "wait_for", "timeout_ms": 60000, "expect": {
        "guidebot.owner_player": "1",
        "guidebot.owner_is_local": "true",
        "guidebot.owner_generation": {"gte": 3},
        "guidebot.route_target_mode_name": "unexplored",
        "guidebot.route_goal_active": "true",
        "guidebot.route_goal_label": "Unexplored",
        "guidebot.route_goal_objective_kind": "1000",
        "guidebot.route_goal_path_endpoint_seg": "56",
        "guidebot.route_goal_path_pending": "true",
        "guidebot.route_metadata_rescan_count": {"gte": 1},
        "guidebot.unexplored_component_size": "1",
        "guidebot.unexplored_target_seg": "56",
        "guidebot.unexplored_direct_reachable": "true"
    }},

    {"action": "set_debug", "field": "damage_player", "value": "250", "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 15000, "expect": {
        "player_dead": "true",
        "guidebot.owner_player": "1",
        "guidebot.owner_is_local": "true",
        "guidebot.owner_generation": "3",
        "guidebot.remote_owner": "1",
        "guidebot.local_control_slot_matches": "true",
        "guidebot.route_target_mode_name": "unexplored"
    }},
    {"action": "introspect"},
    {"action": "log", "message": "=== COOP GUIDEBOT OWNER: joiner PASS ==="}
]
