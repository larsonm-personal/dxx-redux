// TEST: Death state via the normal engine damage path
// Verifies player_dead introspection after launching a real level.
//   D1: Level 11 of "First Strike" -- instant threat
//   D2: Level 24 of "Counterstrike" -- mid-game level that loads quickly
//
// Uses _info.vars for game-specific mission name, level number, and
// level input keys. Steps with "when" are only run for that game.

// Timing data (3 runs on Pixel_6_API_34 emulator):
//   screen_mode=menu (pilot): 28ms, 64ms, 46ms  (min 28ms)
//   screen_mode=menu (main):  32ms, 41ms, 57ms  (min 32ms)
//   in_game:                  137ms, 175ms, 150ms (min 137ms)
//   game_window_is_front:     58ms, 64ms, 89ms  (min 58ms)
//   player_dead:              3960ms, 4232ms, 3901ms (min 3901ms)
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike", "LEVEL": "11", "LEVEL_KEY_1": "1", "LEVEL_KEY_2": "1", "GAME_NUM": "1"},
            "d2": {"MISSION": "Counterstrike", "LEVEL": "24", "LEVEL_KEY_1": "2", "LEVEL_KEY_2": "4", "GAME_NUM": "2"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // -- Launcher preamble --
    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "tap_button", "text": "Descent ${GAME_NUM}", "post_delay_ms": 0},
    {"action": "tap_button", "text": "Launch Descent ${GAME_NUM}", "launches_game": true},

    {"action": "log", "message": "=== TEST: Death (Insane) ==="},

    // Accept default pilot name (fresh .plr deleted by runner)
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5100},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    // Mission select (D2 only -- D1 has a single built-in mission)
    {"action": "select", "text": "${MISSION}", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},

    // Level number input (parameterized keys)
    {"action": "wait_ms", "ms": 300},
    {"action": "key", "key": "backspace", "post_delay_ms": 100},
    {"action": "key", "key": "${LEVEL_KEY_1}", "post_delay_ms": 100},
    {"action": "key", "key": "${LEVEL_KEY_2}", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},

    // Insane difficulty (wait for menu transition from level dialog)
    {"action": "select", "text": "Insane", "post_delay_ms": 100, "timeout_ms": 10000},

    // Skip briefing (waits for level load, then escapes if briefing is showing)
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 100},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "current_level_num": "${LEVEL}"}},
    {"action": "introspect"},

    // Drive the normal damage/death path explicitly. Relying only on enemy
    // placement made D2 level 24 flaky on slower/fresh emulator runs.
    {"action": "set_debug", "field": "damage_player", "value": "250", "post_delay_ms": 100},

    // Wait for death animation state
    {"action": "wait_for", "field": "player_dead", "value": "true", "timeout_ms": 60000},
    {"action": "assert", "expect": {"player_dead": "true"}},
    {"action": "introspect"},

    {"action": "log", "message": "=== TEST: Death (Insane) -- COMPLETE ==="}
]
