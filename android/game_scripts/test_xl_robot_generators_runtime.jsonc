[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_robot_generators_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
        "post_delay_ms": 500,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived generator mapping",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "face_view",
        "segment": 3,
        "side": 0,
        "distance": 5,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.implicit_robot_flags": 0,
            "xl_pilot.robot_generators.0.flags0": 1,
            "xl_pilot.robot_generators.1.flags0": 2,
            "xl_pilot.robot_generators.2.flags0": 4,
            "xl_pilot.robot_generators.0.enabled": false,
        },
    },
    {
        "action": "set_debug",
        "field": "fire_trigger",
        "value": "0",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.robot_generators.0.enabled": true,
            "xl_pilot.robot_generators.1.enabled": true,
            "xl_pilot.robot_generators.2.enabled": true,
            "xl_pilot.robot_generators.0.lives": 2,
            "xl_pilot.robot_generators.0.pending": false,
            "xl_pilot.robot_generators.0.capacity": 327680,
        },
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.robot_generators.0.pending": true,
            "xl_pilot.robot_generators.1.pending": true,
            "xl_pilot.robot_generators.2.pending": true,
        },
        "timeout_ms": 10000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.robot_generators.0.pending": true,
            "xl_pilot.robot_generators.1.pending": true,
            "xl_pilot.robot_generators.2.pending": true,
            "xl_pilot.robot_generators.0.capacity": 327680,
            "xl_pilot.robot_generators.0.alive": 0,
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_save",
    },
    {
        "action": "wait_ms",
        "ms": 1000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.robot_generators.0.alive": 1,
            "xl_pilot.robot_generators.1.alive": 1,
            "xl_pilot.robot_generators.2.alive": 1,
        },
        "timeout_ms": 10000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.robot_generators.0.robots[0].id": 0,
            "xl_pilot.robot_generators.1.robots[0].id": 1,
            "xl_pilot.robot_generators.2.robots[0].id": 2,
            "xl_pilot.robot_generators.0.capacity": 262144,
            "xl_pilot.robot_generators.0.pending": false,
        },
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.robot_generators.0.alive": 1,
            "xl_pilot.robot_generators.1.alive": 1,
            "xl_pilot.robot_generators.2.alive": 1,
            "xl_pilot.robot_generators.0.capacity": 262144,
        },
    },
    {
        "action": "set_debug",
        "field": "matcen_robot_damage",
        "value": "1 10000",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.robot_generators.1.alive": 0,
        },
        "timeout_ms": 10000,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_load",
    },
    {
        "action": "wait_ms",
        "ms": 50,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.robot_generators.0.pending": true,
            "xl_pilot.robot_generators.1.pending": true,
            "xl_pilot.robot_generators.2.pending": true,
            "xl_pilot.robot_generators.0.alive": 0,
            "xl_pilot.robot_generators.0.capacity": 327680,
            "time_paused": false,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 5000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "false",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "Counterstrike",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": false,
            "xl_pilot.runtime_active": false,
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_load",
    },
    {
        "action": "wait_ms",
        "ms": 50,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.robot_generators.0.pending": true,
            "xl_pilot.robot_generators.1.pending": true,
            "xl_pilot.robot_generators.2.pending": true,
            "xl_pilot.robot_generators.0.lives": 2,
            "xl_pilot.robot_generators.0.capacity": 327680,
            "time_paused": false,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "assert",
        "expect": { "player.shields": { "range": [100, 100] } },
    },
    {
        "action": "set_debug",
        "field": "matcen_player_contact",
        "value": "0",
    },
    {
        "action": "assert",
        "expect": {
            "player.shields": { "range": [96, 96] },
            "position.speed": { "gt": 0.5 },
            "xl_pilot.robot_generators.0.pending": true,
        },
    },
]
