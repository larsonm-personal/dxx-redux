// Adding the original D2 demo changes the same Descent 2 button's content target
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_demo_import" } },
    { "action": "enter_launcher" },
    { "action": "assert", "expect": { "active_set": "default", "d1.ready": true, "d2.ready": true } },
    { "action": "tap_button", "text": "Launch Descent 2", "exact": true, "launches_game": true },
    { "action": "skip_intro", "timeout_ms": 30000, "post_delay_ms": 200 },
    { "action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000 },
    // Reuse the pilot created by the preceding D2-engine launch through its normal pilot list
    { "action": "key", "key": "enter", "post_delay_ms": 100 },
    { "action": "select", "text": "New game", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select_mission", "text": "Descent 2 Demo", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select", "text": "Rookie", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "skip_briefing", "timeout_ms": 30000, "post_delay_ms": 100 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000 },
    { "action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000 },
    {
        "action": "assert",
        "expect": {
            "in_game": true, "screen_mode": "game", "current_level_num": 1, "player_dead": false,
            "asset_trace.runtime_engine": "d2", "asset_trace.selected_base_game": "d2", "asset_trace.mode": "d2",
            // The trace records the palette-request name; pinned file hashes prove the demo fallback asset
            "asset_trace.current_level_palette": "GROUPA.256",
            "asset_trace.current_pigfile": "groupa.pig",
        },
    },
    { "action": "introspect" },
    { "action": "log", "message": "PASS: real Descent 2 button reached public D2 demo level 1 after adding D2 content" },
    { "action": "enter_launcher" },
    { "action": "wait_for", "field": "game_running", "value": "false", "timeout_ms": 30000 },
    { "action": "assert", "expect": { "d1.ready": true, "d2.ready": true } },
]
