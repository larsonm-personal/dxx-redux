        "coop_briefing.can_launch": true, "time_paused": true
    }},
    {"action": "set_debug", "field": "coop_briefing_action", "value": "launch"},
    {"action": "wait_for", "timeout_ms": 15000, "expect": {
        "coop_briefing.active": false, "coop_briefing.phase": 0,
        "coop_briefing.launch_reason": 2, "in_game": true, "time_paused": false,
        "multiplayer.num_connected": 2
    }}
