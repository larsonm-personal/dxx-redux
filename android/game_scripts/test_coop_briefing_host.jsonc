[
    {"_info": {"games": ["d1", "d2"], "_standalone": false, "_owner": "test_lan"}},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {
        "coop_briefing.active": true, "coop_briefing.phase": 6,
        "coop_briefing.presenting": true, "time_paused": true,
        "coop_briefing.participants": 3, "coop_briefing.seconds_remaining": {"range": [30, 120]}
    }},
    {"action": "set_debug", "field": "coop_briefing_action", "value": "reject_launch"},
    {"action": "set_debug", "field": "coop_briefing_action", "value": "skip"},
    {"action": "wait_for", "timeout_ms": 5000, "expect": {
        "coop_briefing.can_launch": true, "coop_briefing.presenting": false,
        "coop_briefing.local_state": 4, "coop_briefing.seconds_remaining": {"range": [1, 20]}
    }},
    {"action": "set_debug", "field": "coop_briefing_action", "value": "reject_stale_launch"},
    {"action": "key", "key": "enter"},
    {"action": "wait_ms", "ms": 3000},
    {"action": "assert", "expect": {
