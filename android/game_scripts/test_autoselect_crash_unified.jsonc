// TEST: Autoselect crash reproduction (unified launcher + game)
//
// Reproduces crash: launcher-based autoselect ordering save followed by
// opening nested menus in game.
//
// Phase 1: (Game) Create pilot, reach main menu, then exit
// Phase 2: (Launcher) Patch .plr via write_autoselect (same as launcher save)
// Phase 3: (Game) Relaunch, select existing pilot, navigate nested menus
//
// Run via: android/helpers/run_test.ps1 test_autoselect_crash_unified.jsonc
[
    {"_info": {
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // ── Phase 1: Create pilot ───────────────────────────────────

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 1: Create pilot ==="},

    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},

    {"action": "enter_game", "game": "d2"},

    // Accept default pilot name
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},

    // At main menu -- pilot is saved. Exit back to launcher
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "log", "message": "Pilot created, returning to launcher"},

    // ── Phase 2: Patch .plr via JNI autoselect save ─────────────

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== Phase 2: Patch .plr via write_autoselect ==="},

    // Swap primary weapon order: 8,9,... instead of default 9,8,...
    {"action": "setup_command", "command": "write_autoselect",
     "args": {
         "game": "d2",
         "primary": "8,9,7,6,5,4,3,2,1,0,255",
         "secondary": "9,8,4,3,1,5,0,255,7,6,2"
     }, "post_delay_ms": 1000},

    {"action": "log", "message": "Pilot patched, launching game"},

    // ── Phase 3: Navigate nested menus (crash test) ─────────────

    {"action": "enter_game", "game": "d2"},

    {"action": "log", "message": "=== Phase 3: Navigate menus with patched pilot ==="},

    // Select existing pilot from listbox
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "player", "post_delay_ms": 100, "timeout_ms": 5000},

    // --- Path 1: Options -> Secondary autoselect ordering ---
    {"action": "log", "message": "Path 1: Options -> Secondary ordering"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Secondary autoselect ordering...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    // --- Path 2: Options -> Primary autoselect ordering ---
    {"action": "log", "message": "Path 2: Options -> Primary ordering"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Primary autoselect ordering...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "assert", "expect": {
        "menu.title": "Reorder Primary",
        "menu.selected_index": "0",
        "menu.items[0].value": "8",
        "menu.items[1].value": "9"
    }},
    {"action": "send_button", "button": 0, "held": 1},
    {"action": "wait_ms", "ms": 700},
    {"action": "send_button", "button": 23, "post_delay_ms": 100},
    {"action": "assert", "expect": {
        "menu.title": "Reorder Primary",
        "menu.selected_index": "1",
        "menu.items[0].value": "9",
        "menu.items[1].value": "8"
    }},
    {"action": "send_button", "button": 0, "pressed": 0},
    {"action": "send_button", "button": 22, "post_delay_ms": 100},
    {"action": "assert", "expect": {
        "menu.title": "Reorder Primary",
        "menu.selected_index": "0",
        "menu.items[0].value": "8",
        "menu.items[1].value": "9"
    }},
    {"action": "send_button", "button": 1, "post_delay_ms": 100},
    {"action": "send_button", "button": 23, "post_delay_ms": 100},
    {"action": "assert", "expect": {
        "menu.title": "Reorder Primary",
        "menu.selected_index": "1",
        "menu.items[0].value": "8",
        "menu.items[1].value": "9"
    }},
    {"action": "send_button", "button": 0, "post_delay_ms": 50},
    {"action": "assert", "expect": {
        "menu.title": "Reorder Primary",
        "menu.selected_index": "1",
        "menu.items[0].value": "8",
        "menu.items[1].value": "9"
    }},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    // --- Path 3: Options -> Secondary -> escape quickly ---
    {"action": "log", "message": "Path 3: Options -> Secondary -> fast escape"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Secondary autoselect ordering...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    // --- Path 4: Options -> Primary -> escape quickly ---
    {"action": "log", "message": "Path 4: Options -> Primary -> fast escape"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Primary autoselect ordering...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    // --- Path 5: Options -> Misc Options -> escape ---
    {"action": "log", "message": "Path 5: Options -> Misc Options -> escape"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Misc Options...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    // --- Path 6: Back to secondary ordering, slower ---
    {"action": "log", "message": "Path 6: Secondary ordering again"},
    {"action": "select", "text": "Options", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Secondary autoselect ordering...", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "introspect"},

    {"action": "log", "message": "=== All menu paths survived -- test complete ==="}
]
