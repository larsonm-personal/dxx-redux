// TEST: Fire Primary via brief button press
// Verifies that a short button press (simulating double-tap timing) actually
// fires the primary weapon. Uses send_button with 50ms hold (matching the
// DOUBLE_TAP_RELEASE_DELAY_MS in the Kotlin overlay).
//
// The test fires primary 4 times with 50ms hold each and checks energy drops.
// Button 100 = BTN_FIRE_PRIMARY (0) + MIXER_BTN_BASE (100).
// Level 1 laser costs ~1 energy per shot, so 4 shots should reduce energy
// from 100 to ~96.
[
    {"_info": {
        "games": ["d2"],
        "vars": {
            "d2": {"MISSION": "Counterstrike"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"}
        ]
    }},
    {"action": "log", "message": "=== TEST: Fire Primary (brief press) ==="},


    // Accept default pilot name
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    // Mission select
    {"action": "select", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    // accept default level 1
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},

    // Trainee difficulty (easiest, least enemy interference)
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 5000},

    // Skip briefing
    {"action": "skip_briefing", "timeout_ms": 20000, "post_delay_ms": 100},

    // Wait for game to be running
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},

    // Verify starting energy is near 100
    {"action": "introspect"},
    {"action": "assert", "expect": {"player.energy": {"gte": 100}}, "_comment": "Should start at exactly 100"},
    {"action": "log", "message": "Initial energy >= 100 confirmed"},

    // Fire primary with 50ms hold (matching double-tap timing)
    // Button 100 = BTN_FIRE_PRIMARY + MIXER_BTN_BASE
    // Each shot costs ~0.25 energy at Trainee difficulty
    // Fire_wait for laser is ~500ms, so use 800ms gaps between presses
    {"action": "send_button", "button": 100, "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 800},
    {"action": "send_button", "button": 100, "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 800},
    {"action": "send_button", "button": 100, "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 800},
    {"action": "send_button", "button": 100, "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 800},

    // 4 shots at ~0.25 each = ~1.0 energy consumed → expect energy ~99.0
    {"action": "introspect"},
    {"action": "assert", "expect": {"player.energy": {"lt": 100}}, "_comment": "4 brief presses should consume measurable energy"},

    {"action": "log", "message": "=== TEST: Fire Primary (brief press) -- PASS ==="}
]
