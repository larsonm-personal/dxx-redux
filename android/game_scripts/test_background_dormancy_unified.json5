// TEST: Android dormant-state diagnostics baseline
// Exercises the main menu, active single-player, the dedicated pause window,
// and the game menu without changing the current background behavior.
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"GAME": "d1", "MISSION": "First Strike"},
            "d2": {"GAME": "d2", "MISSION": "Counterstrike"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_dormancy_enabled", "value": true}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},

    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},

    {"action": "introspect"},
    {"action": "assert", "expect": {
        "android_lifecycle.workload": "static_ui",
        "android_lifecycle.suspend_state": "running",
        "android_lifecycle.work_counters.event_loop_iterations": {"gt": 0},
        "android_lifecycle.work_counters.draw_dispatches": {"gt": 0},
        "android_lifecycle.work_counters.swap_presented": {"gt": 0}
    }},
    {"action": "log", "message": "SCRIPT_BACKGROUND: main-menu duration_s=5 lock_screen=true"},
    {"action": "wait_for", "field": "egl_recreate_count", "value": "1", "timeout_ms": 30000},
    {"action": "assert", "expect": {
        "android_lifecycle.requested_visibility": "foreground",
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.checkpoint_state": "skipped",
		"android_lifecycle.park_entry_count": {"gte": 1},
		"android_lifecycle.wake_count": {"gte": 1},
		"android_lifecycle.parked_duration_ms": {"gte": 4000},
        "android_lifecycle.request_generation": {"gte": 2},
        "android_lifecycle.acknowledgement_generation": {"gte": 2}
    }},

    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "introspect"},
    {"action": "assert", "expect": {"android_lifecycle.workload": "single_player_active"}},

    {"action": "log", "message": "SCRIPT_BACKGROUND: active-game duration_s=5"},
    {"action": "wait_for", "field": "egl_recreate_count", "value": "2", "timeout_ms": 30000},
    {"action": "assert", "expect": {
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
		"android_lifecycle.suspend_state": "running",
		"android_lifecycle.park_entry_count": {"gte": 2},
		"android_lifecycle.wake_count": {"gte": 2}
    }},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "set_debug", "field": "android_game_request", "value": "pause", "post_delay_ms": 300},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "assert", "expect": {"android_lifecycle.workload": "single_player_paused"}},
    {"action": "log", "message": "SCRIPT_BACKGROUND: pause-window duration_s=5"},
    {"action": "wait_for", "field": "egl_recreate_count", "value": "3", "timeout_ms": 30000},
    {"action": "assert", "expect": {
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
		"android_lifecycle.suspend_state": "running",
		"android_lifecycle.park_entry_count": {"gte": 3},
		"android_lifecycle.wake_count": {"gte": 3}
    }},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "set_debug", "field": "android_game_request", "value": "game_menu", "post_delay_ms": 300},
    {"action": "wait_for", "field": "menu_subtitle", "value": "Game Menu", "timeout_ms": 5000},
    {"action": "assert", "expect": {"android_lifecycle.workload": "single_player_paused"}},
    {"action": "log", "message": "SCRIPT_BACKGROUND: game-menu duration_s=5"},
    {"action": "wait_for", "field": "egl_recreate_count", "value": "4", "timeout_ms": 30000},
    {"action": "assert", "expect": {
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
		"android_lifecycle.park_entry_count": {"gte": 4},
		"android_lifecycle.wake_count": {"gte": 4},
		"android_lifecycle.last_wake_reason": "foreground",
        "android_lifecycle.context_generation": {"gte": 1},
        "android_lifecycle.window_generation": {"gte": 1},
        "android_lifecycle.work_counters.audio_callbacks": {"gt": 0},
        "android_lifecycle.work_counters.central_overlay_polls": {"gt": 0}
    }},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "log", "message": "=== TEST: Android dormant-state diagnostics baseline -- COMPLETE ==="},
    {"action": "introspect"}
]
