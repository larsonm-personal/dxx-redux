// Explicit private-fixture startup and save/restore test, not full mission qualification
// Requires -PxlPilot=true, original d2-xl.mn2/HOG in d2x-redux/missions,
// retail D2 data and an existing player pilot; run with -PreserveState
[
    { "_info": { "games": ["d2"], "vars": { "d2": { "PILOT": "player" } } } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000, "post_delay_ms": 500 },
    { "action": "select", "text": "${PILOT}", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "select", "text": "New game", "timeout_ms": 15000, "post_delay_ms": 200 },
    { "action": "select_mission", "text": "XL: D2-XL: Counterstrike!", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    { "action": "wait_ms", "ms": 1000 },
    {
        "action": "assert",
        "expect": {
            "current_level_num": 1,
            "current_level_name": "Ahayweh Gate",
            "player.robots_level": 38,
            "player.invulnerable": false,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
        },
    },
    // Controlled difficulty change proves a restore occurred; this is not progression evidence
    { "action": "assert", "expect": { "difficulty": 2 } },
    { "action": "set_debug", "field": "xl_pilot_persistence", "value": "prepare" },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 1000 },
    { "action": "set_debug", "field": "xl_pilot_persistence", "value": "disturb" },
    { "action": "set_debug", "field": "android_game_request", "value": "difficulty:3", "post_delay_ms": 200 },
    { "action": "assert", "expect": { "difficulty": 3 } },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "game_window_is_front": true,
            "time_paused": false,
            "current_level_name": "Ahayweh Gate",
            "current_level_num": 1,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
            "player.robots_level": 38,
            "player.invulnerable": false,
        },
    },
    { "action": "set_debug", "field": "xl_pilot_persistence", "value": "verify" },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": true, "xl_pilot.menu_indicator_draws": { "gt": 0 } } },
    { "action": "select", "text": "Abort Game", "timeout_ms": 5000 },
    { "action": "wait_for", "field": "in_game", "value": "false", "timeout_ms": 10000 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": false } },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "Counterstrike", "timeout_ms": 10000 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000 },
    { "action": "select", "text": "Trainee", "timeout_ms": 10000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    {
        "action": "assert",
        "expect": {
            "difficulty": 0,
            "xl_pilot.runtime_active": false,
            "current_level_num": 1,
            "xl_pilot.active": false,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": 0,
            "xl_pilot.activated_triggers": 0,
            "xl_pilot.unresolved_emitters": 0,
        },
    },
    // The quick slot belongs to the saved pilot, even after switching missions
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "current_level_name": "Ahayweh Gate",
            "current_level_num": 1,
            "game_window_is_front": true,
            "time_paused": false,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
            "player.robots_level": 38,
            "player.invulnerable": false,
        },
    },
    { "action": "set_debug", "field": "xl_pilot_persistence", "value": "verify" },
    { "action": "introspect" },
]
