    },
    {
        "action": "enter_launcher"
    },
    {
        "action": "reset_state"
    },
    {
        "action": "setup_command",
        "command": "clear_save_files",
        "post_delay_ms": 250
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false
        },
        "post_delay_ms": 250
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false
        },
        "post_delay_ms": 250
    },
    {
        "action": "enter_game",
        "game": "${GAME}"
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 100,
        "timeout_ms": 5000
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "post_delay_ms": 100,
        "timeout_ms": 5000
    },
    {
        "action": "wait_ms",
        "ms": 300
    },
    {
        "action": "key",
        "key": "backspace",
        "post_delay_ms": 100
    },
    {
        "action": "key",
        "key": "${LEVEL_KEY_1}",
        "post_delay_ms": 100
    },
    {
        "action": "key",
        "key": "${LEVEL_KEY_2}",
        "post_delay_ms": 100
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 100,
        "timeout_ms": 10000
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 10000,
        "post_delay_ms": 100
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 10000
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 5000
    },
    {
        "action": "trigger_levelcomplete"
    },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "time_paused": true,
            "screen_advance_kind": "movie"
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "movie.current": "end.mve",
            "movie.frame": {
                "gte": 1
            },
            "screen_advance_can_activate": true
        },
        "post_delay_ms": 300
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "screen_advance_can_activate": true,
            "levelcomplete_active": true
        }
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "select",
        "text": "OK",
        "optional": true,
        "timeout_ms": 1500,
        "post_delay_ms": 100
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "in_game": false,
            "coop_endgame.active": false
        }
    },
    {
        "action": "introspect"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.items[0].text": "New game",
            "in_game": false,
            "coop_endgame.active": false
        }
    }
]
