[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_wall_strip_runtime",
            "games": ["d2"],
            "vars": { "d2": { "STRIP_MISSION": "XL: Derived XL strip doors", "STRIP_PREPARE": "strip_prepare" } },
            "params": {
                "STRIP_KIND": {
                    "label": "Derived wall lifecycle",
                    "options": {
                        "single": {
                            "STRIP_MISSION": "XL: Derived XL single strip",
                            "STRIP_PREPARE": "strip_prepare_single",
                        },
                        "door": { "STRIP_MISSION": "XL: Derived XL strip doors" },
                        "blastable": { "STRIP_MISSION": "XL: Derived XL blast strips" },
                        "exploding": { "STRIP_MISSION": "XL: Derived XL explode strips" },
                    },
                },
            },
        },
    },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "${STRIP_MISSION}", "timeout_ms": 15000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    {
        "action": "wait_for",
        "expect": { "in_game": true, "xl_pilot.runtime_active": true },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    { "action": "set_debug", "field": "robots_suspended", "value": "true", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 0 },
    {
        "action": "wait_for",
        "expect": { "time_paused": true, "pause.reasons": 1 },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    { "action": "set_debug", "field": "xl_door_probe", "value": "${STRIP_PREPARE}", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "wall_strip", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_door_probe", "value": "strip_disk_save", "post_delay_ms": 0 },
    { "action": "wait_ms", "ms": 300 },
    { "action": "set_debug", "field": "xl_door_probe", "value": "strip_disturb", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "resume", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 20000, "post_delay_ms": 0 },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "select", "text": "Abort Game", "timeout_ms": 15000 },
    { "action": "wait_for", "expect": { "in_game": false }, "timeout_ms": 20000, "post_delay_ms": 0 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "Counterstrike", "timeout_ms": 15000 },
    { "action": "select", "text": "Ok", "timeout_ms": 15000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    {
        "action": "wait_for",
        "expect": { "in_game": true, "xl_pilot.runtime_active": false },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    { "action": "set_debug", "field": "robots_suspended", "value": "true", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 0 },
    {
        "action": "wait_for",
        "expect": { "time_paused": true, "pause.reasons": 1 },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    { "action": "set_debug", "field": "xl_door_probe", "value": "stock", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_door_probe", "value": "strip_disk_load", "post_delay_ms": 0 },
    {
        "action": "wait_for",
        "expect": { "in_game": true, "xl_pilot.runtime_active": true, "time_paused": true, "pause.reasons": 1 },
        "timeout_ms": 20000,
        "post_delay_ms": 0,
    },
    { "action": "set_debug", "field": "xl_door_probe", "value": "strip_verify", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "wall_strip", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_door_probe", "value": "strip_verify", "post_delay_ms": 0 },
]
