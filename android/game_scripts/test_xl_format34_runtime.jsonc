// Derived 15/34 layout with unqualified HXM omitted; saved states rearm the authored one-shot light-on action
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_format34_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
