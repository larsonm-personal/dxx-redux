// Check the live catalog and its confirmation without downloading an asset
[
    {"_info": {"games": ["d1", "d2"]}},
    {"action": "enter_launcher"},
    {"action": "tap_button", "text": "Game Preferences", "post_delay_ms": 500},
    {"action": "assert_button", "text": "Download soundfonts", "enabled": true, "timeout_ms": 10000},
    {"action": "assert_button", "text": "Import SF2 soundfont", "enabled": true, "timeout_ms": 10000},
    {"action": "assert_button", "text": "nitro-shoe SC-55-style 1.34 (bundled)", "enabled": true},
    {"action": "tap_button", "text": "Manage soundfonts"},
    {"action": "tap_button", "text": "Included with app - Info"},
    {"action": "assert_button", "text": "https://github.com/nitro-shoe/sc-55-soundfont", "enabled": true},
    {"action": "tap_button", "text": "Close", "exact": true},
    {"action": "assert_button", "text": "nitro-shoe SC-55-style 1.34 (bundled)", "enabled": true},
    {"action": "tap_button", "text": "Close", "exact": true},
    {"action": "tap_button", "text": "Download soundfonts"},
    {"action": "tap_button", "text": "Included with app - Info"},
    {"action": "assert_button", "text": "https://github.com/nitro-shoe/sc-55-soundfont", "enabled": true},
    {"action": "tap_button", "text": "Close", "exact": true},
    {"action": "tap_button", "text": "GeneralUser GS 2.0.3"},
    {"action": "assert_button", "text": "https://github.com/mrbumpy409/GeneralUser-GS", "enabled": true},
    {"action": "tap_button", "text": "Cancel", "exact": true},
    {"action": "tap_button", "text": "Download soundfonts"},
    {"action": "tap_button", "text": "TimGM6mb"},
    {"action": "assert_button", "text": "https://github.com/arbruijn/TimGM6mb", "enabled": true},
    {"action": "tap_button", "text": "Cancel", "exact": true},
    {"action": "assert", "expect": {"soundfont.selected": "", "soundfont.renderer": "ymfm"}},
    {"action": "tap_button", "text": "< Back", "post_delay_ms": 250},
    {"action": "log", "message": "Soundfont download catalog checks passed"}
]
