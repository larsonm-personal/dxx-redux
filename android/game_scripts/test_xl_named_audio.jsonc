// Actual named audio output, event dispatch, disk/rewind and stock isolation
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_named_audio",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL sounds",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
