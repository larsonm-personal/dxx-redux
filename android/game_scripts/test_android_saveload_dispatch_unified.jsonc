// TEST: Shared Android save/load and game-request dispatch for D1 and D2
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"GAME": "d1", "MISSION": "First Strike", "GAME_NUM": "1"},
            "d2": {"GAME": "d2", "MISSION": "Counterstrike", "GAME_NUM": "2"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== TEST: Shared Android save/load dispatch ==="},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},

    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "difficulty": "1",
        "current_level_num": "1"
    }},

    {"action": "set_debug", "field": "android_game_request", "value": "auto_minimize", "post_delay_ms": 1000},
    {"action": "assert", "expect": {"in_game": "true", "game_window_is_front": "true"}},
    {"action": "set_debug", "field": "android_game_request", "value": "difficulty:2", "post_delay_ms": 300},
    {"action": "wait_for", "field": "difficulty", "value": "2", "timeout_ms": 5000},
    {"action": "assert", "expect": {"difficulty_changed": "true"}},

    {"action": "set_debug", "field": "android_game_request", "value": "pause", "post_delay_ms": 300},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "game", "timeout_ms": 5000},

    {"action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 300},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "time_paused": "true"}},
    {"action": "set_debug", "field": "android_game_request", "value": "save", "post_delay_ms": 300},
    {"action": "wait_for", "field": "menu_subtitle", "value": "Save Game", "timeout_ms": 5000},
    {"action": "key", "key": "enter", "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "game", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "game_window_is_front": "true", "time_paused": "false"}},

    {"action": "set_debug", "field": "android_game_request", "value": "load", "post_delay_ms": 300},
    {"action": "wait_for", "field": "menu_subtitle", "value": "Select Game to Restore", "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "game", "timeout_ms": 5000},

    {"action": "set_debug", "field": "android_game_request", "value": "game_menu", "post_delay_ms": 300},
    {"action": "wait_for", "field": "menu_subtitle", "value": "Game Menu", "timeout_ms": 5000},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "game", "timeout_ms": 5000},
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "difficulty": "2",
        "difficulty_changed": "true",
        "current_level_num": "1"
    }},
    {"action": "log", "message": "=== TEST: Shared Android save/load dispatch -- COMPLETE ==="},
    {"action": "introspect"},

    // Keep the direct restore at the end: rebuilding the game window during a restore
    // invalidates some automation-only window introspection until the next frame loop.
    {"action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 1000},
    {"action": "set_debug", "field": "android_game_request", "value": "difficulty:3", "post_delay_ms": 300},
    {"action": "wait_for", "field": "difficulty", "value": "3", "timeout_ms": 5000},
    {"action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000},
    {"action": "wait_for", "field": "difficulty", "value": "2", "timeout_ms": 10000}
]
