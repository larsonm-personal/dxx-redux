    {
        "action": "assert",
        "expect": {
            "menu.subtitle": "Screen Resolution",
            "graphics_safety.phase": "idle",
            "msaa.last_scene_gl_error": "0",
        },
    },
    {
        "action": "set_debug",
        "field": "graphics_option",
        "value": "tex_filt:2",
