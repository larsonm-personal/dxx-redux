                },
            ],
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "write_config",
        "file": "graphics_safety.json",
        "content": "{\n  \"accepted\": {\n    \"TexFilt\": 1,\n    \"AnisoLevel\": 0,\n    \"MsaaLevel\": 0,\n    \"MenuTexFilt\": 0,\n    \"HudTexFilt\": 0,\n    \"ResolutionX\": 640,\n    \"ResolutionY\": 480,\n    \"AspectX\": 3,\n    \"AspectY\": 4,\n    \"ColorDepth\": 0\n  },\n  \"attempt\": null,\n  \"pending\": {}\n}\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "action": "write_config",
        "file": "descent.cfg",
        "content": "TexFilt=1\nAnisoLevel=0\nMsaaLevel=0\nMenuTexFilt=0\nHudTexFilt=0\nResolutionX=800\nResolutionY=600\nAspectX=3\nAspectY=4\nColorDepth=1\n",
    },
    {
        "action": "write_config",
        "file": "d1x-redux/descent.cfg",
        "content": "TexFilt=1\nAnisoLevel=0\nMsaaLevel=0\nMenuTexFilt=0\nHudTexFilt=0\nResolutionX=800\nResolutionY=600\nAspectX=3\nAspectY=4\nColorDepth=1\n",
    },
    {
        "action": "write_config",
        "file": "d2x-redux/descent.cfg",
        "content": "TexFilt=1\nAnisoLevel=0\nMsaaLevel=0\nMenuTexFilt=0\nHudTexFilt=0\nResolutionX=800\nResolutionY=600\nAspectX=3\nAspectY=4\nColorDepth=1\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "dlog_graphics_enabled",
            "value": true,
        },
    },
    {
        "action": "enter_game",
        "game": "d1",
        "when": "d1",
    },
    {
        "action": "enter_game",
        "game": "d2",
        "when": "d2",
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 5000,
    },
    {
        "action": "assert",
        "expect": {
            "graphics_safety.phase": "idle",
            "msaa.last_scene_gl_error": "0",
            "resolution.render_width": "800",
            "resolution.render_height": "600",
        },
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 100,
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "skip_briefing",
        "when": "d2",
        "timeout_ms": 10000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "wait_for",
        "expect": {
            "graphics_safety.phase": "challenge",
            "graphics_safety.candidate.ResolutionX": "800",
            "graphics_safety.candidate.ColorDepth": "1",
        },
        "when": "d1",
        "timeout_ms": 10000,
    },
    {
        "action": "controller_input",
        "key": "B",
        "pressed": true,
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "controller_input",
        "key": "B",
        "pressed": false,
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "expect": {
            "graphics_safety.phase": "idle",
            "msaa.last_scene_gl_error": "0",
            "resolution.render_width": "640",
            "resolution.render_height": "480",
            "graphics_safety.current.ColorDepth": "0",
            "time_paused": "false",
        },
        "timeout_ms": 20000,
    },
    {
        // A slow first scene can block native automation for the whole challenge
        // Retained UI evidence proves the independent Android popup was actually drawn
        "action": "controller_input",
        "expect_ui": {
            "graphics_open": false,
            "graphics_first_draw_cancel_text": "Cancel (5)",
        },
    },
    {
        "action": "set_debug",
        "field": "msaa_color_probe",
        "value": "2",
    },
    {
        "action": "probe_gles_vbo",
    },
    {
        "action": "assert",
        "expect": {
            "msaa_probe.passed": "true",
            "msaa_probe.state_restored": "true",
            "msaa.scene_error_count": "0",
            "msaa.last_scene_gl_error": "0",
        },
    },
    {
        "action": "key",
        "key": "f2",
        "post_delay_ms": 80,
    },
    {
        "action": "select",
        "text": "Screen resolution...",
        "timeout_ms": 5000,
        "post_delay_ms": 150,
