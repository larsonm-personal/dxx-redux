    {"action": "set_debug", "field": "automap_unvisit_segment", "value": "354"},
    {"action": "meta_action", "id": 1043},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {
        "guidebot.companion_count": 1, "guidebot.owner_player": 1, "guidebot.shields": "37.0",
        "guidebot.remote_owner": 1, "guidebot.local_control_slot_matches": true,
        "guidebot.route_target_mode_name": "unexplored", "guidebot.route_goal_active": true,
        "guidebot.unexplored_target_seg": 354, "guidebot.path_length": {"gt": 1}
    }},
    {"action": "introspect"}
