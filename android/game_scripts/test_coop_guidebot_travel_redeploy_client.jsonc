[
    {"_info": {"games": ["d2"], "_standalone": false, "_owner": "test_lan"}},
    {"action": "meta_action", "id": 1037},
    {"action": "wait_for", "timeout_ms": 20000, "expect": {"guidebot.released": true, "guidebot.docked": false}},
    // The inventory fixture resets keys on every leg. From the secret return
