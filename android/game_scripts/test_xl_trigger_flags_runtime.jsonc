[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_trigger_flags_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
        "post_delay_ms": 500,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL trigger flags",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "face_view",
        "segment": 24,
        "side": 5,
        "distance": 5,
        "post_delay_ms": 150,
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.wall_triggers.1.flags": 64,
            "xl_pilot.wall_triggers.4.flags": 98,
            "xl_pilot.trigger_audio.forcefield_off.attempts": 0,
            "xl_pilot.trigger_audio.illusion_off.attempts": 0,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "fire_trigger",
        "value": "0",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.trigger_audio.forcefields.0.hum_linked": 1,
            "xl_pilot.trigger_audio.forcefields.0.hum_playing": 1,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "fire_trigger",
        "value": "1",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.trigger_audio.forcefields.0.hum_linked": 0,
            "xl_pilot.trigger_audio.forcefield_off.suppressed_decisions": 1,
            "xl_pilot.trigger_audio.forcefield_off.attempts": 0,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "wait_ms",
        "ms": 850,
    },
    {
        "action": "set_debug",
        "field": "fire_trigger",
        "value": "0",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.trigger_audio.forcefields.0.hum_playing": 1,
        },
        "timeout_ms": 15000,
    },
    {
