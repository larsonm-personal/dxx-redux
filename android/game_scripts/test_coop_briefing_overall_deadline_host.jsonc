[
    {
        "_info": {
            "games": [
                "d1",
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "coop_briefing.active": true,
            "coop_briefing.phase": 6,
            "coop_briefing.presenting": true,
            "time_paused": true,
            "coop_briefing.seconds_remaining": {
                "range": [100, 120]
            }
        }
    },
    {
        "action": "wait_ms",
        "ms": 90000
    },
    {
        "action": "assert",
        "expect": {
            "coop_briefing.active": true,
            "coop_briefing.phase": 6,
            "coop_briefing.presenting": true,
            "time_paused": true,
            "coop_briefing.seconds_remaining": {
                "range": [5, 30]
            }
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 40000,
        "expect": {
            "coop_briefing.active": false,
            "coop_briefing.phase": 0,
            "coop_briefing.launch_reason": 3,
            "in_game": true,
            "time_paused": false,
            "multiplayer.num_connected": 2
        }
    }
]
