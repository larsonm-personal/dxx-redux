// Original Pumo level 2 particle ownership; the startup hub remains rejected
// Controlled authored trigger dispatch, no autonomous level navigation
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_start", "post_delay_ms": 0 },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    { "action": "wait_for", "expect": { "in_game": true, "xl_pilot.runtime_active": true }, "timeout_ms": 30000 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_capture", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_gpu", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_activate", "post_delay_ms": 0 },
    { "action": "face_view", "segment": 409, "side": 2, "distance": 8, "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "resume", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_live", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_scene", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "xl_pog.scene.completed": 1 }, "timeout_ms": 15000 },
    { "action": "introspect" },
    { "action": "assert", "expect": { "xl_pog.scene.passed": 1, "xl_pog.scene.changed": { "gte": 1 } } },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "checkpoint_cycle", "value": "capture", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "checkpoint_cycle", "value": "drain", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "checkpoints.pending": 0, "checkpoints.failed": 0 }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_disturb", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "checkpoint_cycle", "value": "roundtrip_paused", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_verify", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_gpu", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_disk_save", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_disturb", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_disk_load", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_gpu", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "resume", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_live", "post_delay_ms": 0 },
    { "action": "key", "key": "escape" },
    { "action": "wait_for", "expect": { "menu.subtitle": "Game Menu" }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "graphics_context_loss_once", "value": "1", "post_delay_ms": 0 },
    { "action": "log", "message": "SCRIPT_BACKGROUND: xl-pumo-particles-context duration_s=3" },
    {
        "action": "wait_for",
        "expect": {
            "egl_recreate_count": { "gte": 1 },
            "android_lifecycle.observed_visibility": "foreground",
            "android_lifecycle.suspend_state": "running",
        },
        "timeout_ms": 90000,
    },
    { "action": "introspect" },
    { "action": "wait_for", "expect": { "menu.subtitle": "Game Menu" }, "timeout_ms": 20000 },
    { "action": "key", "key": "escape", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_verify", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_gpu", "post_delay_ms": 0 },
    { "action": "face_view", "segment": 409, "side": 2, "distance": 8, "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_reactivate", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_scene", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "xl_pog.scene.completed": 1 }, "timeout_ms": 15000 },
    { "action": "assert", "expect": { "xl_pog.scene.passed": 1, "xl_pog.scene.changed": { "gte": 1 } } },
    { "action": "key", "key": "escape" },
    { "action": "select", "text": "Abort Game", "timeout_ms": 10000 },
    { "action": "wait_for", "expect": { "in_game": false }, "timeout_ms": 20000 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "Counterstrike", "timeout_ms": 15000 },
    { "action": "select", "text": "Ok", "timeout_ms": 15000 },
    { "action": "select", "text": "Trainee", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "expect": { "in_game": true, "xl_pilot.runtime_active": false }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_stock", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_disk_load", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_gpu", "post_delay_ms": 0 },
    {
        "action": "assert",
        "expect": { "xl_pog.passed": true, "xl_pog.particle_owners": 12, "xl_pog.authored_actions": { "gte": 1 } },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "resume", "post_delay_ms": 500 },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "wait_for", "expect": { "xl_pog.live_particles": { "gte": 1 } }, "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_live", "post_delay_ms": 0 },
    { "action": "face_view", "segment": 409, "side": 2, "distance": 8, "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_reactivate", "post_delay_ms": 0 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "original_scene", "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "xl_pog.scene.completed": 1 }, "timeout_ms": 15000 },
    { "action": "assert", "expect": { "xl_pog.scene.passed": 1, "xl_pog.scene.changed": { "gte": 1 } } },
    { "action": "introspect" },
]
