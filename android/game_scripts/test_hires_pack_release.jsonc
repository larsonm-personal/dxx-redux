                },
                {
                    "file": "descent2.s22",
                    "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "alien1.pig",
                    "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "alien2.pig",
                    "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "fire.pig",
                    "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "ice.pig",
                    "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "water.pig",
                    "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "descent.hog",
                    "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052",
                    "target": "files/imported/sets/hires-verification",
                },
                {
                    "file": "descent.pig",
                    "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe",
                    "target": "files/imported/sets/hires-verification",
                },
            ],
            "params": {
                "MODE": {
                    "options": {
                        "d1": {
                            "MISSION": "First Strike",
                        },
                        "d2": {
                            "MISSION": "Counterstrike",
                        },
                        "d1-in-d2": {
                            "MISSION": "First Strike",
                        },
                    },
                },
                "PACK": {
                    "default": "d2-hires-256-textures-ktx2.dxa",
                },
                "MOD_COMMAND": {
                    "default": "import_mod",
                },
                "EXPECTED_STATUS": {
                    "default": "active",
                },
                "SET": {
                    "default": "hires-verification",
                },
            },
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "setup_command",
        "command": "create_set",
        "args": {
            "name": "${SET}",
        },
    },
    {
        "action": "setup_command",
        "command": "switch_set",
        "args": {
            "name": "${SET}",
        },
        "post_delay_ms": 500,
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "dlog_game logs_enabled",
            "value": true,
        },
    },
    {
        "action": "setup_command",
        "command": "${MOD_COMMAND}",
        "args": {
            "path": "hires-import/${PACK}",
            "filename": "${PACK}",
        },
        "post_delay_ms": 1000,
    },
    {
        "action": "setup_command",
        "command": "${MOD_COMMAND}",
        "args": {
            "path": "hires-import/d1xr-hires.dxa",
            "filename": "d1xr-hires.dxa",
        },
        "post_delay_ms": 500,
    },
    {
        "action": "enter_game",
        "game": "${MODE}",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "key",
        "key": "enter",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 5000,
        "optional": true,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 30000,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "assert",
        "expect": {
            "in_game": "true",
            "current_level_num": "1",
        },
    },
    {
        "action": "introspect",
        "post_delay_ms": 1500,
    },
    {
        "action": "wait_for",
        "expect": {
            "texture_packs.status": "${EXPECTED_STATUS}",
        },
        "timeout_ms": 15000,
    },
    {
        "action": "introspect",
        "post_delay_ms": 1000,
    },
    {
        "action": "controller_input",
        "bindings": { "START": "Menu", "A": "Menu" },
        "open_admin": true,
        "expect_ui": { "admin_tray_open": true, "admin_index": 0 },
        "post_delay_ms": 100,
    },
    { "action": "controller_input", "key": "DDOWN", "post_delay_ms": 50 },
    { "action": "controller_input", "key": "DDOWN", "post_delay_ms": 50 },
    { "action": "controller_input", "key": "DRIGHT", "when": "d2", "post_delay_ms": 50 },
    { "action": "controller_input", "key": "DRIGHT", "when": "d2", "post_delay_ms": 50 },
    { "action": "controller_input", "expect_ui": { "admin_label": "Video Info" } },
    { "action": "controller_input", "key": "A", "post_delay_ms": 1500 },
    {
        "action": "controller_input",
        "expect_ui": {
            "video_open": true,
            "video_polling": true,
            "video_texture_status": "${EXPECTED_STATUS}",
        },
    },
]
