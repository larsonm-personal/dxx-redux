            "games": ["d1", "d2"],
            "vars": {
                "d1": {
                    "GAME": "d1",
                    "MISSION": "First Strike",
                },
                "d2": {
                    "GAME": "d2",
                    "MISSION": "Counterstrike",
                },
            },
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
        "post_delay_ms": 250,
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
        "post_delay_ms": 250,
    },
    {
        "action": "enter_game",
        "game": "${GAME}",
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Rookie",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "skip_briefing",
        "when": "d2",
        "timeout_ms": 30000,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 30000,
    },
    {
        "action": "controller_input",
        "idle_timeout_ms": 1500,
    },
    {
        "action": "wait_ms",
        "ms": 2000,
    },
    {
        "action": "assert",
        "expect": {
            "idle_saver.state": "0",
            "idle_saver.checkpoints": "0",
        },
    },
    {
        "action": "key",
        "key": "pause",
    },
    {
        "action": "wait_for",
