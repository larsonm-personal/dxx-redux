[
    {
        "_info": {
            "games": [
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "wait_ms",
        "ms": 3000
    },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "coop_endgame.active": true,
            "coop_endgame.released": true,
            "coop_briefing.active": false,
            "time_paused": true,
            "screen_advance_kind": "movie"
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "movie.current": "end.mve",
            "movie.frame": {
                "gte": 1
            }
        }
    },
    {
        "action": "key",
        "key": "pause"
    },
    {
        "action": "wait_for",
        "timeout_ms": 5000,
        "expect": {
            "movie.paused": true,
            "movie.pause_window": true
        }
    },
    {
        "action": "wait_ms",
        "ms": 18000
    },
    {
        "action": "assert",
        "expect": {
            "coop_endgame.released": true,
            "time_paused": true,
            "screen_advance_kind": "movie",
            "coop_briefing.active": false
        }
    },
    {
        "action": "assert",
        "expect": {
            "movie.paused": true,
            "movie.pause_window": true
        }
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "postlevel_active": true,
            "screen_advance_can_activate": true,
            "coop_endgame.released": true
        }
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "select",
        "text": "OK",
        "optional": true,
        "timeout_ms": 1500,
        "post_delay_ms": 100
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "in_game": false,
            "coop_endgame.active": false,
            "time_paused": false
        }
    },
    {
        "action": "introspect"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.items[0].text": "New game",
            "in_game": false
        }
    }
]
