[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_pog_runtime",
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Load Game",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "[quick] level 12",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "current_level_num": 12,
            "position.segment": 2156,
            "player_dead": false,
            "cheats_enabled": false,
            "xl_pilot.wall_triggers.16.operated": true,
            "xl_pilot.wall_triggers.39.operated": true,
            "xl_pilot.wall_triggers.38.operated": false,
            "xl_pilot.wall_triggers.67.operated": false,
            "xl_pilot.doorways.152.state": 0,
            "xl_pilot.doorways.120.type": 4,
        },
        "timeout_ms": 120000,
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": -1.0,
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.wall_triggers.67.operated": true,
            "xl_pilot.boosts.0.owner": 0,
            "xl_pilot.boost_player_locked": true,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": 0.0,
    },
    {
        "action": "wait_for",
        "expect": {
            "menu.subtitle": {
                "contains": "Level 12 Complete",
            },
        },
        "timeout_ms": 20000,
    },
    {
        "action": "assert",
        "expect": {
            "player_dead": false,
            "cheats_enabled": false,
            "player.invulnerable": false,
            "xl_pilot.remaining_objectives": 0,
            "reactor_countdown.active": false,
            "xl_pilot.boost_player_locked": false,
            "xl_pilot.wall_triggers.71.value": 851968,
            "xl_pilot.wall_triggers.16.operated": true,
            "xl_pilot.wall_triggers.16.actor": 0,
            "xl_pilot.wall_triggers.16.shot": 1,
            "xl_pilot.wall_triggers.39.operated": true,
            "xl_pilot.wall_triggers.39.actor": 0,
            "xl_pilot.wall_triggers.39.shot": 0,
            "xl_pilot.wall_triggers.38.operated": true,
            "xl_pilot.wall_triggers.38.actor": 0,
            "xl_pilot.wall_triggers.38.shot": 0,
            "xl_pilot.wall_triggers.67.operated": true,
            "xl_pilot.wall_triggers.67.shot": 0,
            "xl_pilot.wall_triggers.68.operated": true,
            "xl_pilot.wall_triggers.68.shot": 0,
            "xl_pilot.wall_triggers.69.operated": true,
            "xl_pilot.wall_triggers.69.shot": 0,
            "xl_pilot.wall_triggers.70.operated": true,
            "xl_pilot.wall_triggers.70.shot": 0,
            "xl_pilot.wall_triggers.71.operated": true,
            "xl_pilot.wall_triggers.71.actor": 0,
            "xl_pilot.wall_triggers.71.shot": 0,
        },
