// High trigger IDs through authored dispatch, a controlled crossing, disk and memory state
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_trigger_capacity_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL triggers",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
        },
        "timeout_ms": 15000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 100,
    },
    {
        "action": "face_view",
        "segment": 24,
        "side": 5,
        "distance": 20,
        "post_delay_ms": 100,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.doorways.0.trigger": 128,
            "xl_pilot.doorways.1.trigger": 253,
            "xl_pilot.doorways.0.controlling_trigger": 253,
            "xl_pilot.wall_triggers.253.flags": 2,
            "xl_pilot.wall_triggers.128.type": 9,
        },
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "fire_wall_trigger",
        "value": "4",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.wall_triggers.253.flags": 6,
        },
        "timeout_ms": 15000,
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "fire_wall_trigger",
        "value": "1",
        "post_delay_ms": 0,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.cloak_count": 0,
            "xl_pilot.wall_triggers.253.activated_since_load": false,
        },
        "post_delay_ms": 0,
    },
    {
        "action": "set_debug",
        "field": "fire_wall_trigger",
        "value": "5",
        "post_delay_ms": 0,
    },
    {
        "action": "wait_for",
