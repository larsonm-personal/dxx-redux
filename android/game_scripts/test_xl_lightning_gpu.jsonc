// Controlled renderer frame with original corona; no level9 admission or traversal
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "skybox_start_hub" },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    { "action": "wait_for", "expect": { "in_game": true, "xl_pilot.runtime_active": true }, "timeout_ms": 30000 },
    { "action": "set_debug", "field": "graphics_option", "value": "msaa_level:4" },
    {
        "action": "controller_input",
        "timeout_ms": 10000,
        "expect": { "graphics_safety.phase": "challenge", "graphics_safety.candidate_ready": true },
        "controller_keys": ["DLEFT", "A"],
        "post_delay_ms": 50,
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
            "msaa.create_complete": true,
            "msaa.effective_samples": { "gte": 2 },
        },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "lightning_capture" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "lightning_gpu" },
    {
        "action": "assert",
        "expect": {
            "xl_pog.passed": true,
            "xl_pog.line_cases": 28,
            "xl_pog.outline_cases": 4,
            "xl_pog.wall_cases": 96,
            "xl_pog.sprite_cases": 1,
            "xl_pog.bitmap_cases": 108,
            "xl_pog.shield_cases": 72,
            "xl_pog.original_shield_cases": 612,
            "xl_pog.camera_target_cases": 48,
            "xl_pog.camera_native_pass_cases": 4,
            "xl_pog.camera_scene_cases": 4,
            "xl_pog.camera_monitor_cases": 52,
            "xl_pog.glare_width": 512,
            "xl_pog.lightning_changed": { "gte": 1 },
            "xl_pog.corona_width": 256,
        },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    { "action": "key", "key": "escape" },
    { "action": "wait_for", "expect": { "menu.subtitle": "Game Menu" }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "graphics_context_loss_once", "value": "1" },
    { "action": "log", "message": "SCRIPT_BACKGROUND: xl-lightning-context duration_s=3" },
    {
        "action": "wait_for",
        "expect": {
            "egl_recreate_count": { "gte": 1 },
            "android_lifecycle.observed_visibility": "foreground",
            "android_lifecycle.suspend_state": "running",
        },
        "timeout_ms": 90000,
    },
    { "action": "wait_for", "expect": { "menu.subtitle": "Game Menu" }, "timeout_ms": 20000 },
    { "action": "key", "key": "escape" },
    { "action": "wait_for", "expect": { "time_paused": false, "game_window_is_front": true }, "timeout_ms": 20000 },
    // Resume reapplies launcher graphics options; restore the already accepted MSAA choice
    { "action": "set_debug", "field": "graphics_option", "value": "msaa_level:4" },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
            "msaa.create_complete": true,
            "msaa.effective_samples": { "gte": 2 },
        },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "lightning_gpu" },
    {
        "action": "assert",
        "expect": {
            "xl_pog.passed": true,
            "xl_pog.line_cases": 28,
            "xl_pog.outline_cases": 4,
            "xl_pog.wall_cases": 96,
            "xl_pog.sprite_cases": 1,
            "xl_pog.bitmap_cases": 108,
            "xl_pog.shield_cases": 72,
            "xl_pog.original_shield_cases": 612,
            "xl_pog.camera_target_cases": 48,
            "xl_pog.camera_native_pass_cases": 4,
            "xl_pog.camera_scene_cases": 4,
            "xl_pog.camera_monitor_cases": 52,
            "xl_pog.glare_width": 512,
            "xl_pog.lightning_changed": { "gte": 1 },
            "xl_pog.corona_width": 256,
        },
    },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "lightning_release" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "introspect" },
]
