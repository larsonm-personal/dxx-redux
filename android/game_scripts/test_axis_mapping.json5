// TEST: Android Input Routing Regression
//
// Verifies D1 and D2 gameplay routing for analog movement, D-pad buttons, and
// trigger axis-buttons. Continuous axes use the same coalesced mailbox as
// production gyro/touch/controller input, and each assertion is correlated to
// the exact generation consumed by kconfig on the game thread.
//
// Ownership is intentionally narrow:
//   - test_controller_compare_unified owns launcher/game binding parity.
//   - ControllerConfigSerializationTest owns expected static button slots.
//   - pause scripts own ESC; test_readable_tiny_help_d2 is the F1 canary.
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike", "GAME_NUM": "1"},
            "d2": {"MISSION": "Counterstrike", "GAME_NUM": "2"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_default_config",
     "post_delay_ms": 1000},
    {"action": "enter_game", "game": "d1", "when": "d1"},
    {"action": "enter_game", "game": "d2", "when": "d2"},

    {"action": "log", "message": "=== TEST: Axis Routing Regression ==="},
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "when": "d1", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "Trainee", "when": "d2", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    // Saturate SDL's discrete event queue and use the same production publisher
    // as JNI. The continuous axis must still reach kconfig through the mailbox.
    {"action": "send_axis", "axis": 2, "axis_value": 0.5,
     "saturate_sdl_queue": true, "use_production_path": true,
     "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.valid": true,
        "axis_probe.axis": 2,
        "axis_probe.touch_source": false,
        "axis_probe.processed": true,
        "axis_probe.queue_saturated": true,
        "axis_probe.queue_fill_count": {"gt": 0},
        "axis_mailbox.automation_active": false,
        "axis_mailbox.last_applied_generation": {"gt": 0},
        "axis_probe.heading_time": {"gt": 0}
    }},
    {"action": "send_axis", "axis": 2, "axis_value": 0.0,
     "use_production_path": true, "post_delay_ms": 0},

    // Automation owns a complete vector so multi-axis assertions cannot sample
    // unrelated gyro/controller traffic.
    {"action": "send_axis", "axis": 2, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 2,
        "axis_probe.processed": true,
        "axis_mailbox.automation_active": true,
        "axis_probe.heading_time": {"gt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.slide_lr_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.bank_time": 0,
        "axis_probe.throttle_time": 0
    }},

    // Add left stick X without releasing RX. Both held axes must survive.
    {"action": "send_axis", "axis": 0, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 0,
        "axis_probe.processed": true,
        "axis_probe.slide_lr_time": {"gt": 0},
        "axis_probe.heading_time": {"gt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.bank_time": 0,
        "axis_probe.throttle_time": 0
    }},

    // Releasing RX must leave LX active and isolated.
    {"action": "send_axis", "axis": 2, "axis_value": 0.0, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 2,
        "axis_probe.heading_time": 0,
        "axis_probe.slide_lr_time": {"gt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.bank_time": 0,
        "axis_probe.throttle_time": 0
    }},
    {"action": "send_axis", "axis": 0, "axis_value": 0.0, "post_delay_ms": 0},

    // Right stick Y routes only to pitch.
    {"action": "send_axis", "axis": 3, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 3,
        "axis_probe.processed": true,
        "axis_probe.pitch_time": {"lt": 0},
        "axis_probe.heading_time": 0,
        "axis_probe.slide_lr_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.bank_time": 0,
        "axis_probe.throttle_time": 0
    }},
    {"action": "send_axis", "axis": 3, "axis_value": 0.0, "post_delay_ms": 0},

    // Left stick Y routes only to throttle. This owns the historic LY mapping
    // regression and proves that LY does not leak into pitch or slide U/D.
    {"action": "send_axis", "axis": 1, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 1,
        "axis_probe.processed": true,
        "axis_probe.throttle_time": {"lt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.heading_time": 0,
        "axis_probe.slide_lr_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.bank_time": 0
    }},
    {"action": "send_axis", "axis": 1, "axis_value": 0.0, "post_delay_ms": 0},

    // Gyro roll axes use non-touch source semantics in production.
    {"action": "send_axis", "axis": 6, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 6,
        "axis_probe.touch_source": false,
        "axis_probe.processed": true,
        "axis_probe.bank_time": {"lt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.heading_time": 0,
        "axis_probe.slide_lr_time": 0,
        "axis_probe.slide_ud_time": 0,
        "axis_probe.throttle_time": 0
    }},
    {"action": "send_axis", "axis": 6, "axis_value": 0.0, "post_delay_ms": 0},

    {"action": "send_axis", "axis": 7, "axis_value": 0.5, "post_delay_ms": 0},
    {"action": "assert", "expect": {
        "axis_probe.axis": 7,
        "axis_probe.touch_source": false,
        "axis_probe.processed": true,
        "axis_probe.slide_ud_time": {"gt": 0},
        "axis_probe.pitch_time": 0,
        "axis_probe.heading_time": 0,
        "axis_probe.slide_lr_time": 0,
        "axis_probe.bank_time": 0,
        "axis_probe.throttle_time": 0
    }},
    {"action": "send_axis", "axis": 7, "axis_value": 0.0, "post_delay_ms": 0},

    // D-pad mixer buttons route to the four slide actions.
    {"action": "send_button", "button": 108, "held": 1},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_ud_time": {"ne": 0}}},
    {"action": "send_button", "button": 108, "pressed": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_ud_time": 0}},

    {"action": "send_button", "button": 109, "held": 1},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_ud_time": {"ne": 0}}},
    {"action": "send_button", "button": 109, "pressed": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_ud_time": 0}},

    {"action": "send_button", "button": 106, "held": 1},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_lr_time": {"ne": 0}}},
    {"action": "send_button", "button": 106, "pressed": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_lr_time": 0}},

    {"action": "send_button", "button": 107, "held": 1},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_lr_time": {"ne": 0}}},
    {"action": "send_button", "button": 107, "pressed": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {"slide_lr_time": 0}},

    // Reapplied held triggers must produce one edge, not a pulse every frame.
    {"action": "send_axis", "axis": 5, "axis_value": 0.8, "post_delay_ms": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {
        "axis_probe.sample_count": {"gte": 4},
        "raw_joy_axis[5]": {"gt": 0},
        "joy_buttons[21]": 1,
        "axis_probe.axis_button_down_edges": 1,
        "axis_probe.axis_button_up_edges": 0
    }},
    {"action": "send_axis", "axis": 5, "axis_value": 0.0, "post_delay_ms": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {
        "raw_joy_axis[5]": 0,
        "joy_buttons[21]": 0,
        "axis_probe.axis_button_down_edges": 0,
        "axis_probe.axis_button_up_edges": 1
    }},

    {"action": "send_axis", "axis": 4, "axis_value": 0.8, "post_delay_ms": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {
        "axis_probe.sample_count": {"gte": 4},
        "raw_joy_axis[4]": {"gt": 0},
        "joy_buttons[19]": 1,
        "axis_probe.axis_button_down_edges": 1,
        "axis_probe.axis_button_up_edges": 0
    }},
    {"action": "send_axis", "axis": 4, "axis_value": 0.0, "post_delay_ms": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {
        "raw_joy_axis[4]": 0,
        "joy_buttons[19]": 0,
        "axis_probe.axis_button_down_edges": 0,
        "axis_probe.axis_button_up_edges": 1
    }},

    // A complete trigger tap during one stalled frame must retain both edges.
    {"action": "send_axis", "axis": 5, "axis_value": 0.8,
     "use_production_path": true, "pulse_before_drain": true,
     "post_delay_ms": 0},
    {"action": "wait_for", "timeout_ms": 3000, "expect": {
        "axis_probe.valid": true,
        "axis_probe.axis_button_down_edges": 1,
        "axis_probe.axis_button_up_edges": 1,
        "raw_joy_axis[5]": 0,
        "joy_buttons[21]": 0,
        "axis_mailbox.automation_active": false
    }},

    {"action": "log", "message": "=== TEST: Android Input Routing -- PASS ==="},

    // Keyboard Defaults Regression
    //
    // Root cause this catches:
    //   kconfig_fill_kb_settings() used memset(out, 0xFF, MAX_CONTROLS)
    //   which cleared all keyboard bindings to unbound. The fix changed
    //   this to memcpy(out, DefaultKeySettings[0], MAX_CONTROLS) so
    //   default keyboard bindings (like TAB=automap) survive the init.
    //
    // Phase 1: TAB opens automap, proving TAB is bound in keyboard config.
    // Phase 2: ESC closes automap and returns to the game.
    {"action": "log", "message": "=== TEST: Keyboard Defaults Regression ==="},
    {"action": "log", "message": "Phase 1: Press TAB to open automap"},
    {"action": "assert", "expect": {"automap_active": "false"}},
    {"action": "key", "key": "tab", "post_delay_ms": 100},
    {"action": "wait_for", "field": "automap_active", "value": "true", "timeout_ms": 3000},
    {"action": "assert", "expect": {"automap_active": "true"}},
    {"action": "log", "message": "Phase 1: PASS -- TAB opened automap (keyboard defaults working)"},
    {"action": "log", "message": "Phase 2: ESC closes automap"},
    {"action": "key", "key": "esc", "post_delay_ms": 100},
    {"action": "wait_for", "field": "automap_active", "value": "false", "timeout_ms": 3000},
    {"action": "assert", "expect": {
        "automap_active": "false",
        "game_window_is_front": "true"
    }},
    {"action": "log", "message": "Phase 2: PASS -- automap dismissed, back in game"},
    {"action": "log", "message": "=== TEST: Keyboard Defaults Regression -- ALL PHASES PASS ==="},

    // Hold the mixer-mapped Fire Primary button long enough for the control
    // state to be sampled, then assert the bound fire state before releasing.
    {"action": "log", "message": "=== TEST: Fire Primary (held button) ===", "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "current_level_num": "1"
    }},
    {"action": "send_button", "button": 100, "held": 1, "when": "d2"},
    {"action": "wait_ms", "ms": 300, "when": "d2"},
    {"action": "introspect", "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "fire_primary_state": {"ne": 0}
    },
     "_comment": "Holding Fire Primary should drive the bound control state"},
    {"action": "send_button", "button": 100, "pressed": 0, "when": "d2"},
    {"action": "wait_for", "field": "fire_primary_state", "value": "0",
     "when": "d2", "timeout_ms": 3000},
    {"action": "log", "message": "=== TEST: Fire Primary (held button) -- PASS ===", "when": "d2"},

    // A fresh D2 pilot on Trainee starts with seven concussion missiles.
    // Verify the live button mapping before intentionally changing the ammo.
    {"action": "log", "message": "=== TEST: Fire Secondary (one-frame tap) ===", "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "current_level_num": "1",
        "joystick_controls.items[1].name": {"eq": "Fire secondary"},
        "joystick_controls.items[1].value": {"eq": "101"},
        "player.secondary_weapon": {"eq": "0"},
        "player.secondary_ammo[0]": {"eq": "7"}
    }},

    // A true tap should spend one missile and then stop. If the button-up path
    // is missed, ammo will continue dropping while the fire state stays latched.
    {"action": "send_button", "button": 101, "when": "d2", "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 1500, "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "player.secondary_weapon": {"eq": "0"},
        "player.secondary_ammo[0]": {"eq": "6"}
    }},
    {"action": "log", "message": "=== TEST: Fire Secondary (one-frame tap) -- PASS ===", "when": "d2"}
]
