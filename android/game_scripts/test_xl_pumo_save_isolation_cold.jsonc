// Native load menus follow the last saved mission; reselect through ordinary new-game/abort
[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_pog_runtime",
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "Pumo Mines",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "Load Game",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "[quick] level 1",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
            "time_paused": false,
            "current_level_num": 1,
            "xl_pilot.runtime_active": true,
            "player.energy": {
                "range": [80, 99.99],
            },
            "current_level_name": "Temporal Hub",
        },
        "timeout_ms": 120000,
    },
    {
        "action": "assert",
        "expect": {
            "cheats_enabled": false,
            "player_dead": false,
        },
    },
    {
        "action": "introspect",
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "Counterstrike",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 15000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
