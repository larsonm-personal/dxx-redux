// TEST: LAN co-op host launch exposes launcher feedback immediately
[
    {"_info": {
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "tap_button", "text": "Multiplayer", "post_delay_ms": 300},
    {"action": "mp_command", "command": "lan_host_lobby", "args": {
        "callsign": "FeedbackHost",
        "game": "d2",
        "mission": "d2",
        "mode": "coop",
        "max_players": 4
    }, "post_delay_ms": 250},
    {"action": "mp_command", "command": "lan_start_game", "args": {
        "difficulty": 1,
        "level_num": 1
    }, "post_delay_ms": 25},
    {"action": "assert", "expect": {
        "launch_preparation.active": "true",
        "launch_preparation.game": "d2",
        "launch_preparation.kind": "multiplayer"
    }},
    {"action": "log", "message": "=== TEST: Co-op launch feedback -- PASS ==="}
]
