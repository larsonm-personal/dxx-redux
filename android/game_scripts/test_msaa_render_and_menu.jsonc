    {
        "action": "enter_launcher",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "write_config",
        "file": "graphics_safety.json",
        "content": "{\n  \"accepted\": {\n    \"TexFilt\": 0,\n    \"AnisoLevel\": 0,\n    \"MsaaLevel\": 0,\n    \"MenuTexFilt\": 0,\n    \"HudTexFilt\": 0,\n    \"ResolutionX\": 640,\n    \"ResolutionY\": 480,\n    \"AspectX\": 3,\n    \"AspectY\": 4,\n    \"ColorDepth\": ${COLOR_DEPTH}\n  },\n  \"attempt\": null,\n  \"pending\": {}\n}\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
