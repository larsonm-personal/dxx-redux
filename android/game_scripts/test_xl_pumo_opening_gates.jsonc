// Original PMC1 local gate activation, flight and warm save restoration
[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_pog_runtime",
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
