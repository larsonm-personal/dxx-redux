    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 14,
            "xl_pog.flow_exits": 4,
        },
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit5",
        "post_delay_ms": 500,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 5,
