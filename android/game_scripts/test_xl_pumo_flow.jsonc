[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_pog_runtime",
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "skybox_start_hub",
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 30000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "xl_pilot.runtime_active": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "overlay_pause",
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": true,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_capture",
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "disk_save",
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "resume",
    },
    {
        "action": "wait_for",
        "expect": {
            "time_paused": false,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit2",
        "post_delay_ms": 500,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 2,
            "xl_pog.flow_exits": 1,
        },
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit3",
        "post_delay_ms": 500,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 3,
            "xl_pog.flow_exits": 2,
        },
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit4",
        "post_delay_ms": 500,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 4,
            "xl_pog.flow_exits": 3,
        },
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit14",
