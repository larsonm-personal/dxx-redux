    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_exit6",
        "post_delay_ms": 500,
    },
    {
        "action": "set_debug",
        "field": "xl_pog_probe",
        "value": "flow_verify",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pog.flow_level": 6,
