// TEST: Death on D1 Level 11 (Insane)
// Verifies player_dead and player_exploded introspection fields.
//
// Timing data (3 runs on Pixel_6_API_34 emulator):
//   screen_mode=menu (pilot): 28ms, 64ms, 46ms  (min 28ms)
//   screen_mode=menu (main):  32ms, 41ms, 57ms  (min 32ms)
//   in_game:                  137ms, 175ms, 150ms (min 137ms)
//   game_window_is_front:     58ms, 64ms, 89ms  (min 58ms)
//   player_dead:              3960ms, 4232ms, 3901ms (min 3901ms)
[
    {"action": "log", "message": "=== TEST: Death on D1 Level 11 (Insane) ==="},

    {"action": "wait_ms", "ms": 2000},

    // Pilot select
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5028},
    {"action": "select", "text": "player", "post_delay_ms": 2000},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5032},
    {"action": "select", "text": "New game", "post_delay_ms": 1500},

    // Mission select
    {"action": "wait_ms", "ms": 1000},
    {"action": "select", "text": "First Strike", "post_delay_ms": 1500},

    // Level 11
    {"action": "wait_ms", "ms": 500},
    {"action": "key", "key": "backspace", "post_delay_ms": 200},
    {"action": "key", "key": "1", "post_delay_ms": 200},
    {"action": "key", "key": "1", "post_delay_ms": 200},
    {"action": "select", "text": "Ok", "post_delay_ms": 1500},

    // Insane difficulty
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Insane", "post_delay_ms": 1500},

    // Skip briefing (1 ESC aborts all pages)
    {"action": "key", "key": "escape", "post_delay_ms": 1000},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 5000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "current_level_num": "11"}},
    {"action": "introspect"},

    // Wait for death
    {"action": "wait_for", "field": "player_dead", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"player_dead": "true"}},
    {"action": "introspect"},

    {"action": "log", "message": "=== TEST: Death on D1 Level 11 (Insane) — COMPLETE ==="}
]
