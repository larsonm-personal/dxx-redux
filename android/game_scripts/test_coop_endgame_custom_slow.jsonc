[
    {
        "_info": {
            "games": [
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "wait_ms",
        "ms": 3000
    },
    {
        "action": "trigger_levelcomplete"
    },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "coop_endgame.active": true,
            "coop_endgame.released": true,
            "coop_briefing.active": false,
            "time_paused": true,
            "screen_advance_kind": "briefing"
        }
    },
    {
        "action": "wait_ms",
        "ms": 45000
    },
    {
        "action": "assert",
        "expect": {
            "coop_endgame.released": true,
            "time_paused": true,
            "screen_advance_kind": "briefing",
            "coop_briefing.active": false
        }
    },
    {
        "action": "key",
        "key": "escape"
    },
    {
        "action": "wait_for",
        "timeout_ms": 5000,
        "expect": {
            "menu.type": "credits",
            "coop_endgame.released": true
        }
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 300
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "screen_advance_can_activate": true,
            "coop_endgame.released": true,
            "postlevel_active": true
        }
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.items[0].text": "New game",
            "in_game": false,
            "time_paused": false,
            "coop_endgame.active": false
        }
    }
]

