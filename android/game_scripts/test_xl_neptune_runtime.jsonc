// Explicit private-fixture startup and save/restore test, not full mission qualification
// Requires the normal OpenGL APK, original neptunxl.mn2/HOG in d2x-redux/missions,
// retail D2 data and an existing player pilot; run with -PreserveState
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_neptune_runtime",
            "games": ["d2"],
            "vars": { "d2": { "PILOT": "player" } },
        },
    },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000, "post_delay_ms": 500 },
    { "action": "select", "text": "${PILOT}", "timeout_ms": 10000, "post_delay_ms": 200 },
    // Derived unsupported controls must fail helpfully before original admission
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "XL: Neptune rejected 0", "timeout_ms": 10000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.title": "Cannot run XL level",
            "menu.subtitle": { "contains": "segment_properties at record 0: 8" },
            "in_game": false,
            "xl_pilot.runtime_active": false,
        },
    },
    { "action": "key", "key": "enter", "post_delay_ms": 300 },
    { "action": "key", "key": "escape", "post_delay_ms": 300 },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "XL: Neptune rejected 1", "timeout_ms": 10000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.title": "Cannot run XL level",
            "menu.subtitle": { "contains": "multiplayer_only_object at record 0: 1" },
            "in_game": false,
            "xl_pilot.runtime_active": false,
        },
    },
    { "action": "key", "key": "enter", "post_delay_ms": 300 },
    { "action": "key", "key": "escape", "post_delay_ms": 300 },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "XL: Neptune rejected 2", "timeout_ms": 10000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.title": "Cannot run XL level",
            "menu.subtitle": { "contains": "Invalid selected-HOG lighting companion length" },
            "in_game": false,
            "xl_pilot.runtime_active": false,
        },
    },
    { "action": "key", "key": "enter", "post_delay_ms": 300 },
    { "action": "key", "key": "escape", "post_delay_ms": 300 },
    { "action": "select", "text": "New game", "timeout_ms": 15000, "post_delay_ms": 200 },
    { "action": "select_mission", "text": "XL: Neptune (XL)", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000, "post_delay_ms": 200 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    { "action": "wait_ms", "ms": 1000 },
    {
        "action": "assert",
        "expect": {
            "current_level_num": 1,
            "current_level_name": "Neptune",
            "player.robots_level": 0,
            "player.invulnerable": false,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
        },
    },
    // Controlled difficulty change proves a restore occurred; this is not progression evidence
    { "action": "assert", "expect": { "difficulty": 2 } },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 1000 },
    { "action": "set_debug", "field": "android_game_request", "value": "difficulty:3", "post_delay_ms": 200 },
    { "action": "assert", "expect": { "difficulty": 3 } },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "game_window_is_front": true,
            "time_paused": false,
            "current_level_name": "Neptune",
            "current_level_num": 1,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
            "player.robots_level": 0,
            "player.invulnerable": false,
        },
    },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": true, "xl_pilot.menu_indicator_draws": { "gt": 0 } } },
    { "action": "select", "text": "Abort Game", "timeout_ms": 5000 },
    { "action": "wait_for", "field": "in_game", "value": "false", "timeout_ms": 10000 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": false } },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "Counterstrike", "timeout_ms": 10000 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000 },
    { "action": "select", "text": "Trainee", "timeout_ms": 10000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    {
        "action": "assert",
        "expect": {
            "difficulty": 0,
            "xl_pilot.runtime_active": false,
            "current_level_num": 1,
            "xl_pilot.active": false,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": 0,
            "xl_pilot.activated_triggers": 0,
            "xl_pilot.unresolved_emitters": 0,
        },
    },
    // The quick slot belongs to the saved pilot, even after switching missions
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "current_level_name": "Neptune",
            "current_level_num": 1,
            "game_window_is_front": true,
            "time_paused": false,
            "xl_pilot.active": true,
            "xl_pilot.completed": false,
            "xl_pilot.shaded_vertices": { "gt": 0 },
            "xl_pilot.unresolved_emitters": 0,
            "player.robots_level": 0,
            "player.invulnerable": false,
        },
    },
    // All seven original POG payloads must be installed and GPU-resident after restore
    // Fingerprints use decimal strings because numeric expectations narrow to signed int32
    { "action": "face_view", "segment": 91, "side": 0, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.0.xl_pog_installed": true,
            "level_scene.texture_references.0.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.0.xl_pog_payload_fnv1a": "1802764526",
            "level_scene.texture_references.0.rendered": true,
        },
    },
    { "action": "face_view", "segment": 0, "side": 1, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.3.xl_pog_installed": true,
            "level_scene.texture_references.3.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.3.xl_pog_payload_fnv1a": "928977817",
            "level_scene.texture_references.3.rendered": true,
        },
    },
    { "action": "face_view", "segment": 0, "side": 3, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.13.xl_pog_installed": true,
            "level_scene.texture_references.13.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.13.xl_pog_payload_fnv1a": "929496110",
            "level_scene.texture_references.13.rendered": true,
        },
    },
    { "action": "face_view", "segment": 0, "side": 0, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.46.xl_pog_installed": true,
            "level_scene.texture_references.46.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.46.xl_pog_payload_fnv1a": "3423223186",
            "level_scene.texture_references.46.rendered": true,
        },
    },
    { "action": "face_view", "segment": 16, "side": 4, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.47.xl_pog_installed": true,
            "level_scene.texture_references.47.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.47.xl_pog_payload_fnv1a": "4198776589",
            "level_scene.texture_references.47.rendered": true,
        },
    },
    { "action": "face_view", "segment": 34, "side": 2, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.48.xl_pog_installed": true,
            "level_scene.texture_references.48.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.48.xl_pog_payload_fnv1a": "547759460",
            "level_scene.texture_references.48.rendered": true,
        },
    },
    { "action": "face_view", "segment": 44, "side": 2, "distance": 10, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "level_scene.texture_references.209.xl_pog_installed": true,
            "level_scene.texture_references.209.xl_pog_payload_bytes": 4096,
            "level_scene.texture_references.209.xl_pog_payload_fnv1a": "3566167754",
            "level_scene.texture_references.209.rendered": true,
        },
    },
    // Native original-file check identifies this face's authored texture-295 emitter
    // Controlled placement is a rendering witness, not route traversal
    { "action": "face_view", "segment": 9, "side": 2, "distance": 12, "post_delay_ms": 300 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "xl_pilot.corona_draws": { "gt": 0 },
            "xl_pilot.corona_depth_failures": 0,
            "xl_pilot.active": true,
        },
    },
    { "action": "introspect" },
]
