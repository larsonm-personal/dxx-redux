[
    {
        "_info": {
            "games": [
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "set_debug",
        "field": "coop_death_test",
        "value": "move_away"
    },
    {
        "action": "set_debug",
        "field": "damage_player",
        "value": "500"
    },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "player_dead": true,
            "player_exploded": true,
            "screen_advance_kind": "death",
            "screen_advance_can_activate": true
        }
    },
    {
        "action": "send_button",
        "button": 0,
        "post_delay_ms": 50
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "coop_travel.waiting_after_death": true,
            "player_dead": true,
            "time_paused": false,
            "postlevel_active": false
        }
    },
    {
        "action": "wait_ms",
        "ms": 3000
    },
    {
        "action": "assert",
        "expect": {
            "coop_travel.waiting_after_death": true,
            "player_dead": true,
            "time_paused": false,
            "postlevel_active": false
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.phase": 4,
            "coop_travel.prepared": true,
            "time_paused": true
        }
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_hold"
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.arrivals_placed": true,
            "coop_travel.phase": 8,
            "time_paused": true
        }
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_verify"
    },
    {
        "action": "set_debug",
        "field": "coop_travel_test",
        "value": "arrival_release"
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_travel.active": false,
            "coop_restore.transfer_busy": false,
            "time_paused": false,
            "in_game": true,
            "player_dead": false
        }
    },
    {
        "action": "set_debug",
        "field": "coop_world_test",
        "value": "travel_verify"
    },
    {
        "action": "set_debug",
        "field": "coop_world_test",
        "value": "destroyed_secret_verify"
    },
    {
        "action": "set_debug",
        "field": "clear_robots",
        "value": "true"
    }
]
