    { "action": "wait_ms", "ms": 500 },
    { "action": "send_button", "button": 102, "pressed": 0 },
    { "action": "set_debug", "field": "coop_death_test", "value": "move_away" },
    { "action": "assert", "expect": { "in_game": true, "player_dead": false } },
    { "action": "introspect" },
