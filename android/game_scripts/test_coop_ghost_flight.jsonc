    { "_info": { "games": ["d1", "d2"], "_standalone": false, "_owner": "test_lan" } },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": { "in_game": true, "time_paused": false, "multiplayer.num_connected": 2 },
