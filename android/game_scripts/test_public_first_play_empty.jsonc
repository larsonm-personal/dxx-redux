    // The buttons remain clickable to explain missing files; they must not start an engine
    { "action": "tap_button", "text": "Launch Descent 1", "exact": true },
    { "action": "assert_button", "text": "OK", "exact": true, "enabled": true },
    { "action": "tap_button", "text": "OK", "exact": true },
    { "action": "tap_button", "text": "Launch Descent 2", "exact": true },
    { "action": "assert_button", "text": "OK", "exact": true, "enabled": true },
    { "action": "tap_button", "text": "OK", "exact": true },
    { "action": "assert", "expect": { "can_launch": false, "game_running": false } },
    { "action": "log", "message": "PASS: empty content blocks both real launch buttons" },
