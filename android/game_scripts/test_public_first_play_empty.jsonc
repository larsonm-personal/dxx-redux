// Owned cold-content phase; never seed data or bypass launch buttons
[
    { "_info": { "games": ["d1"], "_standalone": false, "_owner": "test_demo_import" } },
    { "action": "enter_launcher" },
    { "action": "wait_for", "field": "active_set", "value": "default", "timeout_ms": 30000 },
    {
        "action": "assert",
        "expect": { "can_launch": false, "d1.ready": false, "d2.ready": false, "d1_in_d2.ready": false, "game_running": false },
