// TEST: GOG Installer + Redbook Regression (unified launcher + game)
//
// Exercises the full GOG import pipeline:
//   1. (Launcher) Clear game data and persisted audio state
//   2. (Launcher) Import the selected D2 GOG installer with audio
//   3. (Launcher) Verify setup introspection: can_launch, audio source identity, track names
//   4. (Launcher) MIDI preview playback verification
//   5. (Launcher) CD audio preview playback verification
//   6. (Game) Create pilot, start level 1
//   7. (Game) Verify redbook playback and overlay entries
//
// Supported D2 installer variants:
//   - Windows: game_data\gog installers\setup_descent_2_1.1_(16596).exe
//   - Mac: game_data\gog installers\descent_2_enUS_1_0_51877.pkg
// Companion D1 installer test variants:
//   - Windows: game_data\gog installers\setup_descent_1.4a_(16596).exe
//   - Mac: game_data\gog installers\descent_enUS_1_0_35122.pkg
//
// Note: The Mac and PC GOG installers appear to carry the same PC game data.
// The Mac package seems to wrap the DOS build via DOSBox-style tooling rather
// than ship original Mac-specific assets, which should keep the exe/pkg test
// paths mostly unified when the D1 and D2 cases live side by side. For D2,
// the Mac .pkg carries DESCENT_II.gog without the tiny cue sidecar; the
// launcher synthesizes that cue so preview and redbook checks stay unified.
//
// Prerequisites (handled by PS1 wrapper):
//   - Selected D2 installer pushed to ${INSTALLER_DEVICE_PATH}
//
// Run via: android/tests/test_gog_installer_redbook_unified.ps1
[
    {"_info": {
        "games": ["d2"],
        "_standalone": false,
        "_owner": "test_gog_installer_redbook_unified",
        "params": {
            "INSTALLER_VARIANT": {
                "label": "D2 GOG installer variant",
                "options": {
                    "d2_windows_exe": {
                        "INSTALLER_DEVICE_PATH": "/data/local/tmp/setup_descent_2_1.1_(16596).exe",
                        "INSTALLER_LABEL": "D2 Windows GOG .exe",
                        "AUDIO_CHECKS_WHEN": "d2",
                        "IMPORT_ONLY_NOTE_WHEN": "skip"
                    },
                    "d2_mac_pkg": {
                        "INSTALLER_DEVICE_PATH": "/data/local/tmp/descent_2_enUS_1_0_51877.pkg",
                        "INSTALLER_LABEL": "D2 Mac GOG .pkg",
                        "AUDIO_CHECKS_WHEN": "d2",
                        "IMPORT_ONLY_NOTE_WHEN": "skip"
                    }
                }
            }
        }
    }},

    // ── Phase 1: Launcher setup ─────────────────────────────────

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== GOG Installer + Redbook: Launcher Phase ==="},

    {"action": "reset_state"},

    // Persisted audio registration and playlist state survive reset_state and
    // clear_set, so clear them explicitly before removing the set artifacts
    {"action": "setup_command", "command": "clear_audio_sources", "post_delay_ms": 1000},

    // Clear any existing game data set
    {"action": "setup_command", "command": "clear_set",
     "args": {"name": "default"}, "post_delay_ms": 1000},

    // Prove this run cannot inherit a prior registration, playlist, preview,
    // or same-path GOG pair before importing the current installer
    {"action": "assert", "expect": {
        "audio_source_count": "0",
        "audio_registry_present": "false",
        "audio_playlist_present": "false",
        "has_legacy_gog_audio": "false",
        "music_preview.midi.state": "stopped",
        "music_preview.cd.state": "stopped"
    }},

    {"action": "log", "message": "Importing ${INSTALLER_LABEL}"},

    // Import selected D2 GOG installer with audio extraction
    {"action": "setup_command", "command": "import_gog",
     "args": {
         "path": "${INSTALLER_DEVICE_PATH}",
         "include_audio": true
     }},

    // Wait for import to complete (can take ~120s for the large D2 installers)
    {"action": "wait_for", "field": "can_launch", "value": "true", "timeout_ms": 180000},
    {"action": "log", "message": "Import complete, can_launch=true"},

    // Verify D2 readiness
    {"action": "assert", "expect": {
        "d2.ready": "true"
    }},

    // A fresh manager reload must see exactly one source registered by this
    // import, with the known D2 identity, artifacts, and cue-derived counts
    {"action": "assert", "when": "${AUDIO_CHECKS_WHEN}", "expect": {
        "audio_source_count": "1",
        "audio_registry_present": "true",
        "has_legacy_gog_audio": "true",
        "audio_sources[0].id": "d2-gog-v1.2",
        "audio_sources[0].disc_id": "d2-gog-v1.2",
        "audio_sources[0].cue_path": "imported/sets/default/DESCENT_II.inst",
        "audio_sources[0].bin_paths[0]": "imported/sets/default/DESCENT_II.gog",
        "audio_sources[0].track_count": "9",
        "audio_sources[0].audio_track_count": "8"
    }},

    // Verify track 4 = "Crawl" (first level music track for D2)
    {"action": "assert", "when": "${AUDIO_CHECKS_WHEN}", "expect": {
        "audio_sources[0].track_names.4": "Crawl"
    }},

    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "Fresh audio source registration and track names verified"},
    {"action": "log", "when": "${IMPORT_ONLY_NOTE_WHEN}", "message": "Installer variant completed without redbook-specific checks"},

    // ── Phase 2: MIDI preview verification ──────────────────────

    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "Testing MIDI preview playback (track 4)"},
    {"action": "setup_command", "when": "${AUDIO_CHECKS_WHEN}", "command": "music_midi_play",
     "args": {"source": 0, "track": 3}},

    // Track enumeration and synth initialization run asynchronously. Wait for
    // their observable completion instead of assuming a fixed startup delay.
    {"action": "wait_for", "when": "${AUDIO_CHECKS_WHEN}",
     "field": "music_preview.midi.state", "value": "playing", "timeout_ms": 20000},

    {"action": "assert", "when": "${AUDIO_CHECKS_WHEN}", "expect": {
        "music_preview.midi.state": "playing",
        "music_preview.midi.position_ms": {"gt": 1000}
    }},
    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "MIDI preview playing OK"},

    {"action": "setup_command", "when": "${AUDIO_CHECKS_WHEN}", "command": "music_midi_stop", "post_delay_ms": 1000},

    // ── Phase 3: CD audio preview verification ──────────────────

    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "Testing CD audio preview playback (track 3)"},
    {"action": "setup_command", "when": "${AUDIO_CHECKS_WHEN}", "command": "music_cd_play",
     "args": {"source": 0, "track": 2}},

    {"action": "wait_for", "when": "${AUDIO_CHECKS_WHEN}",
     "field": "music_preview.cd.state", "value": "playing", "timeout_ms": 20000},
    {"action": "wait_ms", "when": "${AUDIO_CHECKS_WHEN}", "ms": 1500},

    {"action": "assert", "when": "${AUDIO_CHECKS_WHEN}", "expect": {
        "music_preview.cd.state": "playing",
        "music_preview.cd.position_ms": {"gt": 1000}
    }},
    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "CD audio preview playing OK"},

    {"action": "setup_command", "when": "${AUDIO_CHECKS_WHEN}", "command": "music_cd_stop", "post_delay_ms": 1000},

    // ── Phase 4: Switch to game ─────────────────────────────────

    {"action": "log", "message": "Launcher checks passed -- switching to game"},

    // Ensure default set is active before launch
    {"action": "setup_command", "command": "switch_set",
     "args": {"name": "default"}, "post_delay_ms": 500},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "when": "${AUDIO_CHECKS_WHEN}", "command": "write_music_prefs",
     "args": {
         "source": "cd",
         "prefer_mission_soundtrack": false,
         "play_order": 0,
         "volume": 8
     },
     "post_delay_ms": 500},

    // tap_button validates enabled + auto-scrolls to find off-screen buttons.
    // The Mac pkg path skips audio preview checks, so it can reach this button
    // while the launcher is still finishing its background hash pass.
    {"action": "enter_game", "game": "d2"},

    // ── Phase 5: In-game verification ───────────────────────────

    {"action": "log", "message": "=== GOG Installer + Redbook: In-Game Phase ==="},

    // Accept default pilot name
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},

    // Main menu -> New game
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    // GOG full install has only one mission -- skips to "Select starting level"
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    // Difficulty
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},

    // Skip briefing
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 100},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    // Wait for overlays to fire
    {"action": "wait_ms", "ms": 3000},

    // Verify redbook is playing
    {"action": "introspect"},
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "current_level_num": "1"
    }},
    {"action": "assert", "when": "${AUDIO_CHECKS_WHEN}", "expect": {
        "redbook.play_status": "playing"
    }},
    {"action": "log", "when": "${AUDIO_CHECKS_WHEN}", "message": "Redbook playing on level 1 -- checking overlays"},
    {"action": "log", "when": "${IMPORT_ONLY_NOTE_WHEN}", "message": "Level 1 loaded from import-only path"},

    // Verify overlay ring buffer
    {"action": "assert_overlay", "field": "level", "value": "Level 1"},
    {"action": "assert_overlay", "when": "${AUDIO_CHECKS_WHEN}", "field": "track", "value": "Crawl"},

    {"action": "log", "message": "=== TEST: GOG Installer + Redbook -- ALL CHECKS PASS ==="}
]
