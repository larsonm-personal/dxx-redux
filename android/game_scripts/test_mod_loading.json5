// TEST: Mod Loading -- verifies hires texture DXA load coverage
// Parameterized: select texture resolution (128, 256, or 512).
// Pushes hires sounds + textures DXA to files/mods/, writes
// mod_manifest.json, launches D2, and checks hires replacement percent.
[
    {"_info": {
        "games": ["d2"],
        "vars": {
            "d2": {"MISSION": "Counterstrike"}
        },
        "params": {
            "RESOLUTION": {
                "label": "Texture resolution",
                "options": {
                    "128": {"DXA_SHA": "65b0da223b64e95f72904070e0a72ca81f9cb65912e92be3c6243546996f81ad"},
                    "256": {"DXA_SHA": "b5b885f2331970a906ca8d467a45d76048789554299db477d7531d8a1dfb2676"},
                    "512": {"DXA_SHA": "1bcc51fd896d3cbc2f0a0a58eb58260484088633dbb361eeab3da9e88b3d608c"}
                }
            }
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "d2-hires-sounds.dxa", "sha256": "d9cd5a3dd01effd264fda846379c53e40696e5b2aa2a856126333ba55f564307", "target": "files/mods"},
            {"file": "d2-hires-${RESOLUTION}-textures-ktx2.dxa", "sha256": "${DXA_SHA}", "target": "files/mods"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "write_config", "file": "mods/mod_manifest.json",
     "content": "{\"mods\":[{\"filename\":\"d2-hires-sounds.dxa\",\"displayName\":\"D2 Hires Sounds\",\"enabled\":true,\"addedAt\":0,\"sizeBytes\":0,\"game\":\"d2\",\"order\":0},{\"filename\":\"d2-hires-${RESOLUTION}-textures-ktx2.dxa\",\"displayName\":\"D2 Hires ${RESOLUTION} Textures\",\"enabled\":true,\"addedAt\":0,\"sizeBytes\":0,\"game\":\"d2\",\"order\":1}]}"},

    {"action": "tap_button", "text": "Launch Descent 2", "launches_game": true},
    {"action": "log", "message": "=== TEST: Mod Loading ${RESOLUTION} ==="},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "${MISSION}", "optional": true, "post_delay_ms": 100, "timeout_ms": 2000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 60000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},

    {"action": "introspect"},
    {"action": "assert", "expect": {"mounted_mods": {"contains": "d2-hires-${RESOLUTION}-textures-ktx2.dxa"}}},

    // Wait for texture streaming then verify replacement coverage
    {"action": "wait_ms", "ms": 5000},
    {"action": "introspect"},
    {"action": "assert", "expect": {"hires_textures.hires_count": {"gt": 0}}},
    {"action": "assert", "expect": {"hires_textures.max_hires_w": {"gte": "${RESOLUTION}"}}},
    {"action": "assert", "expect": {"hires_textures.replacement_pct": {"gte": 85}},
     "_comment": "Replacement success rate: of PNG files found on disk, >= 85% should load (lower to account for oversized sprite strips exceeding GL_MAX_TEXTURE_SIZE on some devices)"},

    {"action": "log", "message": "=== TEST: Mod Loading ${RESOLUTION} -- PASS ==="}
]
