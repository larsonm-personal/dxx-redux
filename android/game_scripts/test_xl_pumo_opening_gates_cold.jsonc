// Fresh-process opening gate checkpoint and ordinary unlocked-door flight
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "select", "text": "Load Game", "timeout_ms": 15000 },
    { "action": "select", "text": "[quick] level 11", "timeout_ms": 15000 },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
            "current_level_num": 11,
            "game_window_is_front": true,
            "xl_pilot.wall_triggers.0.operated": true,
            "xl_pilot.wall_triggers.1.operated": true,
            "xl_pilot.wall_triggers.4.operated": true,
            // Auto-close may retain the opened bit, but lock ownership must persist
            "xl_pilot.doorways.20.flags": { "range": [16, 18] },
            "xl_pilot.doorways.21.flags": { "range": [16, 18] },
            "xl_pilot.doorways.93.flags": { "range": [16, 18] },
            "xl_pilot.doorways.92.flags": { "range": [24, 26] },
            "xl_pilot.doorways.4.type": 4,
            "xl_pilot.doorways.5.type": 4,
            "xl_pilot.doorways.6.type": 4,
            "xl_pilot.doorways.7.type": 4,
        },
        "timeout_ms": 120000,
    },
    { "action": "pose_view", "segment": 240, "position_fixed": [-8089141, -67511354, -20522551], "heading": 16384 },
    { "action": "send_button", "button": 100, "held": 1 },
    { "action": "wait_ms", "ms": 1000 },
    { "action": "send_button", "button": 100, "pressed": 0 },
    { "action": "send_axis", "axis": 1, "axis_value": -1.0 },
    { "action": "wait_for", "expect": { "position.x": { "gt": -103 } }, "timeout_ms": 10000 },
    { "action": "send_axis", "axis": 1, "axis_value": 0.0 },
    { "action": "assert", "expect": { "player_dead": false, "cheats_enabled": false, "current_level_num": 11 } },
    { "action": "introspect" },
]
