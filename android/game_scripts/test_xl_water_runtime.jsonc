// Controlled water pose and real thrust, not authored traversal or visual/audio parity
// The owner stages original private resources and restores config, pilot and saves
[
    {
        "_info": {
            "games": ["d2"],
            "_standalone": false,
            "_owner": "test_xl_water_runtime",
            "vars": { "d2": { "PILOT": "player" } },
        },
    },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "${PILOT}", "timeout_ms": 10000 },
    { "action": "set_debug", "field": "xl_water_physics", "value": "enable" },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "XL: Robotech Arena", "timeout_ms": 10000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    {
        "action": "assert",
        "expect": { "xl_pilot.runtime_active": true, "xl_pilot.active": false, "player.invulnerable": false },
    },
    // Stage beside the original illusion portal, then cross it with normal thrust
    { "action": "face_view", "segment": 146, "side": 3, "distance": 8, "post_delay_ms": 100 },
    { "action": "assert", "expect": { "position.segment": 146, "xl_pilot.in_water": false } },
    { "action": "send_axis", "axis": 1, "axis_value": -0.25, "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "position.segment": 187 }, "timeout_ms": 10000 },
    { "action": "send_axis", "axis": 1, "axis_value": 0, "post_delay_ms": 100 },
    { "action": "assert", "expect": { "xl_pilot.in_water": true, "player.shields": { "range": [100, 100] } } },
    { "action": "face_view", "segment": 187, "side": 0, "distance": 12, "post_delay_ms": 100 },
    // Stock ship wiggle remains active; measure movement toward the faced -X wall
    {
        "action": "assert",
        "expect": { "xl_pilot.in_water": true, "position.segment": 187, "position.x": { "range": [-13.1, -12.9] } },
    },
    { "action": "send_axis", "axis": 1, "axis_value": -0.5, "post_delay_ms": 300 },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.in_water": true,
            "position.x": { "lt": -13.2 },
            "position.speed": { "gt": 2 },
            "player.shields": { "range": [100, 100] },
            "throttle_time": { "gt": 0 },
        },
    },
    // The ship radius overlaps the authored water portal at this shallow pose
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.waterfall_loops_linked": 1,
            "xl_pilot.waterfall_loops_playing": 1,
            "xl_pilot.water_loops_linked": 0,
        },
        "timeout_ms": 3000,
    },
    { "action": "send_axis", "axis": 1, "axis_value": 0, "post_delay_ms": 100 },
    // Coasting and ship wiggle can leave contact; reacquire the controlled portal pose
    { "action": "face_view", "segment": 187, "side": 0, "distance": 12, "post_delay_ms": 100 },
    {
        "action": "wait_for",
        "expect": { "xl_pilot.waterfall_loops_linked": 1, "xl_pilot.waterfall_loops_playing": 1 },
        "timeout_ms": 3000,
    },
    // Stable pose makes the saved wet/dry distinction independent of frame timing
    { "action": "set_debug", "field": "xl_asset_acquisition_failure", "value": "verify", "post_delay_ms": 100 },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.runtime_active": true,
            "xl_pilot.in_water": true,
            "position.segment": 187,
            "xl_pilot.waterfall_loops_linked": 1,
            "xl_pilot.waterfall_loops_playing": 1,
            "player.shields": { "range": [100, 100] },
            "time_paused": false,
        },
    },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_save", "post_delay_ms": 1000 },
    // Leave through the authored water portal before restoring the wet checkpoint
    { "action": "face_view", "segment": 187, "side": 1, "distance": 8, "post_delay_ms": 100 },
    { "action": "send_axis", "axis": 1, "axis_value": -0.25, "post_delay_ms": 0 },
    { "action": "wait_for", "expect": { "position.segment": 146 }, "timeout_ms": 10000 },
    {
        "action": "wait_for",
        "expect": { "xl_pilot.waterfall_loops_linked": 0, "xl_pilot.water_loops_linked": 0 },
        "timeout_ms": 10000,
    },
    { "action": "send_axis", "axis": 1, "axis_value": 0, "post_delay_ms": 100 },
    { "action": "assert", "expect": { "xl_pilot.in_water": false, "position.segment": 146 } },
    { "action": "set_debug", "field": "android_game_request", "value": "difficulty:3" },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "position.segment": 187,
            "xl_pilot.in_water": true,
            "game_window_is_front": true,
            "xl_pilot.waterfall_loops_playing": 1,
            "time_paused": false,
        },
    },
    { "action": "key", "key": "escape" },
    { "action": "select", "text": "Abort Game", "timeout_ms": 5000 },
    { "action": "wait_for", "field": "in_game", "value": "false", "timeout_ms": 10000 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": false, "xl_pilot.in_water": false } },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "Counterstrike", "timeout_ms": 10000 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000 },
    { "action": "select", "text": "Trainee", "timeout_ms": 10000 },
    { "action": "skip_briefing", "timeout_ms": 20000 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 20000 },
    { "action": "assert", "expect": { "xl_pilot.runtime_active": false, "xl_pilot.in_water": false, "difficulty": 0 } },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load", "post_delay_ms": 1000 },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": {
            "difficulty": 2,
            "position.segment": 187,
            "xl_pilot.in_water": true,
            "xl_pilot.runtime_active": true,
            "game_window_is_front": true,
            "xl_pilot.waterfall_loops_playing": 1,
            "time_paused": false,
        },
    },
    { "action": "introspect" },
    { "action": "key", "key": "escape" },
    { "action": "select", "text": "Abort Game", "timeout_ms": 5000 },
    { "action": "wait_for", "field": "in_game", "value": "false", "timeout_ms": 10000 },
    { "action": "set_debug", "field": "xl_water_physics", "value": "disable" },
    { "action": "select", "text": "New game", "timeout_ms": 10000 },
    { "action": "select_mission", "text": "XL: Robotech Arena", "timeout_ms": 10000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 10000 },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "menu.title": "Cannot run XL level",
            "menu.subtitle": { "contains": "experimental fluid profile is not enabled" },
            "in_game": false,
            "xl_pilot.in_water": false,
        },
    },
    { "action": "introspect" },
]
