// TEST: D1 level 1 merged-wall room probe
// Captures the currently observed D1 room faces around seg 83 so the
// rendered-face probe logs can compare route-sensitive movement on the
// viewed face and nearby light-strip faces from the same room.
[
    {"_info": {
        "games": ["d1"],
        "_deps": [
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== TEST: D1 level 1 current-room merged wall probe ==="},

    {"action": "setup_command", "command": "write_probe_debug_prefs",
     "args": {"enabled": true}, "post_delay_ms": 250},
    {"action": "assert", "expect": {
        "debug_prefs.show_video_info_debug_options": "true",
        "debug_prefs.network_log_enabled": "true",
        "debug_prefs.graphics_log_enabled": "true",
        "debug_prefs.texture_log_enabled": "true",
        "debug_prefs.game_log_enabled": "true",
        "debug_prefs.launcher_log_enabled": "true",
        "debug_prefs.graphics_debug_logging": "true"
    }},
    {"action": "enter_game", "game": "d1"},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "key", "key": "enter", "post_delay_ms": 100},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "post_delay_ms": 100},
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 20000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},

    {"action": "set_debug", "field": "clear_robots", "value": "1"},
    {"action": "set_debug", "field": "texture_log", "value": "1"},
    {"action": "set_debug", "field": "merged_wall_mode", "value": "0"},
    {"action": "set_debug", "field": "merged_wall_force_two_pass", "value": "0"},

    {"action": "set_debug", "field": "merged_wall_experiment", "value": "0"},
    {"action": "face_view", "segment": 83, "side": 1, "face": 0, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s1_f0_default", "timeout_ms": 2000},
    {"action": "set_debug", "field": "merged_wall_experiment", "value": "10"},
    {"action": "face_view", "segment": 83, "side": 1, "face": 0, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s1_f0_legacy", "timeout_ms": 2000},
    // REGRESSION: cached-merge path must render the same overlay position
    // as the legacy CPU merge path. Before the base_v FBO-orientation fix
    // this face showed a visible U-mirror between the two routes.
    // The 8x8 hot-centroid is too coarse on its own for this symmetric
    // overlay, so we rely primarily on the per-cell SAD of the rendered
    // grids. Pre-fix SAD on this face is large because overlay pixels
    // shift by a texel cluster; post-fix it settles to small filter noise.
    {"action": "assert_probe_match",
     "labels": ["room_s1_f0_default", "room_s1_f0_legacy"],
     "hot_xy_tolerance": 0.05,
     "max_mean_luma_diff": 20.0},

    // NOTE: seg 83/4/0 and 83/4/1 have a second, route-independent shift
    // that is NOT the FBO Y-flip (tracked as P1/P2 in the plan doc). Both
    // pre-fix and post-fix show ~0.06 hot_xy gap between routes on these
    // faces, so we do not assert equality for them until that second
    // cause is isolated. They are still probed so the debuglog keeps an
    // evidence trail for follow-up investigations.
    {"action": "set_debug", "field": "merged_wall_experiment", "value": "0"},
    {"action": "face_view", "segment": 83, "side": 4, "face": 0, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s4_f0_default", "timeout_ms": 2000},
    {"action": "set_debug", "field": "merged_wall_experiment", "value": "10"},
    {"action": "face_view", "segment": 83, "side": 4, "face": 0, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s4_f0_legacy", "timeout_ms": 2000},

    {"action": "set_debug", "field": "merged_wall_experiment", "value": "0"},
    {"action": "face_view", "segment": 83, "side": 4, "face": 1, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s4_f1_default", "timeout_ms": 2000},
    {"action": "set_debug", "field": "merged_wall_experiment", "value": "10"},
    {"action": "face_view", "segment": 83, "side": 4, "face": 1, "distance": 6.0, "post_delay_ms": 250},
    {"action": "probe_crosshair", "label": "room_s4_f1_legacy", "timeout_ms": 2000},

    {"action": "set_debug", "field": "merged_wall_experiment", "value": "0"},
    {"action": "log", "message": "=== TEST: D1 level 1 current-room merged wall probe -- PASS ==="},
    {"action": "introspect"}
]