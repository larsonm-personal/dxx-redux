[
    {
        "_info": {
            "games": [
                "d2"
            ],
            "_standalone": false,
            "_owner": "test_lan"
        }
    },
    {
        "action": "trigger_levelcomplete"
    },
    {
        "action": "wait_for",
        "timeout_ms": 2000,
        "expect": {
            "coop_endgame.active": true,
            "coop_endgame.released": false
        }
    },
    {
        "action": "wait_for",
        "timeout_ms": 30000,
        "expect": {
            "postlevel_active": true,
            "coop_endgame.released": true,
            "screen_advance_can_activate": true
        }
    },
    {
        "action": "request_screen_advance",
        "generation": "current"
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "in_game": false,
            "time_paused": false,
            "coop_endgame.active": false,
            "menu.items[0].text": "New game"
        }
    }
]
