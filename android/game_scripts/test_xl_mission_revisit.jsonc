// Derived 1->3->1->3 disk caches, independent world state and full checkpoint
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_xl_pog_runtime" } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_start" },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    { "action": "wait_for", "expect": { "in_game": true, "xl_pilot.runtime_active": true }, "timeout_ms": 30000 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_capture" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_gpu" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_leave" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_gpu" },
    { "action": "assert", "expect": { "xl_pog.revisit_level": 3, "xl_pog.revisit_exits": 1 } },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_return" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_gpu" },
    { "action": "assert", "expect": { "xl_pog.revisit_level": 1, "xl_pog.revisit_exits": 2 } },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_leave" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_gpu" },
    { "action": "assert", "expect": { "xl_pog.revisit_level": 3, "xl_pog.revisit_exits": 3 } },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_save" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_load" },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_gpu" },
    { "action": "set_debug", "field": "android_game_request", "value": "resume" },
    { "action": "wait_for", "expect": { "time_paused": false }, "timeout_ms": 20000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "revisit_death" },
    { "action": "assert", "expect": { "xl_pog.revisit_level": 1, "xl_pog.revisit_deaths": 1 } },
    { "action": "introspect" },
]
