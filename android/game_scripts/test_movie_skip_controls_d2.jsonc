            {
                "x": 300,
                "action": "down",
                "y": 300,
            },
            {
                "x": 300,
                "action": "up",
                "y": 300,
            },
        ],
    },
    {
        "expect": {
            "movie.current": "pla.mve",
        },
        "action": "assert",
    },
    {
        "post_delay_ms": 500,
        "key": "pause",
        "action": "key",
    },
    {
        "expect": {
            "movie.pause_window": true,
        },
        "action": "assert",
    },
    {
        "action": "controller_input",
