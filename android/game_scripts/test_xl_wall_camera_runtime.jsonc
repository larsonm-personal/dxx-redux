[
    { "_info": { "_standalone": false, "_owner": "test_xl_trigger_flags_runtime", "games": ["d2"] } },
    { "action": "enter_game", "game": "d2" },
    { "action": "skip_intro", "timeout_ms": 30000 },
    { "action": "select", "text": "player", "timeout_ms": 15000 },
    { "action": "select", "text": "New game", "timeout_ms": 15000 },
    { "action": "select_mission", "text": "XL: XL camera wall controls", "timeout_ms": 15000 },
    { "action": "select", "text": "Hotshot", "timeout_ms": 15000 },
    { "action": "skip_briefing", "timeout_ms": 30000 },
    { "action": "wait_for", "expect": { "in_game": true, "xl_pilot.runtime_active": true }, "timeout_ms": 30000 },
    { "action": "set_debug", "field": "robots_suspended", "value": "true" },
    { "action": "set_debug", "field": "fire_trigger", "value": "1" },
    {
        "action": "wait_for",
        "expect": { "xl_pilot.wall_triggers.1.flags": 6, "xl_pilot.wall_triggers.1.type": 16 },
        "timeout_ms": 10000,
    },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_save" },
    { "action": "wait_ms", "ms": 1000 },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 10000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "wall_camera_monitor" },
    { "action": "assert", "expect": { "xl_pog.passed": true } },
    { "action": "set_debug", "field": "android_game_request", "value": "quick_load" },
    { "action": "wait_ms", "ms": 1000 },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.runtime_active": true,
            "xl_pilot.wall_triggers.1.flags": 6,
            "xl_pilot.wall_triggers.1.type": 16,
        },
        "timeout_ms": 30000,
    },
    { "action": "set_debug", "field": "android_game_request", "value": "overlay_pause" },
    { "action": "wait_for", "expect": { "time_paused": true }, "timeout_ms": 10000 },
    { "action": "set_debug", "field": "xl_pog_probe", "value": "wall_camera_monitor" },
    { "action": "assert", "expect": { "xl_pog.passed": true } },
]
