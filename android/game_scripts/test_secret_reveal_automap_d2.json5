// TEST: Secret reveal automap diagnostics
// Launches D2 level 1, opens the automap, enables the automation-only
// secret reveal flag, and verifies the automap is receiving drawable secret
// labels/edges.
[
    {"_info": {
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "tap_button", "text": "Descent 2", "post_delay_ms": 1000},
    {"action": "tap_button", "text": "Launch Descent 2", "launches_game": true},

    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Counterstrike", "optional": true, "post_delay_ms": 100, "timeout_ms": 1000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {
        "secret_areas.enabled": "true",
        "secret_areas.total": {"gt": 0},
        "secret_areas.reveal_unfound": "false"
    }},

    {"action": "key", "key": "tab", "post_delay_ms": 100},
    {"action": "wait_for", "field": "automap_active", "value": "true", "timeout_ms": 5000},
    {"action": "set_secret_reveal", "enabled": true, "post_delay_ms": 100},
    {"action": "wait_ms", "ms": 300},
    {"action": "introspect"},
    {"action": "assert", "expect": {
        "secret_areas.reveal_unfound": "true",
        "secret_areas.drawable_label_count": {"gt": 0},
        "secret_areas.drawable_segment_count": {"gt": 0},
        "automap.secret_reveal_unfound": "true",
        "automap.secret_edge_count": {"gt": 0},
        "automap.secret_visible_edge_count": {"gt": 0},
        "automap.secret_label_candidate_count": {"gt": 0}
    }},
    {"action": "log", "message": "=== Secret reveal automap diagnostics verified ==="}
]
