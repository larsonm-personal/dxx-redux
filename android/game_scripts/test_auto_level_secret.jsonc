// Owned by test_auto_level_demos.ps1
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_auto_level_demos",
            "games": ["d2"],
            "vars": {
                "d2": {
                    "MISSION": "Counterstrike",
                    "GAME_NUM": "2",
                    "GAME": "d2",
                    "DIAGNOSTICS_WHEN": "skip",
                },
            },
            "_deps": [
                {
                    "file": "descent2.hog",
                    "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703",
                },
                {
                    "file": "descent2.ham",
                    "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d",
                },
                {
                    "file": "groupa.pig",
                    "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b",
                },
                {
                    "file": "descent2.s22",
                    "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728",
                },
                {
                    "file": "alien1.pig",
                    "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233",
                },
                {
                    "file": "alien2.pig",
                    "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055",
                },
                {
                    "file": "fire.pig",
                    "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156",
                },
                {
                    "file": "ice.pig",
                    "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1",
                },
                {
                    "file": "water.pig",
                    "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1",
                },
            ],
            "description": "Record a fresh secret level and skip automatic recording of restored base/secret worlds",
            "params": {
                "MISSION_MODE": {
                    "label": "Campaign rules",
                    "options": {
                        "native": {},
                    },
                },
                "DIAGNOSTICS": {
                    "label": "Diagnostic snapshots",
                    "options": {
                        "off": {
                            "DIAGNOSTICS_WHEN": "skip",
                        },
                        "on": {
                            "DIAGNOSTICS_WHEN": "",
                        },
                    },
                },
            },
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "reset_state",
    },
    {
        "action": "write_config",
        "file": "graphics_safety.json",
        "content": "{\n  \"accepted\": {\n    \"TexFilt\": 0,\n    \"AnisoLevel\": 0,\n    \"MsaaLevel\": 0,\n    \"MenuTexFilt\": 0,\n    \"HudTexFilt\": 0,\n    \"ResolutionX\": 640,\n    \"ResolutionY\": 480,\n    \"AspectX\": 3,\n    \"AspectY\": 4,\n    \"ColorDepth\": 0\n  },\n  \"attempt\": null,\n  \"pending\": {}\n}\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "action": "write_config",
        "file": "descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\n",
    },
    {
        "action": "write_config",
        "file": "d1x-redux/descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\n",
    },
    {
        "action": "write_config",
        "file": "d2x-redux/descent.cfg",
        "content": "TexFilt=0\nAnisoLevel=0\nMsaaLevel=0\nResolutionX=640\nResolutionY=480\n",
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "demo_record_each_level",
            "value": true,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "demo_record_per_frame_state",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "when": "${DIAGNOSTICS_WHEN}",
        "args": {
            "key": "demo_record_per_frame_state",
            "value": true,
        },
    },
    // General gameplay recordings use the repository's Original-routing policy
    {
        "action": "setup_command",
        "command": "write_engine_prefs",
        "when": "d2",
        "args": { "guidebot_routing_mode": 0 },
        "post_delay_ms": 250,
    },
    {
        "action": "enter_game",
        "game": "d1",
        "when": "d1",
    },
    {
        "action": "enter_game",
        "game": "${GAME}",
        "when": "d2",
    },
    {
        "action": "wait_for",
        "field": "intro_active",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "New game",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Rookie",
        "post_delay_ms": 100,
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 100,
    },
    {
        "action": "skip_briefing",
        "when": "d2",
        "timeout_ms": 10000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "wait_for",
        "timeout_ms": 10000,
        "expect": {
            "graphics_safety.phase": "idle",
        },
    },
    {
        "action": "wait_for",
        "expect": {
            "input_demo.recording": "true",
            "input_demo.frame_count": {
                "gte": 1,
            },
        },
        "timeout_ms": 5000,
    },
    {
        "action": "send_button",
        "button": 100,
        "held": 1,
    },
    {
        "action": "send_axis",
        "axis": 0,
        "axis_value": 0.15,
    },
    {
        "action": "wait_for",
        "expect": {
            "input_demo.frame_count": {
                "gte": 45,
            },
        },
        "timeout_ms": 60000,
    },
    {
        "action": "send_button",
        "button": 100,
        "held": 0,
        "pressed": 0,
    },
    {
        "action": "send_axis",
        "axis": 0,
        "axis_value": 0,
    },
    {
        "action": "meta_action",
        "id": 1034,
        "post_delay_ms": 300,
    },
    {
        "action": "assert",
        "expect": {
            "input_demo.recording": "false",
            "in_game": "true",
        },
    },
    {
        "action": "set_debug",
        "field": "level_demo_inventory",
        "value": "1",
    },
    {
        "action": "set_debug",
        "field": "level_demo_secret",
        "value": "prepare",
    },
    {
        "action": "wait_for",
        "expect": {
            "current_level_num": {
                "gt": 0,
            },
            "input_demo.recording": false,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "set_debug",
        "field": "level_demo_secret",
        "value": "enter",
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 30000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "expect": {
            "current_level_num": -1,
            "input_demo.recording": true,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "send_button",
        "button": 100,
        "held": 1,
    },
    {
        "action": "wait_for",
        "expect": {
            "input_demo.frame_count": {
                "gte": 60,
            },
        },
        "timeout_ms": 60000,
    },
    {
        "action": "send_button",
        "button": 100,
        "held": 0,
        "pressed": 0,
    },
    {
        "action": "set_debug",
        "field": "level_demo_secret",
        "value": "exit",
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 30000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "expect": {
            "current_level_num": {
                "gt": 0,
            },
            "input_demo.recording": false,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "set_debug",
        "field": "level_demo_secret",
        "value": "enter",
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 30000,
        "post_delay_ms": 100,
    },
    {
        "action": "wait_for",
        "expect": {
            "current_level_num": -1,
            "input_demo.recording": false,
            "game_window_is_front": true,
        },
        "timeout_ms": 30000,
    },
    {
        "action": "wait_ms",
        "ms": 500,
    },
    {
        "action": "assert",
        "expect": {
            "input_demo.recording": false,
        },
    },
    {
        "action": "enter_launcher",
    },
    {
        "action": "wait_for",
        "field": "staged_input_demo_count",
        "value": "2",
        "timeout_ms": 30000,
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "demo_record_each_level",
            "value": false,
        },
    },
]
