// TEST HELPER: Request creation as a client, then exercise the mapped robot
[
    {"_info": {"games": ["d2"], "_standalone": false, "_owner": "test_lan"}},
    {"action": "set_debug", "field": "coop_travel_test", "value": "arm_campaign"},
    {"action": "wait_for", "timeout_ms": 15000, "expect": {"coop_travel.known": true}},
    {"action": "wait_ms", "ms": 1500},
    {"action": "set_debug", "field": "coop_travel_test", "value": "secret"},
    {"action": "wait_for", "timeout_ms": 180000, "expect": {
        "current_level_num": "-2", "coop_travel.active": false,
        "coop_restore.transfer_busy": false, "time_paused": false, "in_game": true
    }},
    {"action": "assert", "expect": {"guidebot.companion_count": "0", "guidebot.owner_player": "-1"}},
    {"action": "wait_ms", "ms": 1500},
    {"action": "meta_action", "id": 1037, "post_delay_ms": 100},
    {"action": "meta_action", "id": 1037, "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 20000, "expect": {
        "guidebot.companion_count": "1", "guidebot.released": "true", "guidebot.owner_player": "1",
        "guidebot.remote_owner": "1", "guidebot.local_control_slot_matches": "true"
    }},
    {"action": "wait_ms", "ms": 2000},
    {"action": "meta_action", "id": 1042, "post_delay_ms": 200},
    {"action": "meta_action", "id": 1045, "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 30000, "expect": {
        "guidebot.docked": "true", "guidebot.companion_count": "1", "guidebot.owner_player": "1"
    }},
    {"action": "wait_ms", "ms": 2000},
    {"action": "meta_action", "id": 1037, "post_delay_ms": 100},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {
        "guidebot.companion_count": "1", "guidebot.released": "true", "guidebot.docked": "false",
        "guidebot.owner_player": "1", "guidebot.remote_owner": "1", "guidebot.local_control_slot_matches": "true"
    }},
    {"action": "log", "message": "Missing Guide-Bot deployment: client PASS"}
]
