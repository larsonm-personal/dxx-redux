    {
        "action": "enter_launcher",
    },
    {
        "action": "setup_command",
        "command": "create_set",
        "args": {
            "name": "${SET}",
        },
    },
    {
        "action": "setup_command",
        "command": "switch_set",
        "args": {
            "name": "${SET}",
        },
        "post_delay_ms": 500,
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "show_resume_offer",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "skip_intro_movie",
            "value": false,
        },
    },
    {
        "action": "setup_command",
        "command": "write_bool_pref",
        "args": {
            "key": "dlog_game logs_enabled",
            "value": true,
        },
    },
    {
        "command": "delete_mod",
        "action": "setup_command",
        "post_delay_ms": 250,
        "args": {
            "filename": "${FIRST}",
        },
    },
    {
        "command": "delete_mod",
        "action": "setup_command",
        "post_delay_ms": 250,
        "args": {
            "filename": "${SECOND}",
        },
    },
    {
        "command": "delete_mod",
        "action": "setup_command",
        "post_delay_ms": 250,
        "args": {
            "filename": "${SOUND}",
        },
    },
    {
        "command": "delete_mod",
        "action": "setup_command",
        "post_delay_ms": 250,
        "args": {
            "filename": "d1xr-hires.dxa",
        },
    },
    {
        "command": "${FIRST_COMMAND}",
        "action": "setup_command",
        "post_delay_ms": 500,
        "args": {
            "filename": "${FIRST}",
            "path": "uud-import/${FIRST}",
        },
    },
    {
        "command": "${SECOND_COMMAND}",
        "action": "setup_command",
        "post_delay_ms": 500,
        "args": {
            "filename": "${SECOND}",
            "path": "uud-import/${SECOND}",
        },
    },
    {
        "command": "${EXTRAS_COMMAND}",
        "action": "setup_command",
        "post_delay_ms": 500,
        "args": {
            "filename": "${SOUND}",
            "path": "uud-import/${SOUND}",
        },
    },
    {
        "command": "${EXTRAS_COMMAND}",
        "action": "setup_command",
        "post_delay_ms": 500,
        "args": {
            "filename": "d1xr-hires.dxa",
            "path": "uud-import/d1xr-hires.dxa",
        },
    },
    {
        "action": "enter_game",
        "game": "${MODE}",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "optional": true,
        "timeout_ms": 3000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 5000,
        "optional": true,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 5000,
        "when": "d2",
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 200,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 30000,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "lctrl",
        "post_delay_ms": 1500,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 10000,
    },
    {
        "action": "wait_for",
        "field": "current_level_num",
        "value": "0",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "${MISSION}",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "escape",
        "when": "d1",
        "post_delay_ms": 200,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 60000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 30000,
    },
    {
        "action": "wait_for",
        "field": "game_window_is_front",
        "value": "true",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "lctrl",
        "post_delay_ms": 1500,
    },
    {
        "action": "assert",
        "expect": {
            "in_game": "true",
            "current_level_num": "1",
        },
    },
    {
        "action": "introspect",
        "post_delay_ms": 1500,
    },
