            "params": {
                "MODE": {
                    "options": {
                        "d1": {
                            "MISSION": "First Strike",
                            "SET": "uud-verification",
                        },
                        "d2": {
                            "MISSION": "Counterstrike",
                            "SET": "uud-verification",
                        },
                        "d1-in-d2": {
                            "MISSION": "First Strike",
                            "SET": "uud-verification",
                        },
                    },
                },
                "FIRST": {
                    "default": "",
                },
                "SECOND": {
                    "default": "",
                },
                "SOUND": {
                    "default": "",
                },
                "FIRST_COMMAND": {
                    "default": "",
                },
                "SECOND_COMMAND": {
                    "default": "",
                },
                "EXTRAS_COMMAND": {
                    "default": "",
                },
            },
