// Controlled door triggers, collision/visibility and persistence; respects the 750 ms trigger debounce
[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_doorway_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL doorways",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 15000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
        "post_delay_ms": 100,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.doorways.0.type": 2,
            "xl_pilot.doorways.0.state": 0,
            "xl_pilot.doorways.2.type": 7,
            "xl_pilot.doorways.2.player_flags": 22,
            "xl_pilot.doorways.2.visibility_flags": 22,
            "xl_pilot.doorways.4.type": 0,
            "xl_pilot.doorways.4.flags": 2,
        },
    },
    {
        "action": "face_view",
        "segment": 15,
        "side": 2,
        "distance": 8,
        "post_delay_ms": 100,
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": -0.5,
        "post_delay_ms": 800,
    },
    {
        "action": "assert",
        "expect": {
            "position.segment": 15,
            "throttle_time": {
                "gt": 0,
            },
        },
    },
    {
        "action": "send_axis",
        "axis": 1,
        "axis_value": 0,
        "post_delay_ms": 0,
    },
    {
        "action": "face_view",
