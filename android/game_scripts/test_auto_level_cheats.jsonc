            "description": "Record weapon cheat activation and refills with independent next-level replay",
            "params": {
                "MISSION_MODE": {
                    "label": "Campaign rules",
                    "options": {
                        "native": {},
                        "d1-in-d2": {
                            "MISSION": "First Strike",
                            "GAME": "d1-in-d2",
                            "D2_WEAPONS_WHEN": "skip",
