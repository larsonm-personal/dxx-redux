        "timeout_ms": 20000,
        "post_delay_ms": 200,
    },
    {
        "action": "wait_for",
        "field": "screen_mode",
        "value": "menu",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "when": "d2",
        "post_delay_ms": 100,
        "timeout_ms": 5000,
    },
    {
        "action": "key",
        "key": "enter",
        "when": "d1",
        "post_delay_ms": 100,
