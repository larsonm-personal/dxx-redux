                            "MEGA_WHEN": "${D1_RETAIL_WHEN}",
                        },
                    },
                },
                "DIAGNOSTICS": {
                    "label": "Diagnostic snapshots",
                    "options": {
                        "off": {
                            "DIAGNOSTICS_WHEN": "skip",
                        },
                        "on": {
                            "DIAGNOSTICS_WHEN": "",
                        },
