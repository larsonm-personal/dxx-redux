// TEST: KCXF2 level 5 guidebot "next" passively guides a player-fired switch.
[
    {"_info": {
        "games": ["d2"],
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "kcxf2rmv11.7z", "sha256": "c2aa754df2462376cd77b7afb75125c0096ba04f870fcff4d41182995762848f", "target": "files/mission_zip_batch_cache"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "clear_mods"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "clear_crash_reports", "post_delay_ms": 250},
    {"action": "import_mission_zip", "file": "kcxf2rmv11.7z", "label": "kcxf2_guidebot", "display_name": "KCXF2RMv11.7z"},
    {"action": "analyze_level_metadata_all", "label": "kcxf2_guidebot", "mod_file": "KCXF2RMv11.7z", "game": "d2", "status": "ok", "min_total_levels": 6},
    {"action": "tap_button", "text": "Descent 2", "post_delay_ms": 0},
    {"action": "tap_button", "text": "Launch Descent 2", "launches_game": true},

    {"action": "log", "message": "=== TEST: KCXF2 guidebot route next ==="},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000, "optional": true},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "assert", "expect": {"menu.items": {"contains": "Project KCX-F2"}}},
    {"action": "select_mission", "text": "Project KCX-F2", "post_delay_ms": 100, "timeout_ms": 10000},

    {"action": "wait_ms", "ms": 300},
    {"action": "key", "key": "backspace", "post_delay_ms": 100},
    {"action": "key", "key": "5", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 10000, "optional": true},
    {"action": "skip_briefing", "timeout_ms": 60000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "5"}},

    {"action": "set_debug", "field": "clear_robots", "value": "true", "post_delay_ms": 100},
    {"action": "meta_action", "id": 1037, "post_delay_ms": 500},
    {"action": "meta_action", "id": 1041, "post_delay_ms": 500},
    {"action": "wait_for", "timeout_ms": 60000, "expect": {
        "level_metadata_route.status": "ok",
        "guidebot.released": "true",
        "guidebot.buddy_objnum": {"gte": 0},
        "guidebot.route_status": "ok",
        "guidebot.route_start_matches_buddy": "true",
        "guidebot.route_goal_active": "true",
        "guidebot.route_goal_label": {"contains": "blue key"},
        "guidebot.route_goal_objective_kind": "1",
        "guidebot.route_goal_activation_kind_name": "pickup_key",
        "guidebot.route_goal_objective_seg": "735",
        "guidebot.route_goal_guidance_mode_name": "reach_objective",
        "guidebot.route_goal_guidance_seg": "735",
        "guidebot.route_goal_path_endpoint_seg": "735"
    }},

    {"action": "set_debug", "field": "player_keys", "value": "blue", "post_delay_ms": 100},
    {"action": "meta_action", "id": 1041, "post_delay_ms": 500},
    {"action": "wait_for", "timeout_ms": 20000, "expect": {
        "player.has_blue_key": "true",
        "guidebot.route_status": "ok",
        "guidebot.route_start_matches_buddy": "true",
        "guidebot.route_goal_active": "true",
        "guidebot.route_goal_label": {"contains": "trigger 6"},
        "guidebot.route_goal_objective_kind": "2",
        "guidebot.route_goal_activation_kind_name": "shoot_switch",
        "guidebot.route_goal_objective_trigger": "6",
        "guidebot.route_goal_objective_wall": "8",
        "guidebot.route_goal_instruction": {"contains": "shoot the marked switch"},
        "guidebot.route_goal_activation_pos[0]": {"range": [-10000, 10000]},
        "guidebot.route_goal_aim_pos[0]": {"range": [-10000, 10000]},
        "guidebot.route_goal_guidance_mode_name": "reach_firing_position",
        "guidebot.route_goal_guidance_seg": {"gte": 0},
        "guidebot.route_goal_path_endpoint_seg": {"gte": 0},
        "guidebot.route_goal_satisfied": "false",
        "guidebot.route_goal_linked_walls_passable": "false"
    }},

    // Guide-Bot may move and use its classic generic flares, but it must not
    // complete the pending switch objective while the player waits.
    {"action": "wait_ms", "ms": 3000},
    {"action": "assert", "expect": {
        "guidebot.route_goal_objective_trigger": "6",
        "guidebot.route_goal_satisfied": "false",
        "guidebot.route_goal_linked_walls_passable": "false"
    }},

    // Use the shared planner's exact player pose and target, then fire through
    // normal controls. This is a player action, not a debug trigger mutation.
    {"action": "pose_route_guidance", "post_delay_ms": 250},
    {"action": "send_button", "button": 100, "held": 1},
    {"action": "wait_ms", "ms": 3000},
    {"action": "send_button", "button": 100, "pressed": 0},
    {"action": "wait_for", "timeout_ms": 20000, "expect": {
        "guidebot.route_last_replan_reason": "player_completed_waypoint",
        "guidebot.route_status": "ok",
        "guidebot.route_start_matches_buddy": "true",
        "guidebot.route_goal_active": "true",
        "guidebot.route_goal_label": {"contains": "red key"},
        "guidebot.route_goal_objective_kind": "1",
        "guidebot.route_goal_activation_kind_name": "pickup_key",
        "guidebot.route_goal_objective_trigger": {"ne": 6},
        "guidebot.route_goal_path_endpoint_seg": {"gte": 0}
    }},

    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: KCXF2 guidebot route next -- PASS ==="}
]
