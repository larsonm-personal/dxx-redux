[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_object_chain_delays_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
        "post_delay_ms": 500,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived delayed events",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "face_view",
        "segment": 3,
        "side": 0,
        "distance": 5,
        "post_delay_ms": 150,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.wall_triggers.0.operated": false,
            "player.shields": {
                "range": [100, 100],
            },
            "player.energy": {
                "range": [100, 100],
            },
        },
    },
    {
        "action": "set_debug",
        "field": "object_damage",
        "value": "49 200 local",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.wall_triggers.0.operated": true,
            "xl_pilot.wall_triggers.0.attached_context": true,
            "xl_pilot.wall_triggers.0.actor": 49,
            "xl_pilot.wall_triggers.0.delay_ms": 20000,
            "xl_pilot.wall_triggers.0.actor_signature": {
                "range": [1, 1000],
            },
            "xl_pilot.wall_triggers.1.operated": false,
            "player.shields": {
                "range": [100, 100],
            },
            "player.energy": {
                "range": [100, 100],
            },
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "wait_for",
        "expect": {
            "checkpoints.pending": 0,
            "checkpoints.failed": 0,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.wall_triggers.0.operated": true,
            "xl_pilot.wall_triggers.0.attached_context": true,
            "xl_pilot.wall_triggers.0.actor": 49,
            "xl_pilot.wall_triggers.0.delay_ms": 20000,
            "xl_pilot.wall_triggers.0.actor_signature": {
                "range": [1, 1000],
            },
            "xl_pilot.wall_triggers.1.operated": false,
            "player.shields": {
                "range": [100, 100],
            },
            "player.energy": {
                "range": [100, 100],
            },
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_save",
    },
    {
        "action": "wait_ms",
        "ms": 1000,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 5000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": false,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "Counterstrike",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "expect": {
            "in_game": true,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": false,
            "xl_pilot.runtime_active": false,
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
