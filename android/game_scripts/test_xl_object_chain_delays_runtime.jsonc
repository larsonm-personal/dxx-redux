            "player.energy": {
                "range": [95, 95],
            },
            "xl_pilot.wall_triggers.0.operated": false,
            "xl_pilot.wall_triggers.1.type": 6,
            "xl_pilot.wall_triggers.1.flags": 24,
            "xl_pilot.wall_triggers.2.operated": false,
            "xl_pilot.wall_triggers.2.object_destination": 0,
            "xl_pilot.wall_triggers.3.operated": false,
            "xl_pilot.wall_triggers.4.operated": false,
            "xl_pilot.wall_triggers.5.operated": false,
