// TEST: D-pad and Trigger Button Mapping Regression
// Verifies that D-pad/slide button presses and trigger axis-buttons reach
// the correct game controls on a fresh pilot with default bindings.
//
// Phase 1: D-pad/Slide -- send MIXER_BTN_BASE + kc_index for each slide
//          direction and verify the correct control timing value becomes
//          nonzero.  (In the mixer architecture, D-pad buttons are dispatched
//          through Kotlin InputMixer as MIXER_BTN_BASE + kc_joystick_index.)
// Phase 2: Triggers -- send LT/RT axis values and verify the correct
//          thrust timing (forward/reverse) becomes nonzero via axis-button
//          threshold detection in C.
// Phase 3: Button defaults -- static assertions that the fresh-pilot
//          controller_config.json wrote game-correct MIXER_BTN_BASE + kc_index
//          identity values for all col1 button slots.
//
// Root causes this catches:
//   1. D-pad button_map[] not set: joy_button_handler() maps button 22-25
//      to button 0 (Fire Primary) because button_map[22] is zero.
//   2. joy_axisbutton_handler() backwards: positive axis fires base button
//      instead of base+1, so trigger config values 19/21 never match.
//   3. Trigger defaults wrong: hardcoded as 18/20 (negative) instead of
//      19/21 (positive).
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike", "GAME_NUM": "1"},
            "d2": {"MISSION": "Counterstrike", "GAME_NUM": "2"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // -- Launcher preamble --
    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "tap_button", "text": "Descent ${GAME_NUM}", "post_delay_ms": 0},
    {"action": "tap_button", "text": "Launch Descent ${GAME_NUM}", "launches_game": true},

    {"action": "log", "message": "=== TEST: D-pad and Trigger Button Mapping ==="},

    // -- Create fresh pilot and launch into game --
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},

    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    // ── Phase 1: D-pad buttons ──────────────────────────────────────────
    // Pattern: hold button -> wait for kconfig to process -> assert -> release

    // In the mixer architecture, D-pad buttons go through Kotlin InputMixer.
    // send_button injects at the SDL/C level, so we use MIXER_BTN_BASE + kc_index.
    // MIXER_BTN_BASE = 100.  kc indices: Slide Up=8, Down=9, Left=6, Right=7.

    // 1a: Slide Up (kc=8, button 108) should cause vertical_thrust_time != 0
    {"action": "log", "message": "Phase 1a: Slide Up (button 108) -> Slide Up"},
    {"action": "send_button", "button": 108, "held": 1},
    {"action": "wait_ms", "ms": 300},
    {"action": "assert", "expect": {
        "slide_ud_time": {"ne": 0}
    }},
    {"action": "send_button", "button": 108, "pressed": 0},
    {"action": "log", "message": "Phase 1a: PASS -- Slide Up drives slide up"},
    {"action": "wait_ms", "ms": 200},

    // 1b: Slide Down (kc=9, button 109)
    {"action": "log", "message": "Phase 1b: Slide Down (button 109) -> Slide Down"},
    {"action": "send_button", "button": 109, "held": 1},
    {"action": "wait_ms", "ms": 300},
    {"action": "assert", "expect": {
        "slide_ud_time": {"ne": 0}
    }},
    {"action": "send_button", "button": 109, "pressed": 0},
    {"action": "log", "message": "Phase 1b: PASS -- Slide Down drives slide down"},
    {"action": "wait_ms", "ms": 200},

    // 1c: Slide Left (kc=6, button 106)
    {"action": "log", "message": "Phase 1c: Slide Left (button 106) -> Slide Left"},
    {"action": "send_button", "button": 106, "held": 1},
    {"action": "wait_ms", "ms": 300},
    {"action": "assert", "expect": {
        "slide_lr_time": {"ne": 0}
    }},
    {"action": "send_button", "button": 106, "pressed": 0},
    {"action": "log", "message": "Phase 1c: PASS -- Slide Left drives slide left"},
    {"action": "wait_ms", "ms": 200},

    // 1d: Slide Right (kc=7, button 107)
    {"action": "log", "message": "Phase 1d: Slide Right (button 107) -> Slide Right"},
    {"action": "send_button", "button": 107, "held": 1},
    {"action": "wait_ms", "ms": 300},
    {"action": "assert", "expect": {
        "slide_lr_time": {"ne": 0}
    }},
    {"action": "send_button", "button": 107, "pressed": 0},
    {"action": "log", "message": "Phase 1d: PASS -- Slide Right drives slide right"},
    {"action": "wait_ms", "ms": 200},

    // ── Phase 2: Trigger axis-buttons ───────────────────────────────────
    // send_axis already holds the axis value during post_delay_ms, so
    // assert BEFORE resetting to 0.

    // 2a: RT axis (axis 5, value 0.8) should fire Accelerate (+RT = button 21)
    {"action": "log", "message": "Phase 2a: RT trigger (axis 5) -> Accelerate"},
    {"action": "send_axis", "axis": 5, "axis_value": 0.8, "post_delay_ms": 500},
    {"action": "assert", "expect": {
        "throttle_time": {"ne": 0}
    }},
    {"action": "log", "message": "Phase 2a: PASS -- RT drives forward thrust"},
    {"action": "send_axis", "axis": 5, "axis_value": 0.0, "post_delay_ms": 200},
    {"action": "wait_ms", "ms": 200},

    // 2b: LT axis (axis 4, value 0.8) should fire Reverse (+LT = button 19)
    {"action": "log", "message": "Phase 2b: LT trigger (axis 4) -> Reverse"},
    {"action": "send_axis", "axis": 4, "axis_value": 0.8, "post_delay_ms": 500},
    {"action": "assert", "expect": {
        "throttle_time": {"ne": 0}
    }},
    {"action": "log", "message": "Phase 2b: PASS -- LT drives reverse thrust"},
    {"action": "send_axis", "axis": 4, "axis_value": 0.0, "post_delay_ms": 200},

    // ── Phase 3: Button binding defaults ────────────────────────────────
    // Assert that the fresh pilot has the correct button<->action mappings.
    // With identity mapping, pilot stores MIXER_BTN_BASE(100) + kc_index.
    // D1 and D2 have different kconfig index layouts, so these assertions
    // verify the game-specific byte array was used (not the wrong variant).
    //
    // D2: Fire Flare kc=4 val=104, Afterburner kc=27 val=127,
    //     CyclePri kc=28 val=128, CycleSec kc=29 val=129, Automap kc=50 val=150
    // D1: Automap kc=27 val=127, CyclePri kc=44 val=144, CycleSec kc=45 val=145

    // Fire Flare (kc=4) -- same index in both games
    {"action": "log", "message": "Phase 3: Button binding defaults"},
    {"action": "assert", "expect": {
        "joystick_controls.items[4].value": {"eq": "104"},
        "joystick_controls.items[4].name": {"eq": "Fire flare"}
    }},

    // D2-only: Afterburner(kc=27,val=127), CyclePri(kc=28,val=128),
    //          CycleSec(kc=29,val=129), Automap(kc=50,val=150)
    {"action": "assert", "when": "d2", "expect": {
        "joystick_controls.items[27].value": {"eq": "127"},
        "joystick_controls.items[27].name": {"eq": "Afterburner"},
        "joystick_controls.items[28].value": {"eq": "128"},
        "joystick_controls.items[29].value": {"eq": "129"},
        "joystick_controls.items[50].value": {"eq": "150"},
        "joystick_controls.items[50].name": {"eq": "Automap"}
    }},

    // D1-only: Automap(kc=27,val=127), CyclePri(kc=44,val=144), CycleSec(kc=45,val=145)
    {"action": "assert", "when": "d1", "expect": {
        "joystick_controls.items[27].value": {"eq": "127"},
        "joystick_controls.items[27].name": {"eq": "Automap"},
        "joystick_controls.items[44].value": {"eq": "144"},
        "joystick_controls.items[44].name": {"eq": "Cycle Primary"},
        "joystick_controls.items[45].value": {"eq": "145"},
        "joystick_controls.items[45].name": {"eq": "Cycle Secondary"}
    }},

    {"action": "log", "message": "Phase 3: PASS -- button defaults correct for game variant"},

    {"action": "log", "message": "=== TEST: D-pad and Trigger Button Mapping -- ALL PHASES PASS ==="}
]
