[
    { "_info": { "games": ["d1", "d2"], "_standalone": false, "_owner": "test_lan" } },
    { "action": "set_debug", "field": "recovery_test_trace", "value": "true" },
    { "action": "set_debug", "field": "recovery_test_inventory", "value": "laser" },
    { "action": "set_debug", "field": "recovery_test_isolate_drop", "value": "true" },
    { "action": "wait_ms", "ms": 1000 },
    { "action": "set_debug", "field": "damage_player", "value": "500" },
    {
        "action": "wait_for",
        "timeout_ms": 20000,
        "expect": { "player_dead": true, "multiplayer.recovery.world_objects": { "gte": 1 } },
    },
    { "action": "key", "key": "space" },
    { "action": "wait_for", "timeout_ms": 20000, "expect": { "player_dead": false } },
    { "action": "assert", "expect": { "player.laser_level": 0 } },
]
