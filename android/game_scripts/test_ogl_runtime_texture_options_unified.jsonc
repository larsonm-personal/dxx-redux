// TEST: Shared Android OGL runtime texture option dispatch for D1 and D2
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike", "GAME_NUM": "1"},
            "d2": {"MISSION": "Counterstrike", "GAME_NUM": "2"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "log", "message": "=== TEST: Shared OGL runtime texture options ==="},
    {"action": "reset_state"},

    // Verify button discovery and that tap_button auto-scrolls to Advanced
    // when game data makes it initially off-screen.
    {"action": "log", "message": "=== TEST: Launcher button discovery ===", "when": "d2"},
    {"action": "wait_ms", "ms": 500, "when": "d2"},
    {"action": "assert_button", "text": "About", "when": "d2"},
    {"action": "assert_button", "text": "Define Controls", "when": "d2"},
    {"action": "tap_button", "text": "About", "post_delay_ms": 500, "when": "d2"},
    {"action": "tap_button", "text": "Advanced", "post_delay_ms": 300, "when": "d2"},
    {"action": "log", "message": "Button discovery and tap test passed", "when": "d2"},
    {"action": "log", "message": "=== TEST: Launcher button discovery -- PASS ===", "when": "d2"},

    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},

    {"action": "log", "message": "=== TEST: Launcher graphics debug prefs bridge ===", "when": "d2"},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_video_info_debug_options", "value": true},
     "post_delay_ms": 250, "when": "d2"},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_graphics_enabled", "value": true}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_texture_enabled", "value": true},
     "post_delay_ms": 250, "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "debug_prefs.show_video_info_debug_options": "true",
        "debug_prefs.graphics_log_enabled": "true",
        "debug_prefs.texture_log_enabled": "true",
        "debug_prefs.graphics_debug_logging": "true"
    }},

    // D2 MSAA FBO smoke preamble. Verify the requested level at the main menu
    // and prove effective FBO creation, binding, and resolve in gameplay
    {"action": "log", "message": "=== TEST: D2 MSAA FBO smoke ===", "when": "d2"},
    {"action": "write_config", "file": "descent.cfg", "content": "MsaaLevel=2\n", "when": "d2"},
    {"action": "write_config", "file": "d2x-redux/descent.cfg", "content": "MsaaLevel=2\n", "when": "d2"},
    {"action": "enter_game", "game": "d1", "when": "d1"},
    {"action": "enter_game", "game": "d2", "when": "d2"},

    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "assert", "when": "d2", "expect": {
        "screen_mode": "menu",
        "debug_flags.texture_log": "true",
        "msaa_samples": "2"
    }},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:0", "post_delay_ms": 350},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:1", "post_delay_ms": 350},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "wait_ms", "ms": 500, "when": "d2"},
    {"action": "assert", "when": "d2",
     "expect": {
         "in_game": "true",
         "screen_mode": "game",
         "msaa_samples": "2",
         "msaa_max_samples": {"gt": 1},
         "msaa.effective_samples": {"gt": 1},
         "msaa.width": {"gt": 0},
         "msaa.height": {"gt": 0},
         "msaa.create_complete": "true",
         "msaa.last_create_status": "36053",
         "msaa.last_gl_error": "0",
         "msaa.generation": {"gt": 0},
         "msaa.bound_frame_count": {"gt": 0},
         "msaa.resolve_count": {"gt": 0},
         "msaa.last_frame_resolved": "true"
     }},
    {"action": "introspect", "when": "d2"},
    {"action": "log", "message": "=== TEST: D2 MSAA FBO smoke -- PASS ===", "when": "d2"},

    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:0", "post_delay_ms": 300},
    {"action": "set_debug", "field": "graphics_option", "value": "aniso_level:2", "post_delay_ms": 300},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:1", "post_delay_ms": 300},
    {"action": "set_debug", "field": "graphics_option", "value": "aniso_level:0", "post_delay_ms": 300},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:2", "post_delay_ms": 300},
    {"action": "set_debug", "field": "graphics_option", "value": "menu_tex_filt:0", "post_delay_ms": 200},
    {"action": "set_debug", "field": "graphics_option", "value": "hud_tex_filt:0", "post_delay_ms": 200},

    {"action": "set_debug", "field": "android_game_request", "value": "pause", "post_delay_ms": 300},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:0", "post_delay_ms": 500},
    {"action": "key", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "set_debug", "field": "graphics_option", "value": "menu_tex_filt:1", "post_delay_ms": 100},
    {"action": "set_debug", "field": "graphics_option", "value": "hud_tex_filt:1", "post_delay_ms": 100},
    {"action": "set_debug", "field": "graphics_option", "value": "tex_filt:1", "post_delay_ms": 300},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "game_window_is_front": "true"}},

    {"action": "enter_launcher"},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_video_info_debug_options", "value": false},
     "post_delay_ms": 250, "when": "d2"},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_graphics_enabled", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_texture_enabled", "value": false},
     "post_delay_ms": 250, "when": "d2"},
    {"action": "assert", "expect": {"debug_prefs.graphics_log_enabled": "false"}},
    {"action": "assert", "when": "d2", "expect": {
        "debug_prefs.show_video_info_debug_options": "false",
        "debug_prefs.graphics_log_enabled": "false",
        "debug_prefs.texture_log_enabled": "false",
        "debug_prefs.graphics_debug_logging": "false"
    }},
    {"action": "log", "message": "=== TEST: Launcher graphics debug prefs bridge -- COMPLETE ===",
     "when": "d2"},
    {"action": "log", "message": "=== TEST: Shared OGL runtime texture options -- PASS ==="}
]
