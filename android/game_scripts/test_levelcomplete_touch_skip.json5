// TEST: D2 level-complete and mine-exit paths arm the shared touch-suppress guard.
//
// Local emulator data in this workspace does not include the D2 .mve files,
// and the endlevel movie call is synchronous enough that automation resumes
// after the short active window.
[
    {"_info": {
        "games": ["d2"],
        "vars": {
            "d2": {"MISSION": "Counterstrike!"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "d2"},

    {"action": "log", "message": "=== TEST: Level-complete touch suppress and tap advance ==="},

    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "skip_briefing", "timeout_ms": 20000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},

    {"action": "send_touch_down"},
    {"action": "trigger_levelcomplete"},
    {"action": "wait_for", "field": "levelcomplete_active", "value": "true", "timeout_ms": 2000},
    {"action": "send_touch_up"},
    {"action": "wait_ms", "ms": 100},
    {"action": "assert", "expect": {"levelcomplete_active": "true", "cutscene_tap_suppress_arms": {"gte": 1}}},
    {"action": "wait_for", "field": "cutscene_tap_suppress_active", "value": "false", "timeout_ms": 2000},
    {"action": "send_touch_tap"},
    {"action": "wait_for", "field": "levelcomplete_active", "value": "false", "timeout_ms": 2000},

    {"action": "log", "message": "=== TEST: Level-complete touch suppress and tap advance -- PASS ==="},

    // Advancing the level-complete screen opens level 2's briefing. Reuse that
    // transition instead of relaunching the game for the mine-exit assertion.
    {"action": "skip_briefing", "timeout_ms": 20000, "post_delay_ms": 100},
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "log", "message": "=== TEST: Post-level held touch and fresh tap ==="},
    {"action": "send_touch_down"},
    {"action": "trigger_postlevel"},
    {"action": "wait_for", "field": "postlevel_active", "value": "true", "timeout_ms": 2000},
    {"action": "send_touch_up"},
    {"action": "wait_ms", "ms": 100},
    {"action": "assert", "expect": {"postlevel_active": "true", "cutscene_tap_suppress_arms": {"gte": 2}}},
    {"action": "wait_for", "field": "cutscene_tap_suppress_active", "value": "false", "timeout_ms": 2000},
    {"action": "send_touch_tap"},
    {"action": "wait_for", "field": "postlevel_active", "value": "false", "timeout_ms": 2000},
    {"action": "log", "message": "=== TEST: Post-level held touch and fresh tap -- PASS ==="},

    {"action": "log", "message": "=== TEST: Post-level held controller A and fresh A ==="},
    {"action": "send_button", "button": 0, "held": 1, "post_delay_ms": 50},
    {"action": "trigger_postlevel"},
    {"action": "wait_for", "field": "postlevel_active", "value": "true", "timeout_ms": 2000},
    {"action": "send_button", "button": 0, "pressed": 0, "post_delay_ms": 50},
    {"action": "wait_ms", "ms": 100},
    {"action": "assert", "expect": {"postlevel_active": "true", "cutscene_tap_suppress_arms": {"gte": 3}}},
    {"action": "wait_for", "field": "cutscene_tap_suppress_active", "value": "false", "timeout_ms": 2000},
    {"action": "send_button", "button": 0, "post_delay_ms": 50},
    {"action": "wait_for", "field": "postlevel_active", "value": "false", "timeout_ms": 2000},
    {"action": "log", "message": "=== TEST: Post-level held controller A and fresh A -- PASS ==="},

    {"action": "log", "message": "=== TEST: Post-level generation-tagged overlay request ==="},
    {"action": "trigger_postlevel"},
    {"action": "wait_for", "field": "screen_advance_kind", "value": "postlevel", "timeout_ms": 2000},
    {"action": "wait_for", "field": "screen_advance_can_activate", "value": "true", "timeout_ms": 2000},
    {"action": "request_screen_advance", "generation": "previous"},
    {"action": "wait_ms", "ms": 100},
    {"action": "assert", "expect": {"screen_advance_kind": "postlevel"}},
    {"action": "request_screen_advance", "generation": "current"},
    {"action": "wait_for", "field": "screen_advance_kind", "value": "none", "timeout_ms": 2000},
    {"action": "log", "message": "=== TEST: Post-level generation-tagged overlay request -- PASS ==="},

    {"action": "log", "message": "=== TEST: End-level held touch and fresh tap ==="},
    {"action": "send_touch_down"},
    {"action": "trigger_endlevel"},
    {"action": "wait_for", "field": "screen_advance_kind", "value": "endlevel", "timeout_ms": 2000},
    {"action": "send_touch_up"},
    {"action": "wait_ms", "ms": 100},
    {"action": "assert", "expect": {"endlevel_sequence": {"gte": 1}, "screen_advance_kind": "endlevel"}},
    {"action": "wait_for", "field": "screen_advance_can_activate", "value": "true", "timeout_ms": 2000},
    {"action": "send_touch_tap"},
    {"action": "wait_for", "field": "endlevel_sequence", "value": "0", "timeout_ms": 2000},
    {"action": "assert", "expect": {"screen_advance_kind": "levelcomplete"}},
    {"action": "log", "message": "=== TEST: End-level held touch and fresh tap -- PASS ==="}
]
