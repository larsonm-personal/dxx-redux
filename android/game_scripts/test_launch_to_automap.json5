// TEST: Launch + Background/Resume
// Verifies normal game launch into a level, then backgrounds and
// resumes the app to verify EGL surface recreation (black screen fix).
// Parameterized for both D1 ("First Strike") and D2 ("Counterstrike").
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"MISSION": "First Strike"},
            "d2": {"MISSION": "Counterstrike"}
        }
    }},
    {"action": "log", "message": "=== TEST: Launch + Background/Resume ==="},

    {"action": "wait_ms", "ms": 2000},

    // Accept default pilot name (fresh .plr deleted by runner)
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 2000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 2000},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 1500},

    // Mission select (D2 only -- D1 has a single built-in mission)
    {"action": "wait_ms", "ms": 1000, "when": "d2"},
    {"action": "select", "text": "${MISSION}", "when": "d2", "post_delay_ms": 1500},
    // accept default level 1
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 1500},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 1500},
    // difficulty
    {"action": "wait_ms", "ms": 500},
    {"action": "select", "text": "Rookie", "post_delay_ms": 1500},

    // Skip briefing (waits for level load, then escapes if briefing is showing)
    {"action": "skip_briefing", "timeout_ms": 10000, "post_delay_ms": 2000},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "log", "message": "=== In-game verified -- testing background/resume ==="},

    // Snapshot EGL recreate count before backgrounding (typically 1 from startup)
    {"action": "introspect"},

    // Signal the test runner to background and resume the app.
    // The runner detects this marker, presses HOME, waits, then resumes.
    // Meanwhile, the game thread pauses. After resume, wait_for picks up.
    {"action": "log", "message": "SCRIPT_BACKGROUND: ready"},

    // Wait for EGL surface recreation (happens after resume).
    // The game thread is paused while backgrounded; this wait_for resumes
    // when the game thread comes back and the EGL surface is recreated.
    {"action": "wait_for", "field": "egl_recreate_count", "value": "2", "timeout_ms": 30000},

    // Allow a moment for rendering to stabilize after resume
    {"action": "wait_ms", "ms": 2000},

    // Verify the game is still running and rendering after resume
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "egl_recreate_count": {"gte": 2}
    }},

    {"action": "log", "message": "=== TEST: Launch + Background/Resume -- COMPLETE ==="},
    {"action": "introspect"}
]
