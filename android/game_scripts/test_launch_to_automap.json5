// TEST: Launch + Background/Resume + Android dormant states
// Verifies normal game launch, repeated EGL surface recreation, and the
// distinct main-menu, active-game, pause-window, and game-menu workloads.
// Parameterized for both D1 ("First Strike") and D2 ("Counterstrike").
[
    {"_info": {
        "games": ["d1", "d2"],
        "vars": {
            "d1": {"GAME": "d1", "MISSION": "First Strike", "GAME_NUM": "1", "GAME_DIR": "d1x-redux", "LEVEL": "1", "ACTIVE_CYCLE_1": "1", "ACTIVE_CYCLE_2": "2"},
            "d2": {"GAME": "d2", "MISSION": "Counterstrike", "GAME_NUM": "2", "GAME_DIR": "d2x-redux", "LEVEL": "2", "ACTIVE_CYCLE_1": "2", "ACTIVE_CYCLE_2": "3"}
        },
        "_deps": [
            {"file": "descent2.hog", "sha256": "f1abf516512739c97b43e2e93611a2398fc9f8bc7a014095ebc2b6b2fd21b703"},
            {"file": "descent2.ham", "sha256": "5233242206c677d65db7f075dd61f2b0a1b7bbe8cd65f56d769efaee1cc38b4d"},
            {"file": "groupa.pig", "sha256": "facdde6cf8a2cab99ea39ba06931872a1fe5636fe211e61fb58c57d706bf627b"},
            {"file": "descent2.s22", "sha256": "4f10632dd4efcbffe532c35b6763edd22817135442bbcc4171381706f3893728"},
            {"file": "alien1.pig", "sha256": "811fc58caa3e2a72cdfa07d7530b2bb0ca71836a6a2d8a3cb401e4284949c233"},
            {"file": "alien2.pig", "sha256": "75ef8fa0cba03410c61ad1b58f57dcb1481f1f302985828aab0af90639926055"},
            {"file": "fire.pig", "sha256": "26a5a5f4e91456abf31f79578d0922e7bc3348b6aa92489a84033de83f358156"},
            {"file": "ice.pig", "sha256": "ae6152ef69502b00e51a98d8f04b21f2855a332cd2988ecceb3b909a49fa26a1"},
            {"file": "water.pig", "sha256": "de88ead87dcb32f16936b3e2a08b81a2248440f29e6f8be0c4c3a5f9fe4b63c1"},
            {"file": "descent.hog", "sha256": "83d76ff0c46bb2e7348a49bdd287ad764abeda0d851bfb16b42c1ede93b21052"},
            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"}
        ]
    }},

    // -- Launcher preamble --
    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "show_resume_offer", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "skip_intro_movie", "value": false}, "post_delay_ms": 250},
    {"action": "setup_command", "command": "write_bool_pref",
     "args": {"key": "dlog_dormancy_enabled", "value": true}, "post_delay_ms": 250},
    {"action": "enter_game", "game": "${GAME}"},

    {"action": "log", "message": "=== TEST: Launch + Background/Resume ==="},

    // Accept default pilot name (fresh .plr deleted by runner)
    // D1 shows 3 title screens (3s each = 9s) before set_screen_mode(SCREEN_MENU).
    {"action": "wait_for", "field": "intro_active", "value": "true", "timeout_ms": 20000},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},

    // Main menu
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    // The lifecycle machinery is shared by both native engines, while the
    // active-game path below remains covered in D1 and D2. Exercise the extra
    // static and paused workload matrix once, in D2.
    {"action": "introspect", "when": "d2"},
    {"action": "assert", "when": "d2", "expect": {
        "android_lifecycle.workload": "static_ui",
        "android_lifecycle.suspend_state": "running",
        "android_lifecycle.work_counters.event_loop_iterations": {"gt": 0},
        "android_lifecycle.work_counters.draw_dispatches": {"gt": 0},
        "android_lifecycle.work_counters.swap_presented": {"gt": 0}
    }},
    {"action": "log", "when": "d2", "message": "SCRIPT_BACKGROUND: dormant-main-menu duration_s=5 lock_screen=true"},
    {"action": "wait_for", "when": "d2", "field": "egl_recreate_count", "value": "1", "timeout_ms": 30000},
    {"action": "assert", "when": "d2", "expect": {
        "android_lifecycle.requested_visibility": "foreground",
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.checkpoint_state": "skipped",
        "android_lifecycle.park_entry_count": {"gte": 1},
        "android_lifecycle.wake_count": {"gte": 1},
        "android_lifecycle.parked_duration_ms": {"gte": 4000},
        "android_lifecycle.request_generation": {"gte": 2},
        "android_lifecycle.acknowledgement_generation": {"gte": 2}
    }},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 5000},

    // Mission select
    {"action": "select_mission", "text": "${MISSION}", "post_delay_ms": 100, "timeout_ms": 5000},
    // D2 uses level 2 because its route has paired shoot-switch guidance.
    {"action": "wait_ms", "ms": 300, "when": "d2"},
    {"action": "key", "key": "backspace", "when": "d2", "post_delay_ms": 100},
    {"action": "key", "key": "${LEVEL}", "when": "d2", "post_delay_ms": 100},
    {"action": "select", "text": "Ok", "when": "d2", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "key", "key": "enter", "when": "d1", "post_delay_ms": 100},
    // difficulty (wait for menu transition from level dialog)
    {"action": "select", "text": "Rookie", "post_delay_ms": 100, "timeout_ms": 10000},

    // Skip briefing (waits for level load, then escapes if briefing is showing)
    {"action": "key", "key": "escape", "when": "d1", "post_delay_ms": 100},
    {"action": "skip_briefing", "when": "d2", "timeout_ms": 10000, "post_delay_ms": 100},

    // Wait for game
    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "${LEVEL}"}},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "assert", "when": "d2", "expect": {"android_lifecycle.workload": "single_player_active"}},
    {"action": "assert", "expect": {"physfs.write_dir": {"contains": "${GAME_DIR}"}}},
    {"action": "assert", "expect": {"physfs.search_path": {"contains": "${GAME_DIR}"}}},
    {"action": "assert", "expect": {"physfs.search_path": {"contains": "imported/sets/"}}},

    {"action": "log", "message": "=== In-game verified -- testing automap ==="},

    // Open automap (TAB key)
    {"action": "key", "key": "tab", "post_delay_ms": 100},
    {"action": "wait_for", "field": "automap_active", "value": "true", "timeout_ms": 5000},
    {"action": "introspect"},
    {"action": "assert", "expect": {
        "automap_active": "true",
        "automap.objective_overlay_mode_name": "off",
        "automap.objective_visible_step_count": "0",
        "automap.objective_label_candidate_count": "0"
    }},
    {"action": "log", "message": "=== Automap opened successfully ==="},

    // Enable the numbered objective overlay and verify native rendering state.
    {"action": "set_objective_overlay", "mode": "all", "post_delay_ms": 100},
    {"action": "wait_ms", "ms": 300},
    {"action": "introspect"},
    {"action": "assert", "expect": {
        "automap.objective_overlay_mode_name": "all",
        "automap.objective_visible_step_count": {"gt": 0},
        "automap.objective_label_candidate_count": {"gt": 0},
        "automap.objective_label_projected_count": {"gt": 0}
    }},
    {"action": "assert", "when": "d2", "expect": {
        "automap.objective_connector_candidate_count": {"gt": 0},
        "automap.objective_connector_drawn_count": {"gt": 0}
    }},

    {"action": "set_objective_overlay", "mode": "off", "post_delay_ms": 100},
    {"action": "wait_ms", "ms": 100},
    {"action": "introspect"},
    {"action": "assert", "expect": {
        "automap.objective_overlay_mode_name": "off",
        "automap.objective_visible_step_count": "0",
        "automap.objective_label_candidate_count": "0",
        "automap.objective_label_projected_count": "0",
        "automap.objective_connector_candidate_count": "0",
        "automap.objective_connector_drawn_count": "0"
    }},

    // Close automap (ESC)
    {"action": "key", "key": "escape", "post_delay_ms": 100},
    {"action": "wait_for", "field": "automap_active", "value": "false", "timeout_ms": 5000},
    {"action": "assert", "expect": {"automap_active": "false"}},
    {"action": "log", "message": "=== Automap closed -- testing background/resume ==="},

    // Snapshot EGL recreate count before backgrounding (typically 1 from startup)
    {"action": "introspect"},

    // Signal the test runner to background and resume the app.
    // The runner detects this marker, presses HOME, waits, then resumes.
    // Meanwhile, the game thread pauses. After resume, wait_for picks up.
    {"action": "log", "message": "SCRIPT_BACKGROUND: cycle-1"},

    // Synchronize with the EGL rebind rather than a fixed delay. The runner
    // can observe the marker before Android has delivered the pause callback.
    {"action": "wait_for", "field": "egl_recreate_count", "value": "${ACTIVE_CYCLE_1}", "timeout_ms": 30000},

    // Verify the game is running on a post-resume native-window generation
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "egl_window_generation": {"gte": 4}
    }},
    {"action": "assert", "when": "d2", "expect": {
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
        "android_lifecycle.suspend_state": "running",
        "android_lifecycle.park_entry_count": {"gte": 2},
        "android_lifecycle.wake_count": {"gte": 2}
    }},
    {"action": "key", "when": "d2", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "when": "d2", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    // Repeat the lifecycle handoff with a distinct runner marker. This catches
    // stale surface generations and native-window references retained only by
    // the UI callback
    {"action": "log", "message": "SCRIPT_BACKGROUND: cycle-2"},
    {"action": "wait_for", "field": "egl_recreate_count", "value": "${ACTIVE_CYCLE_2}", "timeout_ms": 30000},
    {"action": "assert", "expect": {
        "in_game": "true",
        "screen_mode": "game",
        "egl_window_generation": {"gte": 6}
    }},

    {"action": "log", "message": "=== TEST: Launch + Background/Resume -- COMPLETE ==="},

    // Verify render resolution introspection is populated (default is half-screen,
    // e.g. 640x360 on a 1280x720 display, so check > 0 not specific minimums)
    {"action": "assert", "expect": {
        "resolution.render_width": {"gt": 0},
        "resolution.render_height": {"gt": 0},
        "resolution.display_width": {"gt": 0},
        "resolution.display_height": {"gt": 0}
    }},
    {"action": "log", "message": "=== Resolution introspection verified ==="},

    // Verify hires texture introspection is populated (count depends on
    // whether DXA mods are present -- just check the field exists and is >= 0)
    {"action": "assert", "expect": {
        "hires_textures.hires_count": {"gte": 0}
    }},
    {"action": "log", "message": "=== Hires texture count verified ==="},

    // D2 owns the extra paused-workload matrix. D1 already exercised the same
    // shared suspend/checkpoint code through both active-game cycles above.
    {"action": "key", "when": "d2", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "when": "d2", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "set_debug", "when": "d2", "field": "android_game_request", "value": "pause", "post_delay_ms": 300},
    {"action": "wait_for", "when": "d2", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "assert", "when": "d2", "expect": {"android_lifecycle.workload": "single_player_paused"}},
    {"action": "log", "when": "d2", "message": "SCRIPT_BACKGROUND: dormant-pause-window duration_s=5"},
    {"action": "wait_for", "when": "d2", "field": "egl_recreate_count", "value": "4", "timeout_ms": 30000},
    {"action": "assert", "when": "d2", "expect": {
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
        "android_lifecycle.suspend_state": "running",
        "android_lifecycle.park_entry_count": {"gte": 4},
        "android_lifecycle.wake_count": {"gte": 4}
    }},
    {"action": "key", "when": "d2", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "when": "d2", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},

    {"action": "set_debug", "when": "d2", "field": "android_game_request", "value": "game_menu", "post_delay_ms": 300},
    {"action": "wait_for", "when": "d2", "field": "menu_subtitle", "value": "Game Menu", "timeout_ms": 5000},
    {"action": "assert", "when": "d2", "expect": {"android_lifecycle.workload": "single_player_paused"}},
    {"action": "log", "when": "d2", "message": "SCRIPT_BACKGROUND: dormant-game-menu duration_s=5"},
    {"action": "wait_for", "when": "d2", "field": "egl_recreate_count", "value": "5", "timeout_ms": 30000},
    {"action": "assert", "when": "d2", "expect": {
        "android_lifecycle.observed_visibility": "foreground",
        "android_lifecycle.workload": "single_player_paused",
        "android_lifecycle.checkpoint_state": "committed",
        "android_lifecycle.suspend_state": "running",
        "android_lifecycle.park_entry_count": {"gte": 5},
        "android_lifecycle.wake_count": {"gte": 5},
        "android_lifecycle.last_wake_reason": "foreground",
        "android_lifecycle.context_generation": {"gte": 1},
        "android_lifecycle.window_generation": {"gte": 1},
        "android_lifecycle.work_counters.audio_callbacks": {"gt": 0},
        "android_lifecycle.work_counters.central_overlay_polls": {"gt": 0}
    }},
    {"action": "key", "when": "d2", "key": "escape", "post_delay_ms": 200},
    {"action": "wait_for", "when": "d2", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000},
    {"action": "log", "when": "d2", "message": "=== Android dormant-state matrix verified ==="},
    {"action": "introspect"}
]
