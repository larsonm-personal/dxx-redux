            {"file": "descent.pig", "sha256": "093f9cc029200e9d71d5e14f2f06e5e876a658dd64dc664d6911c5d24d7b64fe"},
            {"file": "trine2.zip", "sha256": "d0a6ab2122fcb5e8ef580cb50e6b9c6d44b086799718a99f1553a9e07cba9323", "target": "files/mission_zip_batch_cache"}
        ]
    }},

    {"action": "enter_launcher"},
    {"action": "reset_state"},
    {"action": "clear_mods"},
    {"action": "setup_command", "command": "clear_save_files", "post_delay_ms": 250},
    {"action": "setup_command", "command": "clear_crash_reports", "post_delay_ms": 250},
    {"action": "import_mission_zip", "file": "trine2.zip", "label": "trine2", "display_name": "trine2.zip"},
    {"action": "analyze_level_metadata_all", "label": "trine2", "mod_file": "trine2.zip", "game": "d1", "status": "ok", "min_total_levels": 10},
    {"action": "tap_button", "text": "Descent 2", "post_delay_ms": 0},
    {"action": "tap_button", "text": "Launch Descent 2", "launches_game": true},

    {"action": "log", "message": "=== TEST: Trine 2 D1-in-D2 custom textures ==="},
    {"action": "skip_intro", "timeout_ms": 20000, "post_delay_ms": 200},
    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000, "optional": true},

    {"action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 5000},
    {"action": "select", "text": "New game", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "Trine - Episode 2", "post_delay_ms": 100, "timeout_ms": 10000},
    {"action": "select", "text": "Ok", "post_delay_ms": 100, "timeout_ms": 5000},
    {"action": "select", "text": "Trainee", "post_delay_ms": 100, "timeout_ms": 10000, "optional": true},
    {"action": "skip_briefing", "timeout_ms": 60000, "post_delay_ms": 100},

    {"action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000},
    {"action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000},
    {"action": "assert", "expect": {"in_game": "true", "screen_mode": "game", "current_level_num": "1"}},
    {"action": "wait_for", "timeout_ms": 10000, "expect": {
        "asset_trace.mode": {"eq": "d1-in-d2"},
        "asset_trace.selected_base_game": {"eq": "d1"},
        "asset_trace.current_level_palette": {"eq": "palette.256"},
        "asset_trace.d1_base_walls.pig_present": {"eq": "true"},
        "asset_trace.d1_base_walls.wall_applied": {"gt": 0},
        "asset_trace.d1_compat.effects_active": {"eq": "true"},
        "asset_trace.d1_compat.powerup_vclips_active": {"eq": "true"},
        "asset_trace.d1_compat.robot_assets_active": {"eq": "true"},
        "asset_trace.d1_compat.robot_obj_bitmaps_applied": {"gt": 0},
        "d1_custom_textures.files_found": {"gte": 1},
        "d1_custom_textures.bitmap_entries": {"gt": 0},
        "d1_custom_textures.applied": {"gt": 0},
        "d1_custom_textures.base_sound_entries": {"eq": "98"},
        "d1_custom_textures.base_sound_applied": {"eq": "64"},
        "d1_custom_textures.base_sound_unresolved": {"eq": "34"},
        "d1_custom_textures.base_sound_skipped": {"eq": "0"}
    }},
    {"action": "assert", "expect": {
        "asset_trace.mode": {"eq": "d1-in-d2"},
        "asset_trace.selected_base_game": {"eq": "d1"},
        "asset_trace.d1_base_walls.wall_applied": {"gt": 0},
        "asset_trace.d1_compat.robot_obj_bitmaps_applied": {"gt": 0},
        "d1_custom_textures.files_found": {"gte": 1},
        "d1_custom_textures.applied": {"gt": 0},
        "d1_custom_textures.base_sound_entries": {"eq": "98"},
        "d1_custom_textures.base_sound_applied": {"eq": "64"},
        "d1_custom_textures.base_sound_unresolved": {"eq": "34"},
        "d1_custom_textures.base_sound_skipped": {"eq": "0"}
    }},
    {"action": "assert", "expect": {
        "console.lines": {"contains": "D1 custom textures:"}
    }},
    {"action": "introspect"},
    {"action": "log", "message": "=== TEST: Trine 2 D1-in-D2 custom textures -- PASS ==="}
