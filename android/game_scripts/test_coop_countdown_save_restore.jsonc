[
    {
        "_info": {
            "games": ["d1", "d2"],
            "_standalone": false,
            "_owner": "test_lan",
        },
    },
    {
        "action": "set_debug",
        "field": "coop_countdown_save_test",
        "value": "restore",
    },
    {
        "action": "wait_for",
        "timeout_ms": 15000,
        "expect": {
            "coop_restore.transfer_busy": true,
        },
    },
    {
        "action": "wait_for",
        "timeout_ms": 5000,
        "expect": {
            "coop_restore.message": { "contains": "Waiting for save downloads: 2 seconds" },
            "coop_restore.download_percent": -1,
        },
    },
    {
        "action": "wait_for",
        "timeout_ms": 180000,
        "expect": {
            "coop_restore.transfer_busy": false,
            "coop_restore.download_percent": -1,
            "in_game": true,
            "time_paused": false,
        },
    },
    {
        "action": "wait_ms",
        "ms": 1500,
    },
    {
        "action": "set_debug",
        "field": "coop_countdown_save_test",
        "value": "verify_pause",
    },
]
