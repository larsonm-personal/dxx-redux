        "label": "enemy_within",
        "display_name": "Enemy Within",
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 20000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 5000,
        "optional": true,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "Enemy Within",
        "timeout_ms": 10000,
    },
    {
        "action": "key",
        "key": "backspace",
        "post_delay_ms": 100,
    },
    {
        "action": "key",
        "key": "2",
        "post_delay_ms": 100,
    },
    {
        "action": "select",
        "text": "Ok",
