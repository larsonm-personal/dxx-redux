[
    {
        "_info": {
            "_standalone": false,
            "_owner": "test_xl_boss_spawning_runtime",
            "games": ["d2"],
        },
    },
    {
        "action": "enter_game",
        "game": "d2",
    },
    {
        "action": "skip_intro",
        "timeout_ms": 30000,
        "post_delay_ms": 500,
    },
    {
        "action": "select",
        "text": "player",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 15000,
    },
    {
        "action": "select_mission",
        "text": "XL: Derived XL boss spawning",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Hotshot",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "face_view",
        "segment": 3,
        "side": 0,
        "distance": 5,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.bosses.0.owner": 49,
            "xl_pilot.bosses.1.owner": 50,
            "xl_pilot.boss_spawned_count": 0,
            "xl_pilot.object_triggers.0.type": 26,
        },
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.boss_spawned_count": 0,
            "xl_pilot.bosses.0.owner": 49,
            "xl_pilot.bosses.1.owner": 50,
        },
    },
    {
        "action": "wait_for",
        "expect": {
            "idle_saver.game_time": {
                "gt": 8,
            },
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "set_debug",
        "field": "object_damage",
        "value": "49 half local",
    },
    {
        "action": "set_debug",
        "field": "object_damage",
        "value": "50 half local",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.boss_spawned_count": 2,
            "xl_pilot.object_triggers.0.operated": true,
            "xl_pilot.object_triggers.1.operated": true,
            "xl_pilot.boss_spawned": {
                "contains_object": {
                    "id": 0,
                    "segment": 20,
                },
            },
        },
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.boss_spawned_count": 2,
            "xl_pilot.bosses.0.owner": 49,
            "xl_pilot.bosses.1.owner": 50,
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_save",
    },
    {
        "action": "wait_ms",
        "ms": 1000,
    },
    {
        "action": "key",
        "key": "escape",
        "post_delay_ms": 200,
    },
    {
        "action": "select",
        "text": "Abort Game",
        "timeout_ms": 5000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "false",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "New game",
        "timeout_ms": 10000,
    },
    {
        "action": "select_mission",
        "text": "Counterstrike",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Ok",
        "timeout_ms": 10000,
    },
    {
        "action": "select",
        "text": "Trainee",
        "timeout_ms": 10000,
    },
    {
        "action": "skip_briefing",
        "timeout_ms": 20000,
    },
    {
        "action": "wait_for",
        "field": "in_game",
        "value": "true",
        "timeout_ms": 20000,
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.active": false,
            "xl_pilot.runtime_active": false,
        },
    },
    {
        "action": "set_debug",
        "field": "android_game_request",
        "value": "quick_load",
    },
    {
        "action": "wait_ms",
        "ms": 100,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.active": true,
            "xl_pilot.boss_spawned_count": 2,
            "xl_pilot.bosses.0.owner": 49,
            "xl_pilot.bosses.1.owner": 50,
            "time_paused": false,
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.boss_spawned": {
                "contains_object": {
                    "id": 0,
                    "control": 1,
                },
            },
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "set_debug",
        "field": "boss_robot_damage",
        "value": "0 1 local",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.boss_spawned": {
                "contains_object": {
                    "id": 0,
                    "shields": "99.0",
                },
            },
        },
    },
    {
        "action": "set_debug",
        "field": "boss_robot_damage",
        "value": "0 200 local",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.boss_spawned_count": 1,
        },
        "timeout_ms": 5000,
    },
    {
        "action": "wait_for",
        "expect": {
            "idle_saver.game_time": {
                "gt": 20,
            },
        },
        "timeout_ms": 20000,
    },
    {
        "action": "set_debug",
        "field": "object_damage",
        "value": "49 1 local",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.bosses.0.cloaked": true,
        },
        "timeout_ms": 5000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.bosses.0.cloaked": true,
            "xl_pilot.bosses.0.dying": 0,
            "xl_pilot.bosses.1.dying": 0,
        },
    },
    {
        "action": "set_debug",
        "field": "object_damage",
        "value": "49 30000 local",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.bosses.0.dying": 1,
            "xl_pilot.bosses.1.dying": 0,
        },
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "capture",
    },
    {
        "action": "set_debug",
        "field": "checkpoint_cycle",
        "value": "roundtrip",
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
    {
        "action": "assert",
        "expect": {
            "xl_pilot.bosses.0.owner": 49,
            "xl_pilot.bosses.0.dying": 1,
            "xl_pilot.bosses.1.owner": 50,
            "xl_pilot.bosses.1.dying": 0,
        },
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "false",
    },
    {
        "action": "wait_for",
        "expect": {
            "xl_pilot.bosses.0.owner": -1,
            "xl_pilot.bosses.0.dying": 2,
            "xl_pilot.bosses.1.owner": 50,
            "xl_pilot.bosses.1.dying": 0,
        },
        "timeout_ms": 15000,
    },
    {
        "action": "set_debug",
        "field": "robots_suspended",
        "value": "true",
    },
]
