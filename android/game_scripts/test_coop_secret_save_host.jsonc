[
  {
    "_info": {
      "games": [
        "d2"
      ],
      "_standalone": false,
      "_owner": "test_lan"
    }
  },
  {
    "action": "set_debug",
    "field": "android_game_request",
    "value": "save"
  },
  {
    "action": "wait_for",
    "timeout_ms": 10000,
    "expect": {
      "menu_subtitle": "Save Game"
    }
  },
  {
    "action": "key",
    "key": "escape"
  },
  {
    "action": "assert",
    "expect": {
      "menu_subtitle": "Save Game"
    }
  },
  {
    "action": "key",
    "key": "escape"
  },
  {
    "action": "wait_for",
    "timeout_ms": 5000,
    "expect": {
      "screen_mode": "game",
      "game_window_is_front": true
    }
  },
  {
    "action": "set_debug",
    "field": "coop_secret_save_test",
    "value": "save"
  },
  {
    "action": "wait_for",
    "timeout_ms": 5000,
    "expect": {
      "game_window_is_front": true
    }
  },
  {
    "action": "set_debug",
    "field": "android_game_request",
    "value": "load"
  },
  {
    "action": "wait_for",
    "timeout_ms": 10000,
    "expect": {
      "menu_subtitle": "Select Game to Restore"
    }
  },
  {
    "action": "key",
    "key": "escape"
  },
  {
    "action": "wait_for",
    "timeout_ms": 5000,
    "expect": {
      "screen_mode": "game",
      "game_window_is_front": true
    }
  }
]
