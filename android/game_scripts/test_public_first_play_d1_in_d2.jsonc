// Only public D1 HOG/PIG are present; exercise the normal Descent 2 button fallback
[
    { "_info": { "games": ["d2"], "_standalone": false, "_owner": "test_demo_import" } },
    { "action": "enter_launcher" },
    { "action": "assert", "expect": { "active_set": "default", "d1.ready": true, "d2.ready": false, "d1_in_d2.ready": true } },
    { "action": "tap_button", "text": "Launch Descent 2", "exact": true, "launches_game": true },
    { "action": "skip_intro", "timeout_ms": 30000, "post_delay_ms": 200 },
    { "action": "wait_for", "field": "screen_mode", "value": "menu", "timeout_ms": 20000 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select", "text": "New game", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select_mission", "text": "Descent Demo", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select", "text": "Ok", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "select", "text": "Rookie", "timeout_ms": 10000, "post_delay_ms": 100 },
    { "action": "skip_briefing", "timeout_ms": 30000, "post_delay_ms": 100 },
    { "action": "wait_for", "field": "in_game", "value": "true", "timeout_ms": 30000 },
    { "action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 10000 },
    {
        "action": "assert",
        "expect": {
            "in_game": true, "screen_mode": "game", "current_level_num": 1, "player_dead": false,
            "asset_trace.runtime_engine": "d2", "asset_trace.selected_base_game": "d1", "asset_trace.mode": "d1-in-d2",
            "asset_trace.d1_compat.native_assets": true, "asset_trace.d1_compat.sound_pig_size": 5092871,
        },
    },
    // Ordinary inputs only: dismiss the game menu twice, then open and close the map
    { "action": "log", "message": "BASIC_USE_BEGIN menu_map" },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "wait_for", "field": "menu_subtitle", "value": "Game Menu", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "game_window_is_front": false, "time_paused": true } },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "screen_mode": "game", "current_level_num": 1, "player_dead": false, "time_paused": false } },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "wait_for", "field": "menu_subtitle", "value": "Game Menu", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "game_window_is_front": false, "time_paused": true } },
    { "action": "key", "key": "escape", "post_delay_ms": 200 },
    { "action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "screen_mode": "game", "current_level_num": 1, "player_dead": false, "time_paused": false } },
    { "action": "key", "key": "tab", "post_delay_ms": 100 },
    { "action": "wait_for", "field": "automap_active", "value": "true", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "automap_active": true } },
    { "action": "key", "key": "escape", "post_delay_ms": 100 },
    { "action": "wait_for", "field": "automap_active", "value": "false", "timeout_ms": 5000 },
    { "action": "wait_for", "field": "game_window_is_front", "value": "true", "timeout_ms": 5000 },
    { "action": "assert", "expect": { "in_game": true, "screen_mode": "game", "current_level_num": 1, "player_dead": false, "time_paused": false, "automap_active": false } },
    { "action": "log", "message": "BASIC_USE_END menu_map" },
    { "action": "introspect" },
    { "action": "log", "message": "PASS: real Descent 2 button reached public D1 level 1 in the D2 engine" },
    { "action": "enter_launcher" },
    { "action": "wait_for", "field": "game_running", "value": "false", "timeout_ms": 30000 },
    { "action": "assert", "expect": { "d1.ready": true, "d2.ready": false } },
]
