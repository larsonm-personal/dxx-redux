# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties to version control.
#
# To generate a keystore:
#   keytool -genkeypair -v -keystore release.keystore -alias dxxredux \
#     -keyalg RSA -keysize 2048 -validity 10000
#

# newer keytool only asks for one password
# fill it in for both storePassword and keyPassword

storeFile=release.keystore
storePassword=your_store_password
keyAlias=dxxredux
keyPassword=your_key_password
