<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV: touchscreen not required, controller supported -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Some supported 7z mission packs use 192 MiB LZMA2 dictionaries;
         ArchiveFiles enforces a 256 MiB decoder-memory ceiling -->
    <application
        android:name=".DxxReduxApp"
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="${launcherLabel}"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Google Play Games Services app ID (from auth_config.jsonc).
             Keep this as a string resource so Play Games v2 does not see
             a raw integer meta-data value during launcher startup. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/games_app_id" />

        <!-- The SDK also initializes itself before SetupActivity through this provider -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            android:enabled="${playGamesEnabled}"
            android:exported="false" />

        <!-- Pre-game setup / file-check screen (Jetpack Compose) -->
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:exported="false" android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />
        <activity android:name=".multiplayer.LanJoinLinkActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="descent" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game engine surface: separate process avoids a libhwui.so
             RenderThread crash (destroyed mutex FORTIFY abort) triggered by
             transitioning from a Compose Activity to an SDL SurfaceView
             Activity within the same process.
             Keep legacy Back dispatch for native game key routing on API 36;
             SetupActivity uses AndroidX Back handling and retains predictive Back -->
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="false"
            android:process=":game"
            android:launchMode="singleTop"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Native automap previews are short-lived and isolated from both
             the launcher and a paused full game. D1 and D2 remain separate
             so one process never loads both engine libraries.
             Preserve onBackPressed cleanup until previews use predictive Back callbacks -->
        <activity
            android:name=".LevelPreviewD1Activity"
            android:enableOnBackInvokedCallback="false"
            android:process=":levelpreview_d1"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".LevelPreviewD2Activity"
            android:enableOnBackInvokedCallback="false"
            android:process=":levelpreview_d2"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".RobotPreviewD1Activity"
            android:enableOnBackInvokedCallback="false"
            android:process=":robotpreview_d1"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".RobotPreviewD2Activity"
            android:enableOnBackInvokedCallback="false"
            android:process=":robotpreview_d2"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- FileProvider for sharing exported config files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground service keeps the main process (which hosts the UDP
             proxy and MatchmakingService) alive during multiplayer so
             Android's process freezer doesn't halt relay traffic -->
        <service
            android:name=".multiplayer.MultiplayerForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Isolated level metadata workers. Malformed third-party level files
             can crash native analysis without taking down SetupActivity.
             D1 and D2 use separate processes so each process loads only one
             game library. -->
        <service
            android:name=".LevelMetadataD1AnalysisService"
            android:process=":levelmeta_d1"
            android:exported="false" />
        <service
            android:name=".LevelMetadataD2AnalysisService"
            android:process=":levelmeta_d2"
            android:exported="false" />
    </application>

</manifest>
