<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: touchscreen not required, controller supported -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Some supported 7z mission packs use 192 MiB LZMA2 dictionaries;
         ArchiveFiles enforces a 256 MiB decoder-memory ceiling -->
    <application
        android:name=".DxxReduxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="DXX-Redux"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Google Play Games Services app ID (from auth_config.json5).
             Keep this as a string resource so Play Games v2 does not see
             a raw integer meta-data value during launcher startup. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/games_app_id" />

        <!-- Pre-game setup / file-check screen (Jetpack Compose) -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game engine surface: separate process avoids a libhwui.so
             RenderThread crash (destroyed mutex FORTIFY abort) triggered by
             transitioning from a Compose Activity to an SDL SurfaceView
             Activity within the same process. -->
        <activity
            android:name=".MainActivity"
            android:process=":game"
            android:launchMode="singleTop"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Native automap previews are short-lived and isolated from both
             the launcher and a paused full game. D1 and D2 remain separate
             so one process never loads both engine libraries. -->
        <activity
            android:name=".LevelPreviewD1Activity"
            android:process=":levelpreview_d1"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".LevelPreviewD2Activity"
            android:process=":levelpreview_d2"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".RobotPreviewD1Activity"
            android:process=":robotpreview_d1"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".RobotPreviewD2Activity"
            android:process=":robotpreview_d2"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- FileProvider for sharing exported config files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.dxxredux.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground service keeps the main process (which hosts the UDP
             proxy and MatchmakingService) alive during multiplayer so
             Android's process freezer doesn't halt relay traffic -->
        <service
            android:name=".multiplayer.MultiplayerForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Isolated level metadata workers. Malformed third-party level files
             can crash native analysis without taking down SetupActivity.
             D1 and D2 use separate processes so each process loads only one
             game library. -->
        <service
            android:name=".LevelMetadataD1AnalysisService"
            android:process=":levelmeta_d1"
            android:exported="false" />
        <service
            android:name=".LevelMetadataD2AnalysisService"
            android:process=":levelmeta_d2"
            android:exported="false" />
    </application>

</manifest>
