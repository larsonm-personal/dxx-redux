# Compile exact production parser, load handling and result publication with platform sinks
set(automation_source "${DXX_TEST_SHARED_SOURCE_DIR}/game_automate.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${automation_source}")
file(READ "${automation_source}" automation_text)
function(extract_automation_fragment name begin_marker end_marker)
    string(FIND "${automation_text}" "${begin_marker}" begin)
    string(FIND "${automation_text}" "${end_marker}" end)
    if(begin LESS 0 OR end LESS_EQUAL begin)
        message(FATAL_ERROR "Production automation source boundary changed: ${name}")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${automation_text}" ${begin} ${length} fragment)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/automation_${name}.inc" "${fragment}")
endfunction()
extract_automation_fragment(types "enum step_type {" "/* -- Script state")
extract_automation_fragment(request "struct automation_load_request {" "static char g_automate_dir")
extract_automation_fragment(parser "static int parse_script(" "/* -- Assert: check introspection")
extract_automation_fragment(result "static FILE *begin_result_file(" "static void write_result_file_continue(")
extract_automation_fragment(stale "static void remove_stale_result(void)" "/* -- Key injection")
extract_automation_fragment(terminal "static void stop_script_fail(" "/* -- Public API")
extract_automation_fragment(load "\t/* Handle pending load request (from JNI thread) */" "\n\tif (!g_active || g_current_step >= (int) g_steps.size())")

