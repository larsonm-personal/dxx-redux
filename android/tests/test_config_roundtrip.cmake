if(NOT EXISTS "${ENGINE}")
    message(FATAL_ERROR "Native fixture executable is required")
endif()
# One owned directory per engine/build. No user's profile or game data is used.
set(profile "${CMAKE_CURRENT_BINARY_DIR}/config-roundtrip")
file(MAKE_DIRECTORY "${profile}")
file(REMOVE "${profile}/descent.cfg")
function(run_phase operation state)
    execute_process(COMMAND "${ENGINE}" --config-roundtrip "${operation}" "${state}"
                    WORKING_DIRECTORY "${profile}" RESULT_VARIABLE result
                    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "PASS: native config ${operation} ${state}")
        message(FATAL_ERROR "Config ${operation}/${state} failed: ${result}\n${output}\n${errors}")
    endif()
endfunction()
function(reject_phase state reason)
    execute_process(COMMAND "${ENGINE}" --config-roundtrip read "${state}"
                    WORKING_DIRECTORY "${profile}" RESULT_VARIABLE result
                    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    if(NOT "${result}" STREQUAL "1" OR NOT errors MATCHES "${reason}")
        message(FATAL_ERROR "Negative control did not reject the intended defect: ${result}\n${output}\n${errors}")
    endif()
endfunction()
run_phase(write A)
run_phase(read A)
file(READ "${profile}/descent.cfg" original)
reject_phase(B "audio settings survive native process restart")
run_phase(write B)
run_phase(read B)
reject_phase(A "audio settings survive native process restart")
run_phase(write A)
run_phase(read A)
file(READ "${profile}/descent.cfg" restored)
if(NOT original STREQUAL restored)
    message(FATAL_ERROR "A-B-A did not restore identical native serialized settings")
endif()
string(REPLACE "MusicVolume=3" "MusicVolume=4" damaged "${restored}")
if(damaged STREQUAL restored)
    message(FATAL_ERROR "Mutation control did not change serialized music volume")
endif()
file(WRITE "${profile}/descent.cfg" "${damaged}")
reject_phase(A "audio settings survive native process restart")
file(REMOVE "${profile}/descent.cfg")
reject_phase(A "persisted config must exist")
message(STATUS "PASS: native settings A-B-A and stale, altered, missing config controls")
