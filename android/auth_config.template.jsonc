// auth_config.jsonc -- independent Google matchmaking and optional Play Games configuration
// Copy this file to auth_config.jsonc and fill in your values.
// DO NOT commit auth_config.jsonc to version control.
//
// Matchmaking: configure an OAuth consent screen and web application client in Google Cloud
// Register Android OAuth clients for each application ID and actual signing certificate
// Optional PGS features: configure a Play Games project linked to the Android app in Play Console
// PGS profile IDs and matchmaking Google subjects are distinct; neither setting implies opt-in
{
    // Matchmaking Sign in with Google audience, independent of optional Play Games
    // Register each Android application ID and signing certificate in the same OAuth project
    // Must match GOOGLE_CLIENT_ID on the matchmaking server
    "matchmaking_google_client_id": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com",

    // Play Games app ID (numeric, from Play Console > Play Games Services)
    // Used in AndroidManifest.xml as com.google.android.gms.games.APP_ID
    "games_app_id": "000000000000",
}
