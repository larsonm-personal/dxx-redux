# Exercise the production validator in subprocesses, without modifying reference inputs
set(validator "${CMAKE_CURRENT_LIST_DIR}/reference_oof_pins.cmake")
set(paths models/oofread.cpp render/oofrender.cpp 3d/oof2model.cpp)
function(validate expected)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DXL_REFERENCE_GEOMETRY_ROOT=${OUTPUT}" -P "${validator}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected AND NOT result EQUAL 0)
        message(FATAL_ERROR "Equivalent source rejected: ${error}")
    elseif(NOT expected AND (result EQUAL 0 OR NOT error MATCHES "OOF reference changed:"))
        message(FATAL_ERROR "Changed source was not rejected by the hash guard: ${error}")
    endif()
endfunction()
foreach(ending IN ITEMS LF CRLF)
    foreach(path IN LISTS paths)
        file(READ "${REFERENCE}/${path}" source)
        string(REPLACE "\r\n" "\n" source "${source}")
        if(ending STREQUAL "CRLF")
            string(REPLACE "\n" "\r\n" source "${source}")
        endif()
        get_filename_component(directory "${OUTPUT}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${OUTPUT}/${path}" "${source}")
    endforeach()
    validate(TRUE)
    foreach(path IN LISTS paths)
        # CMake READ canonicalizes CRLF, so reconstruct the chosen raw representation
        file(READ "${REFERENCE}/${path}" original)
        string(REPLACE "\r\n" "\n" original "${original}")
        if(ending STREQUAL "CRLF")
            string(REPLACE "\n" "\r\n" original "${original}")
        endif()
        foreach(change IN ITEMS edit wrong_source truncated mixed bom)
            if(change STREQUAL "edit")
                set(changed "${original}\nint substantive_extra_source = 1;\n")
            elseif(change STREQUAL "wrong_source")
                set(changed "int unrelated_source = 1;\n")
            elseif(change STREQUAL "truncated")
                string(LENGTH "${original}" char_count)
                math(EXPR char_count "${char_count} - 1")
                string(SUBSTRING "${original}" 0 ${char_count} changed)
            elseif(change STREQUAL "mixed")
                string(FIND "${original}" "\n" first)
                string(SUBSTRING "${original}" 0 ${first} prefix)
                math(EXPR after "${first} + 1")
                string(SUBSTRING "${original}" ${after} -1 suffix)
                if(ending STREQUAL "LF")
                    set(changed "${prefix}\r\n${suffix}")
                else()
                    string(LENGTH "${prefix}" char_count)
                    math(EXPR char_count "${char_count} - 1")
                    string(SUBSTRING "${prefix}" 0 ${char_count} prefix)
                    set(changed "${prefix}\n${suffix}")
                endif()
            else()
                string(ASCII 239 187 191 bom)
                set(changed "${bom}${original}")
            endif()
            file(WRITE "${OUTPUT}/${path}" "${changed}")
            validate(FALSE)
        endforeach()
        file(WRITE "${OUTPUT}/${path}" "${original}")
    endforeach()
    validate(TRUE)
endforeach()
message(STATUS "OOF pins: 4 equivalent-source passes and 30 changed-source rejections")
