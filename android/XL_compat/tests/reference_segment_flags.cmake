# Compile the pinned reference's actual ambient traversal and flag update functions
file(SHA256 "${XL_REFERENCE_SEGMENT_FLAGS}" reference_hash)
if(NOT reference_hash STREQUAL "dcacfd889edf869699eb49ac8e39c4027c1da48f7c2f95eb90581bf1e7701be7")
    message(FATAL_ERROR "XL segment-flag reference differs from audited source")
endif()
file(READ "${XL_REFERENCE_SEGMENT_FLAGS}" reference_text)
set(extracted "// Generated from pinned XL findsegment.cpp; do not edit\n")
foreach(signature "void AmbientMarkBfs (" "void SetAmbientSoundFlagsCommon ("
                  "void SetAmbientSoundFlags (")
    string(FIND "${reference_text}" "${signature}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing reference function: ${signature}")
    endif()
    string(SUBSTRING "${reference_text}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing reference function delimiter")
    endif()
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${end} function_text)
    string(APPEND extracted "${function_text}\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_segment_flags.h"
     CONTENT "${extracted}")
add_executable(xl_segment_flags_reference_test
               "${CMAKE_CURRENT_LIST_DIR}/reference_segment_flags_test.cpp")
target_compile_features(xl_segment_flags_reference_test PRIVATE cxx_std_17)
target_include_directories(xl_segment_flags_reference_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
add_test(NAME xl_segment_flags_reference COMMAND xl_segment_flags_reference_test)
