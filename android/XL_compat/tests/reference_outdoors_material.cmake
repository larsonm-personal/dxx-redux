file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/lighting/dynlight.cpp" reference_hash)
if(NOT reference_hash STREQUAL "49b804192e5ebd226832132399395baec9eea664ef25157a4535e18b52da72d7")
    message(FATAL_ERROR "XL outdoors material source differs from audited revision")
endif()
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/lighting/dynlight.cpp" reference_text)
string(FIND "${reference_text}" "\tnTexture = pFace->m_info.nBaseTex;" start)
string(FIND "${reference_text}" "\t//if (m_data.nLights [0])" end)
if(start LESS 0 OR end LESS start)
    message(FATAL_ERROR "Missing XL face material selection fragment")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${reference_text}" ${start} ${length} fragment)
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_outdoors_material.h"
     CONTENT "${fragment}")
target_include_directories(xl_companion_lighting_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_definitions(xl_companion_lighting_test PRIVATE XL_REFERENCE_OUTDOORS_MATERIAL=1)
