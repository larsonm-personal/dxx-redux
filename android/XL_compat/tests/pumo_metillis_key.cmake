foreach(required ENGINE DATA RESOURCES ENTRY OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Metillis key flight requires ${required}")
    endif()
endforeach()
find_program(PWSH pwsh REQUIRED)
execute_process(
    COMMAND
        "${PWSH}" -NoProfile -File
        "${CMAKE_CURRENT_LIST_DIR}/../../helpers/retain-recent-artifacts.ps1" -Artifacts
        "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
include("${CMAKE_CURRENT_LIST_DIR}/pumo_player_phase.cmake")
set(PUMO_PHASE_TIMEOUT 360)
file(READ "${ENTRY}/escape-result.json" entry_receipt)
string(JSON checkpoint GET "${entry_receipt}" checkpoints 4)
string(JSON filename GET "${checkpoint}" file)
file(MAKE_DIRECTORY "${OUTPUT}/preview-user")
configure_file("${ENTRY}/preview-user/${filename}" "${OUTPUT}/preview-user/${filename}" COPYONLY)
file(READ "${CMAKE_CURRENT_LIST_DIR}/pumo_metillis_key_steps.json" route)
string(JSON count LENGTH "${route}")
math(EXPR last "${count} - 1")
set(base
    [=[{"initial_level":4,"simulation_fps":60,"checkpoint_expect":{"current_level_num":4,"player_dead":false,"cheats_enabled":false}}]=]
)
foreach(index RANGE 0 ${last} 1)
    string(JSON steps GET "${route}" ${index})
    string(JSON step_count LENGTH "${steps}")
    string(JSON template SET "${base}" steps "${steps}")
    set(phase "flight-${index}")
    write_resume_plan("${phase}" "${template}" "${checkpoint}")
    run_pumo_player_phase("${phase}" 4 4 "${step_count}" 0)
    set(receipt "${${phase}_receipt}")
    foreach(field fixed_view_aim_events position_assist_events)
        string(JSON assists GET "${receipt}" ${field})
        if(NOT assists EQUAL 0)
            message(FATAL_ERROR "Metillis ${phase} used ${field}")
        endif()
    endforeach()
    string(JSON checkpoint GET "${receipt}" checkpoints 4)
endforeach()
# Branch from the uniquely named save made in the blue key room. Later supply phases have already
# updated the player's ordinary quick-save slot.
file(READ "${OUTPUT}/flight-8-result.json" key_receipt)
string(JSON checkpoint GET "${key_receipt}" checkpoint_history 0)
file(READ "${CMAKE_CURRENT_LIST_DIR}/pumo_metillis_defense_steps.json" defense_steps)
string(JSON template SET "${base}" steps "${defense_steps}")
string(JSON step_count LENGTH "${defense_steps}")
write_resume_plan("defense" "${template}" "${checkpoint}")
run_pumo_player_phase("defense" 4 4 "${step_count}" 0)
foreach(field fixed_view_aim_events position_assist_events)
    string(JSON assists GET "${defense_receipt}" ${field})
    if(NOT assists EQUAL 0)
        message(FATAL_ERROR "Metillis defense used ${field}")
    endif()
endforeach()
