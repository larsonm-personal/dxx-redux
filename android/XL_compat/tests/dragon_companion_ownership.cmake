file(SHA256 "${HOG}" hash)
if(NOT hash STREQUAL "a8eebb7e83faa55e143a48ec87c82407d8ffcaef3ad6b8f9329b84a6a42b262e")
    message(FATAL_ERROR "Original Dragon Pit HOG hash differs")
endif()
get_filename_component(source "${HOG}" DIRECTORY)
file(SHA256 "${source}/drgpit.msn" descriptor_hash)
if(NOT descriptor_hash STREQUAL "44c5d33468e59b06c20ea15715928f1f3bba6351497b66f8db7de20fdf0f8df3")
    message(FATAL_ERROR "Original Dragon Pit descriptor hash differs")
endif()
file(MAKE_DIRECTORY "${OUTPUT}/missions" "${OUTPUT}/preview-user")
file(COPY "${HOG}" "${source}/drgpit.msn" DESTINATION "${OUTPUT}/missions")
execute_process(
    COMMAND "${ENGINE}" -hogdir "${DATA}" -extra-dir "${OUTPUT}" -userdir "${OUTPUT}/preview-user"
            -mission drgpit -package-audit "${OUTPUT}/audit.json" -package-audit-check-ownership yes
    RESULT_VARIABLE result
    OUTPUT_FILE "${OUTPUT}/run.log"
    ERROR_FILE "${OUTPUT}/error.log"
    TIMEOUT 50)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Original companion ownership probe failed: ${result}")
endif()
file(READ "${OUTPUT}/audit.json" report)
string(JSON brightness GET "${report}" lighting_companions nonzero_brightness)
string(JSON colors GET "${report}" lighting_companions chromatic_colors)
string(JSON probe GET "${report}" lighting_companions ownership_probe)
string(JSON qualified GET "${report}" lighting_companions rendering_qualified)
if(NOT brightness EQUAL 69 OR NOT colors EQUAL 103 OR qualified
   OR NOT probe STREQUAL
      "case lookup, foreign-shadow rejection, recovery and mission release passed")
    message(FATAL_ERROR "Unexpected original companion ownership evidence")
endif()
string(JSON segments LENGTH "${report}" segments)
string(JSON quads GET "${report}" compiled_side_counts_quad_tri02_tri13 0)
string(JSON tri02 GET "${report}" compiled_side_counts_quad_tri02_tri13 1)
string(JSON tri13 GET "${report}" compiled_side_counts_quad_tri02_tri13 2)
if(NOT segments EQUAL 632 OR NOT quads EQUAL 2884 OR NOT tri02 EQUAL 430 OR NOT tri13 EQUAL 478)
    message(FATAL_ERROR "Original mine compiled-side coverage differs")
endif()
string(JSON split02 GET "${report}" lighting_split_candidate_counts_tri02_tri13 0)
string(JSON split13 GET "${report}" lighting_split_candidate_counts_tri02_tri13 1)
string(JSON changed GET "${report}" lighting_changed_existing_splits)
if(NOT split02 EQUAL 2022 OR NOT split13 EQUAL 1770 OR NOT changed EQUAL 0)
    message(FATAL_ERROR "Original mine lighting split candidates differ")
endif()
string(JSON normal_count GET "${report}" raw_float_triangle_normal_count)
if(NOT normal_count EQUAL 7584)
    message(FATAL_ERROR "Original mine float-normal coverage is incomplete")
endif()
string(JSON fixed_differences GET "${report}" xl_fixed_normals_differing_from_engine)
if(NOT fixed_differences EQUAL 0)
    message(FATAL_ERROR "Original mine XL fixed-normal differences changed")
endif()
string(JSON compiled02 GET "${report}" xl_compiled_splits_tri02_tri13 0)
string(JSON compiled13 GET "${report}" xl_compiled_splits_tri02_tri13 1)
string(JSON compiled_changes GET "${report}" xl_compiled_splits_differing_from_engine)
if(NOT compiled02 EQUAL 2068 OR NOT compiled13 EQUAL 1724 OR NOT compiled_changes EQUAL 46)
    message(FATAL_ERROR "Original mine assembled XL lighting splits changed")
endif()
string(JSON source_count LENGTH "${report}" geometry_light_sources)
if(NOT source_count EQUAL 252)
    message(FATAL_ERROR "Original mission geometry light-source count differs")
endif()
set(orange_sources 0)
set(strong_sources 0)
set(overlay_updates 0)
string(JSON sources GET "${report}" geometry_light_sources)
foreach(index RANGE 0 251 1)
    string(JSON material GET "${sources}" ${index} material_texture)
    string(JSON created GET "${sources}" ${index} created_texture)
    if(material EQUAL 286)
        math(EXPR orange_sources "${orange_sources} + 1")
    elseif(material EQUAL 333)
        math(EXPR strong_sources "${strong_sources} + 1")
    endif()
    if(NOT material EQUAL created)
        math(EXPR overlay_updates "${overlay_updates} + 1")
    endif()
endforeach()
if(NOT orange_sources EQUAL 6 OR NOT strong_sources EQUAL 17 OR NOT overlay_updates EQUAL 1)
    message(FATAL_ERROR "Original mission light material selection differs")
endif()
