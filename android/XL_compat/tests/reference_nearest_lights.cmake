file(SHA256 "${XL_REFERENCE_LIGHT_PRECALC}" reference_hash)
if(NOT reference_hash STREQUAL "5f4f66408dd530f0e6282baeaf60e4f4b985deef35f4de5bbe9e32585cedd70e")
    message(FATAL_ERROR "XL nearest-light source differs from audited revision")
endif()
file(READ "${XL_REFERENCE_LIGHT_PRECALC}" reference_text)
string(FIND "${reference_text}" "void QSortLightDist (" start)
if(start LESS 0)
    message(FATAL_ERROR "Missing reference distance sort")
endif()
string(SUBSTRING "${reference_text}" ${start} -1 tail)
string(FIND "${tail}" "\n}\n" end)
if(end LESS 0)
    message(FATAL_ERROR "Missing reference distance sort delimiter")
endif()
math(EXPR length "${end} + 3")
string(SUBSTRING "${tail}" 0 ${length} fragment)
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_nearest_lights.h"
     CONTENT "${fragment}")
add_executable(xl_nearest_lights_test "${CMAKE_CURRENT_LIST_DIR}/reference_nearest_lights_test.cpp")
target_include_directories(xl_nearest_lights_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(xl_nearest_lights_test PRIVATE xl_inventory)
add_test(NAME xl_nearest_lights_reference COMMAND xl_nearest_lights_test)
