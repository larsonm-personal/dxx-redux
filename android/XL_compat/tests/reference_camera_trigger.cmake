file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/include/error.h" error_hash)
if(NOT error_hash STREQUAL "c9f66fd0211aca53e9ad9d0933315af26578a9c7401feac7b288095e4391b777")
    message(FATAL_ERROR "Camera trigger diagnostic definitions changed")
endif()
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/include/trigger.h" header)
file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/include/timer.h" timer_hash)
if(NOT timer_hash STREQUAL "57b2e6853def5ae0ea062056c64b88f608933402babc16b8c31498f7bd18a06b")
    message(FATAL_ERROR "Camera trigger time conversion changed")
endif()
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/include/timer.h" timer_source)
string(REGEX MATCH "#define MSEC2X[^\r\n]+" time_conversion "${timer_source}")
string(REGEX MATCHALL "#define[ \t]+(TT_|TF_)[A-Z0-9_]+[ \t]+[0-9]+" definitions "${header}")
string(JOIN "\n" constants ${definitions})
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_camera_constants.h"
     CONTENT "${constants}\n")
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/include/error.h" errors)
string(FIND "${errors}" "#if DBG\t\t//macros for debugging" start)
if(start LESS 0)
    message(FATAL_ERROR "Pinned diagnostic macro block missing")
endif()
string(SUBSTRING "${errors}" ${start} -1 errors)
string(FIND "${errors}" "#endif" end)
math(EXPR length "${end} + 6")
string(SUBSTRING "${errors}" 0 ${length} errors)
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/main/trigger.cpp" source)
string(REGEX MATCH "int32_t oppTrigTypes[ \t]+\\[\\][^;]+;" opposites "${source}")
if(NOT opposites)
    message(FATAL_ERROR "Pinned opposite trigger table missing")
endif()
set(extracted "${errors}\n${time_conversion}\n${opposites}\n")
foreach(signature IN ITEMS "int32_t CTrigger::Operate (" "bool CTrigger::IsDelayed ("
                           "int32_t CTrigger::Delay (" "void CTrigger::Countdown (")
    extract_face_function("${XL_REFERENCE_GEOMETRY_ROOT}/main/trigger.cpp" "${signature}")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_camera_trigger.h"
     CONTENT "${extracted}")
target_sources(xl_trigger_flags_reference PRIVATE tests/reference_camera_trigger.cpp)
