set(extracted "// Unmodified pinned XL color reader functions; fixture-owned state\n")
foreach(
    entry IN
    ITEMS "gameio/loadgeometry.cpp|dd9335a95f69cb91a244ba6352ea381d4531fcddb1a12cf06c619d9ab6cf857f"
          "gameio/loadtextures.cpp|bf1ae25e058d6ca745e5833ea0e2c0e425c5716571f6dc5f109a49d67c5452b6"
)
    string(REPLACE "|" ";" pair "${entry}")
    list(GET pair 0 source)
    list(GET pair 1 expected)
    file(SHA256 "${XL_REFERENCE_COLOR_ROOT}/${source}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Color precedence reference source changed: ${source}")
    endif()
    file(READ "${XL_REFERENCE_COLOR_ROOT}/${source}" source_text)
    if(source MATCHES "loadgeometry")
        set(signatures "void ReadColor (" "void LoadTexColorsCompiled (")
    else()
        set(signatures "void LoadTextureColors (")
    endif()
    foreach(signature IN LISTS signatures)
        string(FIND "${source_text}" "${signature}" start)
        if(start LESS 0)
            message(FATAL_ERROR "Missing color reader ${signature}")
        endif()
        string(SUBSTRING "${source_text}" ${start} -1 tail)
        string(FIND "${tail}" "\n}\n" end)
        math(EXPR length "${end} + 3")
        string(SUBSTRING "${tail}" 0 ${length} function_text)
        string(APPEND extracted "${function_text}\n")
    endforeach()
endforeach()
file(SHA256 "${XL_REFERENCE_COLOR_ROOT}/gameio/loadgame.cpp" actual)
if(NOT actual STREQUAL "5d7ff36d6121411e0250be94353bbe3268bdd02b9bd35c6161951d879fcecc55")
    message(FATAL_ERROR "Reference level-load ordering changed")
endif()
# These are ordered calls in the pinned loader, not an inferred file precedence
file(READ "${XL_REFERENCE_COLOR_ROOT}/gameio/loadgame.cpp" loader)
string(FIND "${loader}" "LoadTextureColors (pszLevelName, NULL);" companion)
string(FIND "${loader}" "InitTexColors ();" initialize)
string(FIND "${loader}" "LoadLevelData (pszLevelName, nLevel)" level)
if(companion LESS 0 OR NOT initialize GREATER companion OR NOT level GREATER initialize)
    message(FATAL_ERROR "Reference CLR/embedded load ordering differs")
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_color_readers.h"
     CONTENT "${extracted}")
add_executable(xl_color_precedence_reference tests/reference_color_precedence.cpp)
target_compile_features(xl_color_precedence_reference PRIVATE cxx_std_17)
target_include_directories(xl_color_precedence_reference PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(xl_color_precedence_reference PRIVATE xl_inventory)
if(XL_NEPTUNE_HOG)
    add_test(NAME xl_neptune_color_precedence COMMAND xl_color_precedence_reference
                                                      "${XL_NEPTUNE_HOG}")
endif()
