foreach(pair IN
        ITEMS "ai/aiboss.cpp|6ee8d46cb9211dde69cdd4ed1d2f1a4efde7dc13c862a3ec4c0206f1a2e29e99"
              "ai/aianimate.cpp|81b2a6532d24539e3663f92f09e43f422c8c389bcfd7be081b820b80d8b83230")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 path)
    list(GET parts 1 expected)
    file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Actor audio source changed: ${path}")
    endif()
endforeach()
set(extracted "// Actual actor audio call expressions, with caller storage adapters\n")
foreach(kind IN ITEMS BossSee BossFinal RobotGroan RobotFinal)
    if(kind STREQUAL "BossSee")
        set(path "ai/aiboss.cpp")
        set(pattern "audio.CreateObjectSound \\(pRobotInfo->seeSound[^;\n]+")
        set(arguments "CObject *pObj, int sound, int")
        set(storage "struct { int seeSound; } robot{sound}; auto *pRobotInfo = &robot;")
    elseif(kind STREQUAL "BossFinal")
        set(path "ai/aiboss.cpp")
        set(pattern "audio.CreateObjectSound \\(SOUND_BADASS_EXPLOSION_ACTOR[^;\n]+")
        set(arguments "CObject *pObj, int, int")
        set(storage "")
    elseif(kind STREQUAL "RobotGroan")
        set(path "ai/aianimate.cpp")
        set(pattern "audio.CreateObjectSound \\(deathSound[^;\n]+")
        set(arguments "CObject *pObj, int deathSound, int xSoundScale")
        set(storage "")
    else()
        set(path "ai/aianimate.cpp")
        set(pattern "audio.CreateObjectSound \\(SOUND_STANDARD_EXPLOSION[^;\n]+")
        set(arguments "CObject *pObj, int, int")
        set(storage "")
    endif()
    file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/${path}" source)
    string(REGEX MATCHALL "${pattern}" calls "${source}")
    list(LENGTH calls count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Missing or ambiguous ${kind} audio call")
    endif()
    string(APPEND extracted "\nvoid ${kind}(${arguments}) { ${storage} ${calls}; }\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_actor_audio.h"
     CONTENT "${extracted}")
