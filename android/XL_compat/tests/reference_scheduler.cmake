file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/main/trigger.cpp" trigger_hash)
if(NOT trigger_hash STREQUAL "74f1284260fb4a4bb7396bc45eeb83868a7f2dfa5e3fdf0bcb767b94f1b12852")
    message(FATAL_ERROR "Scheduler reference differs from pinned revision")
endif()
foreach(pair IN
        ITEMS "include/timer.h|57b2e6853def5ae0ea062056c64b88f608933402babc16b8c31498f7bd18a06b"
              "include/maths.h|43adf417dd1c282a39c8fed02bdad9d05a7f3ad5850a39a87897fd533eb857cd")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 path)
    list(GET parts 1 expected)
    file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Scheduler timing/random reference header changed: ${path}")
    endif()
endforeach()
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/main/trigger.cpp" trigger_source)
string(FIND "${trigger_source}" "if (m_info.tOperated < 0) {" arm_start)
if(arm_start LESS 0)
    message(FATAL_ERROR "Missing reference scheduling arm block")
endif()
string(SUBSTRING "${trigger_source}" ${arm_start} -1 arm_tail)
string(FIND "${arm_tail}" "\nif (Delay () > 0) {" arm_end)
if(arm_end LESS 0)
    message(FATAL_ERROR "Missing reference scheduling boundary")
endif()
string(SUBSTRING "${arm_tail}" 0 ${arm_end} arm)
set(extracted "void CTrigger::Arm(int nObject, int nPlayer, int bShot) {\n${arm}\n}\n")
foreach(signature IN ITEMS "bool CTrigger::IsDelayed (" "int32_t CTrigger::Delay ("
                           "void CTrigger::Countdown (")
    extract_face_function("${XL_REFERENCE_GEOMETRY_ROOT}/main/trigger.cpp" "${signature}")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_scheduler.h" CONTENT "${extracted}")
add_executable(xl_scheduler_reference tests/reference_scheduler.cpp)
target_include_directories(xl_scheduler_reference PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_features(xl_scheduler_reference PRIVATE cxx_std_17)
