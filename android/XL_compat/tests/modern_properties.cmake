file(SHA256 "${HOG}" original_hash)
if(NOT original_hash STREQUAL "4016618d24238803135dabf2b33daee2a2c34a670c3f016d94ae4639c8887303")
    message(FATAL_ERROR "Modern property controls require the original Neptune geometry")
endif()
file(MAKE_DIRECTORY "${OUTPUT}/missions" "${OUTPUT}/preview-user")
configure_file("${HOG}" "${OUTPUT}/missions/neptunxl.hog" COPYONLY)
configure_file("${DESCRIPTOR}" "${OUTPUT}/missions/neptunxl.mn2" COPYONLY)
if(NOT MODE)
    set(MODE derived)
endif()
execute_process(
    COMMAND "${ENGINE}" -modern-properties-test ${MODE} -hogdir "${DATA}" -extra-dir "${OUTPUT}"
            -userdir "${OUTPUT}/preview-user" -nosound -nomusic
    RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout
    ERROR_VARIABLE stderr
    TIMEOUT 75)
file(WRITE "${OUTPUT}/controls.log" "${stdout}${stderr}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Modern property controls failed (${result}): ${stdout}${stderr}")
endif()
string(FIND "${stdout}" "Modern no-damage derived controls passed" witness)
if(witness LESS 0)
    message(FATAL_ERROR "Modern property controls did not finish")
endif()
if(MODE STREQUAL "water")
    string(FIND "${stdout}" "Modern water derived controls passed" water_witness)
    if(water_witness LESS 0)
        message(FATAL_ERROR "Modern water controls did not finish")
    endif()
endif()
file(SHA256 "${HOG}" final_hash)
if(NOT final_hash STREQUAL original_hash)
    message(FATAL_ERROR "Original Neptune changed during derived property controls")
endif()
