# Compile the original XL arithmetic, rather than a second rewritten oracle
file(SHA256 "${XL_REFERENCE_RENDERLIB}" reference_hash)
if(NOT reference_hash STREQUAL "d3eacfaf28c9687e7e37c3e47333b11d4a026000839231e8a71b443bc86d4252")
    message(FATAL_ERROR "XL reference renderlib differs from the audited source")
endif()
file(READ "${XL_REFERENCE_RENDERLIB}" reference_text)
set(extracted "// Generated from pinned XL renderlib.cpp; do not edit\n")
foreach(signature "static inline void ScaleColor (" "int32_t SetVertexColor ("
                  "fix SetVertexLight (" "void AdjustVertexColor (")
    string(FIND "${reference_text}" "${signature}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing reference function: ${signature}")
    endif()
    string(SUBSTRING "${reference_text}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing reference function delimiter")
    endif()
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${end} function_text)
    string(APPEND extracted "${function_text}\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_lighting.h" CONTENT "${extracted}")
add_executable(xl_lighting_reference_test "${CMAKE_CURRENT_LIST_DIR}/reference_lighting_test.cpp")
target_include_directories(xl_lighting_reference_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(xl_lighting_reference_test PRIVATE xl_inventory)
add_test(NAME xl_lighting_reference_arithmetic COMMAND xl_lighting_reference_test)
