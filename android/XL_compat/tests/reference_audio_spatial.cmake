file(SHA256 "${XL_REFERENCE_GEOMETRY_ROOT}/maths/fixc.cpp" actual)
if(NOT actual STREQUAL "da4a96862a231c07720bb31ff42eddd39174e1708e6ae1678ded61375c5b1c2c")
    message(FATAL_ERROR "Audio trigonometry source changed")
endif()
file(READ "${XL_REFERENCE_GEOMETRY_ROOT}/include/maths.h" maths)
set(extracted "// Actual pinned spatial volume and default-format trigonometry\n")
foreach(name IN ITEMS PI X2F)
    string(REGEX MATCH "#[ \t]*define[ \t]+${name}[^\n]+" definition "${maths}")
    if(NOT definition)
        message(FATAL_ERROR "Missing source spatial constant ${name}")
    endif()
    string(APPEND extracted "${definition}\n")
endforeach()
extract_face_function("${XL_REFERENCE_GEOMETRY_ROOT}/maths/fixc.cpp" "void FixSinCos (")
extract_face_function("${XL_REFERENCE_GEOMETRY_ROOT}/audio/objectaudio.cpp"
                      "void CAudio::GetVolPan (")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_audio_spatial.h"
     CONTENT "${extracted}")
target_sources(xl_named_audio_source PRIVATE tests/reference_audio_spatial.cpp)
