file(SHA256 "${XL_REFERENCE_WEAPON_CONTROL}" reference_hash)
if(NOT reference_hash STREQUAL "1caa0d8a33f755260693a6083ac973593bf0533f2063815de72e66504d75d4b6")
    message(FATAL_ERROR "XL weapon control differs from pinned no-damage audit")
endif()
file(READ "${XL_REFERENCE_WEAPON_CONTROL}" reference_text)
set(extracted "// Actual pinned XL gate functions, with fixture-owned state\n")
foreach(signature "int32_t AllowedToFireGun (" "int32_t AllowedToFireMissile (")
    string(FIND "${reference_text}" "${signature}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing reference function: ${signature}")
    endif()
    string(SUBSTRING "${reference_text}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing reference gate delimiter")
    endif()
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${end} function_text)
    string(APPEND extracted "${function_text}\n")
endforeach()
get_filename_component(reference_weapon_dir "${XL_REFERENCE_WEAPON_CONTROL}" DIRECTORY)
get_filename_component(reference_root "${reference_weapon_dir}" DIRECTORY)
set(reference_collision "${reference_root}/physics/collide.cpp")
file(SHA256 "${reference_collision}" collision_hash)
if(NOT collision_hash STREQUAL "d10f88f82e5d283077914881d1acb719f06785a86be22e50617d92d6fce47bc9")
    message(FATAL_ERROR "XL collision source differs from pinned no-damage audit")
endif()
file(READ "${reference_collision}" reference_text)
foreach(signature "int32_t CObject::CollidePlayerAndPlayer ("
                  "int32_t CObject::CollideActorAndClutter (" "void SetDebrisCollisions (")
    string(FIND "${reference_text}" "${signature}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing reference function: ${signature}")
    endif()
    string(SUBSTRING "${reference_text}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing reference collision delimiter")
    endif()
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${end} function_text)
    string(APPEND extracted "${function_text}\n")
endforeach()
set(reference_geometry "${reference_root}/gameio/loadgeometry.cpp")
file(SHA256 "${reference_geometry}" geometry_hash)
if(NOT geometry_hash STREQUAL "dd9335a95f69cb91a244ba6352ea381d4531fcddb1a12cf06c619d9ab6cf857f")
    message(FATAL_ERROR "XL geometry reader differs from pinned ambient audit")
endif()
file(READ "${reference_geometry}" geometry_text)
string(FIND "${geometry_text}" "void ReadColor (" color_start)
string(SUBSTRING "${geometry_text}" ${color_start} -1 color_tail)
string(FIND "${color_tail}" "\n}\n" color_end)
math(EXPR color_end "${color_end} + 3")
string(SUBSTRING "${color_tail}" 0 ${color_end} color_function)
string(APPEND extracted "${color_function}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_no_damage_gates.h"
     CONTENT "${extracted}")
add_executable(xl_no_damage_reference_gates
               "${CMAKE_CURRENT_LIST_DIR}/reference_no_damage_gates.cpp")
target_compile_features(xl_no_damage_reference_gates PRIVATE cxx_std_17)
target_include_directories(xl_no_damage_reference_gates PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")

target_link_libraries(xl_no_damage_reference_gates PRIVATE xl_inventory)
