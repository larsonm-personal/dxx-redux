file(SHA256 "${XL_REFERENCE_LIGHT}" reference_hash)
if(NOT reference_hash STREQUAL "ca95b9183729c7f3665ef0706206afce093b53b0d97aa6ba11379dd5fdf5f36f")
    message(FATAL_ERROR "XL dynamic light source differs from audited revision")
endif()
file(READ "${XL_REFERENCE_LIGHT}" reference_text)
set(extracted "// Generated from pinned lighting/light.cpp\n")
foreach(signature "void InitDynColoring (" "void SetDynColor (")
    string(FIND "${reference_text}" "${signature}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing reference function: ${signature}")
    endif()
    string(SUBSTRING "${reference_text}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing reference function delimiter")
    endif()
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${end} function_text)
    string(APPEND extracted "${function_text}\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/xl_reference_dynamic.h" CONTENT "${extracted}")
add_executable(xl_dynamic_reference_test "${CMAKE_CURRENT_LIST_DIR}/reference_dynamic_test.cpp")
target_include_directories(xl_dynamic_reference_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(xl_dynamic_reference_test PRIVATE xl_inventory)
add_test(NAME xl_dynamic_color_reference COMMAND xl_dynamic_reference_test)
