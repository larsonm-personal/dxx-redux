# .editorconfig -- shared editor settings.
# ktlint reads this natively for Kotlin style rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h}]
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{gradle,gradle.kts}]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 4

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.{xml,json,json5}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
