{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.exclusions": [
        "**/temp/**"
    ],
    "java.import.gradle.wrapper.enabled": true,
    "java.import.gradle.java.home": "c:\\local\\jdk-21",
    "C_Cpp.default.configurationProvider": "ms-vscode.cpptools",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17",
    "files.associations": {
        "*.c": "c",
        "*.h": "c"
    },
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "c:\\local\\jdk-21", // absolute path won't be right for most
            "default": true
        }
    ],

    "[plaintext]": {
        "editor.colorDecorators": false
    },


    // --- Exclusions for performance (286K -> ~20K indexed files) ---
    // files.exclude hides from explorer AND all indexing (C/C++, Java, search)
    "files.exclude": {
        "android/app/.cxx/": true,
        "android/app/build/": true,
        "android/.gradle/": true,
        "android/.kotlin/": true,
        "android/build/": true,
        "server/target/": true,
        "android/tools/etc2tool/build/": true,
        "build/": true,
        "buildd2/": true,
        "d2/build/": true,
    },
    // Keep game-data metadata searchable while skipping large binary payloads
    "search.exclude": {
        "game_data/**/*.{386,7z,bin,bmp,cab,dem,dll,drv,dxa,exe,flac,gog,ham,hog,hqx,img,ins,iso,jpeg,jpg,mid,mp3,mve,mvl,ogg,pcx,pig,pkg,png,rdl,res,s11,s22,sfa,sit,sow,sub,vxd,wav,zip}": true,
        "game_data/game_logs_net_desync_2/**/*.txt": true,
        "game_data/logs_net_failure/**/*.txt": true,
        "game_data_to_copy_to_emulator/**/*.{386,7z,bin,bmp,cab,dem,dll,drv,dxa,exe,flac,gog,ham,hog,hqx,img,ins,iso,jpeg,jpg,mid,mp3,mve,mvl,ogg,pcx,pig,pkg,png,rdl,res,s11,s22,sfa,sit,sow,sub,vxd,wav,zip}": true,
        "temp/": true
    }
}
