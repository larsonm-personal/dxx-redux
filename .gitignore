# Keep android/app source and test files visible; only ignore a root scratch app dir.
/app/

# generated at build time (dev defaults or release values from build-aab scripts)
android/app/src/main/java/com/dxxredux/app/BuildInfo.kt

# downloaded soundfont (fetched at build time)
android/app/src/main/assets/gm.sf2

# original game data for testing (large binaries ignored, but track regression specs)
game_data/**
!game_data/**/
!game_data/**/*_regression.json5
!game_data/**/track_fingerprints.json
!game_data/extract_dos_demos.ps1
!game_data/extract_mac_demos.ps1
!game_data/demo installers/README.md
!game_data/mods/README.md
!game_data/mods/.gitignore
!game_data/mods/d2x-xl/.gitignore
!game_data/mods/d2x-xl/*.md
!game_data/mods/d2x-xl/*.ps1
!game_data/mods/xfing/.gitignore
!game_data/mods/xfing/*.md
!game_data/mods/xfing/*.ps1
!game_data/mods/xfing/d2x_sp/.gitignore
!game_data/mods/xfing/d2x_sp/*.md
!game_data/mods/xfing/d2x_sp/*.ps1

# android emulator testing
game_data_to_copy_to_emulator/data/*
!game_data_to_copy_to_emulator/data/.gitkeep
game_data_to_copy_to_emulator/download/*
!game_data_to_copy_to_emulator/download/.gitkeep
